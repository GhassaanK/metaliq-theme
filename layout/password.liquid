<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction | default: 'ltr' }}">
  <head>
    {% render 'meta-tags' %}
    {% render 'fonts' %}
    <link rel="icon" type="image/png" href="{{ 'metaliq-mark-orange-256.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'metaliq-mark-orange-256.png' | asset_url }}">
    <meta name="theme-color" content="{{ settings.dark_color }}">
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'css-variables' %}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    {{ content_for_layout }}
  </body>
</html>
