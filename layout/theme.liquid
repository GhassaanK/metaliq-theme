{%- liquid
  assign whatsapp_number = settings.whatsapp_number | default: '+923172920243' | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign custom_design_message = settings.whatsapp_custom_message
  if custom_design_message == blank
    assign custom_design_message = 'general.whatsapp_custom_message' | t
  endif
  assign custom_design_message = custom_design_message | url_encode
  assign custom_design_redirect = 'https://wa.me/' | append: whatsapp_number | append: '?text=' | append: custom_design_message
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction | default: 'ltr' }}">
  <head>
    {%- if request.page_type == 'page' -%}
      {%- if page.handle == 'custom-design' -%}
        <meta http-equiv="refresh" content="0;url={{ custom_design_redirect }}">
        <script>window.location.replace({{ custom_design_redirect | json }});</script>
      {%- endif -%}
    {%- endif -%}
    {% render 'meta-tags' %}
    {% render 'fonts' %}
    <link rel="icon" type="image/png" href="{{ 'metaliq-mark-orange-256.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'metaliq-mark-orange-256.png' | asset_url }}">
    <meta name="theme-color" content="{{ settings.background_color }}">
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'css-variables' %}
    {{ content_for_header }}
  </head>
  <body class="template-{{ request.page_type | handle }}" data-custom-design-url="{{ custom_design_redirect }}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <script>
      window.MetaliQ = {
        routes: {
          cart: '{{ routes.cart_url }}',
          cartAdd: '{{ routes.cart_add_url }}',
          cartChange: '{{ routes.cart_change_url }}',
          cartUpdate: '{{ routes.cart_update_url }}'
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
