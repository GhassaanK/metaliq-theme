{% doc %}
  Renders an editorial product card.

  @param {product} product - The product to display
  @param {string} [sizes] - Optional sizes attribute for the card image

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{% liquid
  assign card_sizes = sizes | default: '(min-width: 990px) 25vw, 50vw'
  assign card_type = product.type | default: 'product.default_type' | t
%}

<article class="product-card">
  <a class="product-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      {{
        product.featured_image
        | image_url: width: 1100
        | image_tag:
          loading: 'lazy',
          widths: '300, 420, 700, 900, 1100',
          sizes: card_sizes,
          alt: product.featured_image.alt | default: product.title
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}

    {%- if product.compare_at_price > product.price -%}
      <span class="product-card__badge">{{ 'product.on_sale' | t }}</span>
    {%- endif -%}
  </a>

  <div class="product-card__body">
    <div>
      <p>{{ card_type }}</p>
      <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    </div>
    <span class="price">{{ product.price | money }}</span>
  </div>
</article>
