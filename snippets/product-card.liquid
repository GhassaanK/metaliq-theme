{% doc %}
  Renders a product card for grids.

  @param {product} product - The product to display
  @param {string} [sizes] - Optional sizes attribute for the card image
  @param {string} [loading] - 'eager' for above-the-fold rows, otherwise 'lazy'
  @param {number} [heading_level] - Heading level for the product title

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{% liquid
  assign card_sizes = sizes | default: '(min-width: 1100px) 22vw, (min-width: 620px) 33vw, 50vw'
  assign card_loading = loading | default: 'lazy'
  assign card_heading_level = heading_level | default: 3
  assign card_heading_tag = 'h' | append: card_heading_level
  assign card_kicker = product.type | default: product.vendor
  assign secondary_image = product.images[1]
  assign card_variant = blank
  for variant in product.variants
    assign variant_title_normalized = variant.title | downcase
    if variant_title_normalized contains 'medium'
      assign card_variant = variant
      break
    endif
  endfor
  assign card_variant = card_variant | default: product.selected_or_first_available_variant
  assign card_url = product.url | append: '?variant=' | append: card_variant.id
  assign on_sale = false
  if card_variant.compare_at_price > card_variant.price
    assign on_sale = true
  endif
%}

<article class="product-card{% if secondary_image %} product-card--has-secondary{% endif %}">
  <a
    class="product-card__media media"
    href="{{ card_url }}"
    aria-label="{{ 'product.view' | t: title: product.title }}"
  >
    {%- if product.featured_image -%}
      {{
        product.featured_image
        | image_url: width: 1200
        | image_tag:
          loading: card_loading,
          widths: '300, 420, 600, 800, 1000, 1200',
          sizes: card_sizes,
          class: 'product-card__image product-card__image--primary',
          alt: product.featured_image.alt | default: product.title
      }}
      {%- if secondary_image -%}
        {{
          secondary_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '300, 420, 600, 800, 1000, 1200',
            sizes: card_sizes,
            class: 'product-card__image product-card__image--secondary',
            alt: secondary_image.alt | default: product.title
        }}
      {%- endif -%}
    {%- else -%}
      <span class="media-fallback">{% render 'engraving', seed: product.id %}</span>
    {%- endif -%}

    {%- if on_sale -%}
      <span class="product-card__badge tag">{{ 'product.on_sale' | t }}</span>
    {%- endif -%}
  </a>

  <div class="product-card__body">
    {%- if card_kicker != blank -%}
      <p class="product-card__kicker">{{ card_kicker }}</p>
    {%- endif -%}
    <{{ card_heading_tag }} class="product-card__title"><a href="{{ card_url }}">{{ product.title }}</a></{{ card_heading_tag }}>
    <p class="product-card__variant">{{ card_variant.title | escape }}</p>

    <div class="product-card__price price {% if on_sale %}price--sale{% endif %}">
      {%- if on_sale -%}<s>{{ card_variant.compare_at_price | money }}</s>{%- endif -%}
      <strong>{{ card_variant.price | money }}</strong>
    </div>
  </div>
</article>
