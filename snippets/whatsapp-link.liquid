{% doc %}
  Renders a contextual WhatsApp call to action for MetaliQ Art.

  @param {string} label - Visible link label.
  @param {string} message - Prefilled WhatsApp message.
  @param {string} [css_class] - Optional additional CSS class.
  @param {string} [eyebrow] - Optional short label displayed above the main label.
{% enddoc %}

{%- liquid
  assign whatsapp_number = settings.whatsapp_number | default: '+923172920243'
  assign whatsapp_number = whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign whatsapp_message = message | url_encode
-%}

<a
  class="whatsapp-link{% if css_class != blank %} {{ css_class }}{% endif %}"
  href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message }}"
  data-whatsapp-cta
  target="_blank"
  rel="noopener"
>
  <span class="whatsapp-link__icon" aria-hidden="true">{% render 'icon', name: 'whatsapp' %}</span>
  {%- if eyebrow != blank -%}
    <span class="whatsapp-link__copy">
      <small>{{ eyebrow | escape }}</small>
      <strong>{{ label | escape }}</strong>
    </span>
  {%- else -%}
    <span>{{ label | escape }}</span>
  {%- endif -%}
  <span class="whatsapp-link__arrow" aria-hidden="true">&nearr;</span>
</a>
