{% doc %}
  Renders the field set shared by the new-address and edit-address forms.

  @param {object} [address] - An existing address to prefill, omitted when adding

  @example
  {% render 'address-fields', address: address %}
{% enddoc %}

<div class="field-grid">
  <label class="field">
    {{ 'customer.addresses.first_name' | t }}
    <input type="text" name="address[first_name]" value="{{ address.first_name }}" autocomplete="given-name">
  </label>
  <label class="field">
    {{ 'customer.addresses.last_name' | t }}
    <input type="text" name="address[last_name]" value="{{ address.last_name }}" autocomplete="family-name">
  </label>
</div>

<label class="field">
  {{ 'customer.addresses.company' | t }}
  <input type="text" name="address[company]" value="{{ address.company }}" autocomplete="organization">
</label>

<label class="field">
  {{ 'customer.addresses.address1' | t }}
  <input type="text" name="address[address1]" value="{{ address.address1 }}" autocomplete="address-line1">
</label>

<label class="field">
  {{ 'customer.addresses.address2' | t }}
  <input type="text" name="address[address2]" value="{{ address.address2 }}" autocomplete="address-line2">
</label>

<div class="field-grid">
  <label class="field">
    {{ 'customer.addresses.city' | t }}
    <input type="text" name="address[city]" value="{{ address.city }}" autocomplete="address-level2">
  </label>
  <label class="field">
    {{ 'customer.addresses.zip' | t }}
    <input type="text" name="address[zip]" value="{{ address.zip }}" autocomplete="postal-code">
  </label>
</div>

<div class="field-grid">
  <label class="field">
    {{ 'customer.addresses.country' | t }}
    <select name="address[country]">{{ all_country_option_tags }}</select>
  </label>
  <label class="field">
    {{ 'customer.addresses.phone' | t }}
    <input type="tel" name="address[phone]" value="{{ address.phone }}" autocomplete="tel">
  </label>
</div>

<label class="checkbox">
  <input type="checkbox" name="address[default]" value="1">
  {{ 'customer.addresses.set_default' | t }}
</label>
