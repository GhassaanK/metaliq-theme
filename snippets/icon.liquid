{% doc %}
  Renders one line icon by name, 24x24, drawn in the current text colour.
  Used by the home feature strips and the footer social row.

  @param {string} name - One of: precision, cut, layers, shield, package, gift,
    truck, sparkle, star, arrow-right, instagram, tiktok, pinterest, youtube,
    facebook, mail, play, whatsapp, close

  @example
  {% render 'icon', name: 'shield' %}
{% enddoc %}

{%- liquid
  assign n = name | default: 'sparkle'
-%}

<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case n -%}
    {%- when 'precision' -%}
      <circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /><path d="M12 1v3M12 20v3M1 12h3M20 12h3" />
    {%- when 'cut' -%}
      <circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M8.5 8.5 20 20M8.5 15.5 20 4" />
    {%- when 'layers' -%}
      <path d="m12 3 9 5-9 5-9-5 9-5Z" /><path d="m3 13 9 5 9-5" />
    {%- when 'shield' -%}
      <path d="M12 3 5 6v5c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3Z" /><path d="m9 12 2 2 4-4" />
    {%- when 'package' -%}
      <path d="M3 8 12 3l9 5v8l-9 5-9-5V8Z" /><path d="M3 8l9 5 9-5M12 13v8" />
    {%- when 'gift' -%}
      <rect x="3" y="8" width="18" height="4" rx="1" /><path d="M5 12v9h14v-9M12 8v13" /><path d="M12 8S9 3 6.5 5 8 8 12 8ZM12 8s3-5 5.5-3S16 8 12 8Z" />
    {%- when 'truck' -%}
      <path d="M2 6h11v10H2zM13 9h5l3 3v4h-8" /><circle cx="7" cy="18" r="2" /><circle cx="17" cy="18" r="2" />
    {%- when 'whatsapp' -%}
      <path fill="currentColor" stroke="none" d="M12.04 2a9.84 9.84 0 0 0-8.43 14.91L2.05 22l5.2-1.53A9.9 9.9 0 1 0 12.04 2Zm0 17.98a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.08.91.92-3-.2-.31a8.1 8.1 0 1 1 6.79 3.71Zm4.44-6.06c-.24-.12-1.44-.71-1.66-.79-.22-.08-.38-.12-.54.12-.16.24-.62.79-.76.95-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.96-1.21-.72-.64-1.21-1.44-1.35-1.68-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.41-.54-.42h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.51.1.46-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28Z" />
    {%- when 'close' -%}
      <path d="m6 6 12 12M18 6 6 18" />
    {%- when 'star' -%}
      <path d="m12 3 2.6 5.4 5.9.8-4.3 4.1 1 5.9L12 16.5 6.8 19.2l1-5.9-4.3-4.1 5.9-.8L12 3Z" fill="currentColor" stroke="none" />
    {%- when 'arrow-right' -%}
      <path d="M4 12h16M14 6l6 6-6 6" />
    {%- when 'play' -%}
      <path d="m9 6 9 6-9 6V6Z" fill="currentColor" stroke="none" />
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
    {%- when 'tiktok' -%}
      <path d="M15 3c.5 3 2.5 4.5 5 4.7v3.2c-1.8 0-3.6-.6-5-1.7v6.6a6 6 0 1 1-6-6c.3 0 .7 0 1 .1v3.3a2.7 2.7 0 1 0 1.9 2.6V3H15Z" fill="currentColor" stroke="none" />
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="9" /><path d="M12 7c-2.5 0-4 1.7-4 3.7 0 1 .5 2 1.4 2.4.2 0 .3 0 .3-.2l.2-.7c0-.2 0-.3-.1-.4a2 2 0 0 1-.5-1.4c0-1.5 1.1-2.8 3-2.8 1.6 0 2.5 1 2.5 2.3 0 1.8-.8 3.3-2 3.3-.6 0-1.1-.5-1-1.2l.5-2c.1-.5-.1-.9-.6-.9-.6 0-1 .6-1 1.4l.3 1.2-.9 3.7c-.2.8-.1 1.9 0 2.7" />
    {%- when 'youtube' -%}
      <rect x="3" y="6" width="18" height="12" rx="3" /><path d="m10 9 5 3-5 3V9Z" fill="currentColor" stroke="none" />
    {%- when 'facebook' -%}
      <path d="M14 8h2V5h-2c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2l.5-3H14V8Z" />
    {%- else -%}
      <path d="m12 3 2 6 6 .5-4.5 4 1.5 6L12 16l-5.5 3.5 1.5-6L3.5 9.5 10 9l2-6Z" />
  {%- endcase -%}
</svg>
