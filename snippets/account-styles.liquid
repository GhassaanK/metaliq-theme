{% doc %}
  Styles shared by every customer account screen. Kept in a snippet so each
  account section can render it — stylesheet tags may be included many times but
  their CSS is emitted once, which keeps login, register, activate, reset,
  addresses and order consistent without any one depending on another.

  @example
  {% render 'account-styles' %}
{% enddoc %}

{% stylesheet %}
  .account-page,
  .auth-page {
    padding-block: var(--sp-7) var(--section);
  }

  .account-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-7);
  }
  .account-header h1 {
    font-size: var(--fs-h1);
  }

  .account-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(240px, 0.55fr);
    align-items: start;
    gap: clamp(28px, 5vw, 64px);
  }
  .account-layout h2 {
    margin-bottom: var(--sp-4);
    font-size: var(--fs-h3);
  }

  .table-scroll {
    overflow-x: auto;
  }
  .account-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    text-align: left;
  }
  .account-table th,
  .account-table td {
    padding: var(--sp-3) var(--sp-4) var(--sp-3) 0;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  .account-table th {
    color: var(--muted);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .account-empty {
    color: var(--muted);
  }

  .account-aside {
    padding: var(--sp-5);
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .account-aside .link {
    display: inline-block;
    margin-top: var(--sp-4);
  }

  /* Auth cards — login, register, activate, reset */
  .auth-page {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--sp-5);
    max-width: 920px;
    margin-inline: auto;
  }
  .auth-page--single {
    max-width: 460px;
    grid-template-columns: 1fr;
  }
  .auth-card {
    padding: clamp(24px, 4vw, 36px);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .auth-card h1 {
    margin-bottom: var(--sp-5);
    font-size: var(--fs-h2);
  }
  .auth-card h2 {
    font-size: var(--fs-h3);
  }
  .auth-card form {
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-4);
  }
  .auth-card .link {
    justify-self: start;
    font-size: var(--fs-sm);
  }
  .auth-alt {
    margin-top: var(--sp-5);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
  }

  /* Addresses */
  .address-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--sp-4);
  }
  .address-card {
    padding: var(--sp-5);
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .address-card h2 {
    margin-bottom: var(--sp-2);
    font-size: var(--fs-h4);
  }
  .address-card__actions {
    display: flex;
    gap: var(--sp-4);
    margin-top: var(--sp-4);
    font-size: var(--fs-sm);
  }
  .address-card__actions button {
    padding: 0;
  }
  .address-edit {
    margin-top: var(--sp-3);
  }
  .address-edit summary {
    cursor: pointer;
    font-size: var(--fs-sm);
  }
  .address-edit .address-form {
    margin-top: var(--sp-4);
    padding: 0;
    background: none;
    border: 0;
  }
  .address-form {
    display: grid;
    gap: var(--sp-4);
    max-width: 620px;
    margin-top: var(--sp-5);
    padding: clamp(20px, 4vw, 32px);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .address-form .checkbox {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    font-weight: 400;
  }
  .address-form .checkbox input {
    width: auto;
  }
  .address-form-title {
    margin: var(--sp-8) 0 0;
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line);
    font-size: var(--fs-h3);
  }

  /* Order detail */
  .order-property {
    display: block;
    color: var(--muted);
    font-size: 0.7rem;
    white-space: normal;
  }
  .order-addresses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--sp-4);
    margin-top: var(--sp-7);
  }
  .order-addresses h2 {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-h4);
  }

  @media (max-width: 860px) {
    .account-layout,
    .auth-page {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}
