<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign social_image_url = blank
  assign og_description = page_description | default: shop.description | default: 'MetaliQ Art - precision-cut metal decor made in Pakistan.'

  if page_image
    assign social_image_url = page_image | image_url
    unless social_image_url contains '://'
      assign social_image_prefix = social_image_url | slice: 0, 2
      if social_image_prefix == '//'
        assign social_image_url = social_image_url | prepend: 'https:'
      else
        assign social_image_url = social_image_url | prepend: shop.url
      endif
    endunless
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
    assign social_product_variant = product.selected_variant
    if social_product_variant == blank
      for variant in product.variants
        assign social_variant_title = variant.title | downcase
        if social_variant_title contains 'medium'
          assign social_product_variant = variant
          break
        endif
      endfor
    endif
    assign social_product_variant = social_product_variant | default: product.selected_or_first_available_variant
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url | escape }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if social_image_url != blank -%}
  <meta
    property="og:image"
    content="{{ social_image_url | escape }}"
  >
  <meta
    property="og:image:secure_url"
    content="{{ social_image_url | escape }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ social_product_variant.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
{%- if social_image_url != blank -%}
  <meta name="twitter:image" content="{{ social_image_url | escape }}">
{%- endif -%}

<title>
  {{ page_title | escape }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' | escape }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name | escape }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url | escape }}"
>

<meta
  name="description"
  content="{{ og_description | escape }}"
>

{% render 'structured-data' %}
