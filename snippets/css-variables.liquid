{% doc %}
  Emits the theme's design tokens as CSS custom properties from theme settings,
  so colour, type, container width and radius are editable in the theme editor
  without a redeploy. Rendered inside <head> on every layout.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{% style %}
  :root {
    --background: {{ settings.background_color }};
    --surface: {{ settings.surface_color }};
    --surface-2: {{ settings.surface_color | color_lighten: 4 }};
    --ink: {{ settings.foreground_color }};
    --muted: {{ settings.muted_color }};
    --line: {{ settings.line_color }};
    --hairline: {{ settings.foreground_color | color_modify: 'alpha', 0.1 }};

    --copper: {{ settings.accent_color }};
    --copper-dark: {{ settings.accent_color | color_darken: 6 }};
    --copper-light: {{ settings.accent_color | color_lighten: 12 }};
    --on-accent: #151513;
    --danger: #ba1a1a;
    --notification: #e53935;
    --whatsapp: #25d366;
    --whatsapp-hover: #35e977;
    --light-surface: #ffffff;
    --light-ink: #11110f;
    --light-line: #deddd9;
    --light-muted: #696762;
    --light-hover: #f1f0ed;

    --nav: {{ settings.dark_color }};
    --nav-deep: {{ settings.dark_color | color_darken: 8 }};
    --on-nav: #ffffff;
    --on-nav-muted: {{ settings.dark_color | color_lighten: 42 }};

    --footer: {{ settings.footer_color }};
    --on-footer: {{ settings.foreground_color }};

    --container: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --radius: {{ settings.input_corner_radius }}px;
    --radius-lg: {{ settings.input_corner_radius | plus: 4 }}px;

    --serif: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }}, Georgia, serif;
    --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    --heading-weight: {{ settings.heading_font.weight | default: 600 }};
  }

  @media (max-width: 620px) {
    :root {
      --page-margin: min({{ settings.min_page_margin }}px, 20px);
    }
  }
{% endstyle %}
