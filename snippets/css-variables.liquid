{% doc %}
  Emits the theme's design tokens as CSS custom properties from theme settings,
  so colour, container width and radius are editable in the theme editor without
  a redeploy. Rendered inside <head> on every layout.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{% style %}
  :root {
    --background: {{ settings.background_color }};
    --surface: {{ settings.surface_color }};
    --ink: {{ settings.foreground_color }};
    --muted: {{ settings.muted_color }};
    --line: {{ settings.line_color }};

    --copper: {{ settings.accent_color }};
    --copper-dark: {{ settings.accent_color | color_darken: 9 }};
    --copper-light: {{ settings.accent_color | color_lighten: 16 }};

    --charcoal: {{ settings.dark_color }};
    --charcoal-deep: {{ settings.dark_color | color_darken: 4 }};
    --on-dark: {{ settings.background_color }};
    --on-dark-muted: {{ settings.background_color | color_mix: settings.dark_color, 62 }};

    --container: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --radius: {{ settings.input_corner_radius }}px;

    --serif: 'Fraunces', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
    --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  }
{% endstyle %}
