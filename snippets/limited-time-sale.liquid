{% doc %}
  Renders the homepage limited-time product campaign.

  @param {section} section - The section containing campaign presentation settings

  @example
  {% render 'limited-time-sale', section: section %}
{% enddoc %}

{%- liquid
  assign campaign_collection = settings.limited_sale_collection
  if campaign_collection == blank
    assign campaign_collection = collections['sale']
  endif
  assign use_campaign_collection = false
  if campaign_collection != blank
    if campaign_collection.products_count > 0
      assign use_campaign_collection = true
    endif
  endif
  assign campaign_limit = 50
  assign campaign_count = 0

  if use_campaign_collection
    assign campaign_products = campaign_collection.products
    for campaign_product in campaign_products
      assign count_variant = blank
      for product_variant in campaign_product.variants
        assign variant_title_normalized = product_variant.title | downcase
        if variant_title_normalized contains 'medium'
          assign count_variant = product_variant
          break
        endif
      endfor
      assign count_variant = count_variant | default: campaign_product.selected_or_first_available_variant
      if count_variant.compare_at_price > count_variant.price
        assign campaign_count = campaign_count | plus: 1
      endif
      if campaign_count == campaign_limit
        break
      endif
    endfor
  else
    assign counted_product_handles = '|'
    for source_collection in collections
      for campaign_product in source_collection.products
        capture product_handle_token
          echo '|'
          echo campaign_product.handle
          echo '|'
        endcapture
        unless counted_product_handles contains product_handle_token
          assign counted_product_handles = counted_product_handles | append: campaign_product.handle | append: '|'
          assign count_variant = blank
          for product_variant in campaign_product.variants
            assign variant_title_normalized = product_variant.title | downcase
            if variant_title_normalized contains 'medium'
              assign count_variant = product_variant
              break
            endif
          endfor
          assign count_variant = count_variant | default: campaign_product.selected_or_first_available_variant
          if count_variant.compare_at_price > count_variant.price
            assign campaign_count = campaign_count | plus: 1
          endif
        endunless
        if campaign_count == campaign_limit
          break
        endif
      endfor
      if campaign_count == campaign_limit
        break
      endif
    endfor
  endif
  assign campaign_eyebrow = section.settings.limited_sale_eyebrow
  assign campaign_heading = section.settings.limited_sale_heading
  assign campaign_intro = section.settings.limited_sale_intro
  assign campaign_fallback_image = section.settings.limited_sale_image
  assign campaign_enabled = section.settings.limited_sale_enabled
  assign campaign_live = false
  assign campaign_has_deadline = false
  assign campaign_expired = false
  assign campaign_end_timestamp = settings.limited_sale_end | date: '%s' | plus: 0
  assign current_timestamp = 'now' | date: '%s' | plus: 0

  if settings.limited_sale_end != blank
    if campaign_end_timestamp > 0
      assign campaign_has_deadline = true
      if campaign_end_timestamp > current_timestamp
        assign campaign_live = true
      else
        assign campaign_expired = true
      endif
    endif
  endif

  if campaign_eyebrow == blank
    assign campaign_eyebrow = 'home.limited_sale_eyebrow' | t
  endif
  if campaign_heading == blank
    assign campaign_heading = 'home.limited_sale_heading' | t
  endif
  if campaign_intro == blank
    assign campaign_intro = 'home.limited_sale_intro' | t
  endif
-%}

{%- if campaign_enabled and campaign_count == 0 and request.design_mode -%}
  <section class="home-limited-sale section">
    <div class="container">
      <p>{{ 'home.limited_sale_select_collection' | t }}</p>
    </div>
  </section>
{%- endif -%}

{%- if campaign_enabled and campaign_count > 0 -%}
  <section
    class="home-limited-sale section{% if campaign_count == 1 %} home-limited-sale--single{% endif %}{% if campaign_count < 4 %} home-limited-sale--few{% endif %}{% if campaign_expired %} is-expired{% endif %}"
    data-limited-sale
    data-sale-end="{{ settings.limited_sale_end | escape }}"
    data-sale-active="{{ campaign_live }}"
  >
    <div class="container">
      <header class="home-limited-sale__header reveal">
        <div class="home-limited-sale__copy">
          <p class="eyebrow">{{ campaign_eyebrow | escape }}</p>
          <h2>{{ campaign_heading | escape }}</h2>
          <p>{{ campaign_intro | escape }}</p>
        </div>

        <div class="home-limited-sale__tools">
          {%- if campaign_has_deadline -%}
            <div class="home-limited-sale__deadline" data-sale-deadline>
              <p{% unless campaign_live %} hidden{% endunless %}>{{ 'home.limited_sale_ends' | t }}</p>
              <div class="home-limited-sale__timer" data-sale-timer role="timer" aria-label="{{ 'home.limited_sale_countdown' | t }}"{% unless campaign_live %} hidden{% endunless %}>
                <span><strong data-sale-days>00</strong><small>{{ 'home.limited_sale_days' | t }}</small></span>
                <span><strong data-sale-hours>00</strong><small>{{ 'home.limited_sale_hours' | t }}</small></span>
                <span><strong data-sale-minutes>00</strong><small>{{ 'home.limited_sale_minutes' | t }}</small></span>
                <span><strong data-sale-seconds>00</strong><small>{{ 'home.limited_sale_seconds' | t }}</small></span>
              </div>
              <p class="home-limited-sale__exact-date"{% unless campaign_live %} hidden{% endunless %}><span>{{ 'home.limited_sale_ends_on' | t }}</span> <time data-sale-end-date></time></p>
              <p class="home-limited-sale__expired" data-sale-expired{% if campaign_live %} hidden{% endif %}>{{ 'home.limited_sale_expired' | t }}</p>
            </div>
          {%- elsif request.design_mode -%}
            <p class="home-limited-sale__editor-note">{{ 'home.limited_sale_set_deadline' | t }}</p>
          {%- endif -%}
          <div class="home-limited-sale__controls" aria-label="{{ 'home.limited_sale_controls' | t }}">
            <span class="home-limited-sale__position"><span data-sale-current>01</span> / <span data-sale-total>{{ campaign_count }}</span></span>
            <button class="icon-button home-limited-sale__arrow home-limited-sale__arrow--previous" type="button" aria-label="{{ 'home.limited_sale_previous' | t }}" data-sale-previous disabled>{% render 'icon', name: 'arrow-right' %}</button>
            <button class="icon-button home-limited-sale__arrow" type="button" aria-label="{{ 'home.limited_sale_next' | t }}" data-sale-next>{% render 'icon', name: 'arrow-right' %}</button>
          </div>
        </div>
      </header>

      <div class="home-limited-sale__grid{% if campaign_count == 1 %} home-limited-sale__grid--single{% endif %}" data-sale-track tabindex="0" aria-label="{{ 'home.limited_sale_products' | t }}">
        {%- if use_campaign_collection -%}
          {%- for campaign_product in campaign_products -%}
            {%- render 'limited-sale-card', product: campaign_product, fallback_image: campaign_fallback_image -%}
          {%- endfor -%}
        {%- else -%}
          {%- liquid
            assign rendered_product_handles = '|'
            assign rendered_campaign_products = 0
          -%}
          {%- for source_collection in collections -%}
            {%- for campaign_product in source_collection.products -%}
              {%- capture product_handle_token -%}|{{ campaign_product.handle }}|{%- endcapture -%}
              {%- unless rendered_product_handles contains product_handle_token -%}
                {%- liquid
                  assign rendered_product_handles = rendered_product_handles | append: campaign_product.handle | append: '|'
                  assign campaign_variant = blank
                  for product_variant in campaign_product.variants
                    assign variant_title_normalized = product_variant.title | downcase
                    if variant_title_normalized contains 'medium'
                      assign campaign_variant = product_variant
                      break
                    endif
                  endfor
                  assign campaign_variant = campaign_variant | default: campaign_product.selected_or_first_available_variant
                -%}
                {%- if campaign_variant.compare_at_price > campaign_variant.price -%}
                  {%- render 'limited-sale-card', product: campaign_product, fallback_image: campaign_fallback_image -%}
                  {%- assign rendered_campaign_products = rendered_campaign_products | plus: 1 -%}
                {%- endif -%}
              {%- endunless -%}
              {%- if rendered_campaign_products == campaign_limit -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if rendered_campaign_products == campaign_limit -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .home-limited-sale {
    position: relative;
    overflow: hidden;
    border-top: 3px solid var(--copper);
    border-bottom: 1px solid color-mix(in srgb, var(--copper) 32%, var(--line));
    background: var(--nav);
    color: var(--on-nav);
  }
  .home-limited-sale__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--stack-xl);
    margin-bottom: var(--stack-xl);
    padding-bottom: var(--stack-lg);
    border-bottom: 1px solid color-mix(in srgb, var(--on-nav) 18%, transparent);
  }
  .home-limited-sale--single .container {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 420px);
    align-items: center;
    gap: clamp(32px, 6vw, 100px);
  }
  .home-limited-sale--single .home-limited-sale__header {
    display: block;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .home-limited-sale__copy {
    min-width: 0;
    max-width: 700px;
  }
  .home-limited-sale__copy .eyebrow {
    margin-bottom: var(--stack-sm);
  }
  .home-limited-sale__copy h1,
  .home-limited-sale__copy h2 {
    margin: 0;
    color: var(--on-nav);
    font-size: 2.25rem;
    line-height: 1.1;
  }
  .home-limited-sale__copy > p:last-of-type {
    max-width: 62ch;
    margin-top: var(--stack-sm);
    color: color-mix(in srgb, var(--on-nav) 72%, transparent);
    overflow-wrap: anywhere;
  }
  .home-limited-sale__tools {
    display: grid;
    justify-items: end;
    gap: var(--stack-md);
  }
  .home-limited-sale__editor-note {
    max-width: 36ch;
    color: var(--on-nav-muted);
    font-size: var(--fs-label-sm);
  }
  .home-limited-sale__controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .home-limited-sale__position {
    min-width: 64px;
    margin-right: 8px;
    color: var(--on-nav-muted);
    font-size: var(--fs-label);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .home-limited-sale__arrow {
    width: 44px;
    height: 44px;
    border: 1px solid color-mix(in srgb, var(--on-nav) 32%, transparent);
    border-radius: 50%;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .home-limited-sale__arrow--previous .icon {
    transform: rotate(180deg);
  }
  .home-limited-sale__arrow:not(:disabled):hover,
  .home-limited-sale__arrow:not(:disabled):focus-visible {
    border-color: var(--copper);
    background: var(--copper);
    color: var(--on-accent);
  }
  .home-limited-sale__arrow:disabled {
    cursor: not-allowed;
    opacity: 0.4;
  }
  .home-limited-sale__deadline {
    min-width: 332px;
  }
  .home-limited-sale__deadline > p:first-child {
    margin-bottom: var(--stack-sm);
    color: var(--copper);
    font-size: var(--fs-label-sm);
    font-weight: 600;
    text-transform: uppercase;
  }
  .home-limited-sale__timer {
    display: grid;
    grid-template-columns: repeat(4, minmax(56px, 1fr));
    gap: 8px;
  }
  .home-limited-sale__deadline > [hidden] {
    display: none;
  }
  .home-limited-sale__timer > span {
    display: grid;
    justify-items: center;
    min-width: 0;
    padding: 10px 8px;
    min-height: 68px;
    border: 1px solid color-mix(in srgb, var(--on-nav) 20%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--on-nav) 5%, transparent);
  }
  .home-limited-sale__timer strong {
    color: var(--on-nav);
    font-family: var(--serif);
    font-size: 1.7rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .home-limited-sale__timer > span:last-child strong {
    color: var(--copper-light);
  }
  .home-limited-sale__timer small {
    margin-top: 5px;
    color: color-mix(in srgb, var(--on-nav) 62%, transparent);
    font-size: 0.7rem;
  }
  .home-limited-sale__expired {
    color: var(--copper);
    font-family: var(--serif);
    font-size: var(--fs-h3);
  }
  .home-limited-sale__exact-date {
    margin-top: 8px;
    color: color-mix(in srgb, var(--on-nav) 68%, transparent);
    font-size: var(--fs-label-sm);
    text-align: right;
  }
  .home-limited-sale__exact-date span {
    color: var(--on-nav);
    font-weight: 600;
  }
  .home-limited-sale__grid {
    display: flex;
    align-items: stretch;
    min-width: 0;
    gap: 18px;
    padding: 2px 2px 10px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-inline: contain;
    overscroll-behavior-block: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    touch-action: pan-x pan-y pinch-zoom;
  }
  .home-limited-sale__grid--single {
    overflow: visible;
  }
  .home-limited-sale--few .home-limited-sale__grid {
    justify-content: center;
    overflow: visible;
  }
  .home-limited-sale--few .home-limited-sale__controls {
    display: none;
  }
  .home-limited-sale__grid::-webkit-scrollbar {
    display: none;
  }
  .limited-bundle-card {
    position: relative;
    display: flex;
    flex: 0 0 clamp(240px, 22vw, 290px);
    flex-direction: column;
    min-width: 0;
    padding: 10px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--on-nav) 17%, transparent);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--ink);
    scroll-snap-align: start;
  }
  .home-limited-sale__grid--single .limited-bundle-card {
    flex-basis: 100%;
  }
  .limited-bundle-card__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 6px;
    background: var(--surface-2);
  }
  .limited-bundle-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s var(--ease);
  }
  .limited-bundle-card:hover .limited-bundle-card__media img {
    transform: scale(1.025);
  }
  .limited-bundle-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 6px 8px;
    border-radius: 5px;
    background: var(--copper);
    color: var(--on-accent);
    font-size: var(--fs-label-sm);
    font-weight: 700;
  }
  .limited-bundle-card__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 14px 4px 4px;
  }
  .limited-bundle-card h3 {
    display: -webkit-box;
    min-height: 2.6em;
    margin: 0 0 12px;
    overflow: hidden;
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .limited-bundle-card h3 a:hover {
    color: var(--copper-dark);
  }
  .limited-bundle-card__form {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    margin: 0;
  }
  .limited-bundle-card__purchase {
    display: grid;
    grid-template-columns: minmax(82px, auto) minmax(104px, 1fr);
    align-items: end;
    gap: 10px;
    margin-top: auto;
    padding-top: 8px;
  }
  .limited-bundle-card__pricing {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .limited-bundle-card__pricing s {
    color: var(--muted);
    font-size: 0.68rem;
  }
  .limited-bundle-card__pricing strong {
    color: var(--copper-dark);
    font-family: var(--sans);
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .limited-bundle-card__add {
    position: absolute;
    z-index: 3;
    top: 20px;
    right: 20px;
    display: flex;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    color: var(--ink);
    font: inherit;
    box-shadow: 0 5px 16px rgb(0 0 0 / 0.16);
    backdrop-filter: blur(6px);
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease), color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .limited-bundle-card__add .icon {
    width: 17px;
    height: 17px;
  }
  .limited-bundle-card__add:not(:disabled):hover,
  .limited-bundle-card__add:not(:disabled):focus-visible {
    border-color: var(--copper);
    background: var(--copper);
    color: var(--on-accent);
    transform: translateY(-2px);
  }
  .limited-bundle-card__buy {
    width: 100%;
    min-width: 0;
    min-height: 40px;
    margin: 0;
    padding: 9px 12px;
    border-radius: 6px;
    font-size: 0.76rem;
  }
  .limited-bundle-card__add:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }
  .home-limited-sale.is-expired .limited-bundle-card form,
  .home-limited-sale.is-expired .limited-bundle-card .button,
  .home-limited-sale.is-expired .limited-bundle-card__badge,
  .home-limited-sale.is-expired .limited-bundle-card__pricing,
  .home-limited-sale.is-expired .home-limited-sale__grid,
  .home-limited-sale.is-expired .home-limited-sale__controls,
  .home-limited-sale.is-expired .home-limited-sale__deadline > p:first-child,
  .home-limited-sale.is-expired .home-limited-sale__exact-date {
    display: none;
  }
  @media (max-width: 899px) {
    .home-limited-sale--single .container {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-limited-sale--single .home-limited-sale__header {
      padding-bottom: var(--stack-lg);
      border-bottom: 1px solid color-mix(in srgb, var(--on-nav) 18%, transparent);
    }
    .home-limited-sale__header {
      grid-template-columns: 1fr;
    }
    .home-limited-sale__tools {
      display: flex;
      align-items: end;
      justify-content: space-between;
      justify-items: normal;
      flex-wrap: wrap;
    }
    .home-limited-sale__deadline {
      min-width: 0;
      max-width: 420px;
    }
    .home-limited-sale__grid {
      overflow-x: auto;
    }
    .limited-bundle-card {
      flex-basis: calc((100% - var(--gutter)) / 2);
      min-height: 0;
    }
  }
  @media (max-width: 619px) {
    .home-limited-sale__copy h2 {
      font-size: 1.8rem;
    }
    .home-limited-sale__tools {
      align-items: start;
    }
    .home-limited-sale__grid {
      margin-right: calc(var(--page-margin) * -1);
      padding-right: var(--page-margin);
    }
    .home-limited-sale--few .home-limited-sale__grid {
      justify-content: flex-start;
      overflow-x: auto;
    }
    .limited-bundle-card {
      flex-basis: min(78vw, 280px);
    }
    .home-limited-sale__grid--single {
      margin-right: 0;
      padding-right: 0;
    }
    .home-limited-sale__grid--single .limited-bundle-card {
      flex-basis: 100%;
    }
    .home-limited-sale__timer {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .home-limited-sale__timer > span {
      padding-inline: 4px;
    }
    .limited-bundle-card__body {
      padding: 12px 2px 2px;
    }
    .limited-bundle-card h3 {
      min-height: 2.5em;
      font-size: 0.94rem;
      line-height: 1.25;
    }
    .limited-bundle-card__purchase {
      grid-template-columns: minmax(74px, auto) minmax(98px, 1fr);
      gap: 8px;
    }
    .limited-bundle-card__pricing strong {
      font-size: 0.96rem;
    }
    .limited-bundle-card__buy {
      padding-inline: 6px;
      font-size: 0.66rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .limited-bundle-card__media img {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const initializeSlider = (campaign) => {
      if (campaign.dataset.sliderInitialized === 'true') return;
      campaign.dataset.sliderInitialized = 'true';

      const track = campaign.querySelector('[data-sale-track]');
      const previous = campaign.querySelector('[data-sale-previous]');
      const next = campaign.querySelector('[data-sale-next]');
      const current = campaign.querySelector('[data-sale-current]');
      const total = campaign.querySelector('[data-sale-total]');
      if (!track || !previous || !next) return;

      const cards = [...track.querySelectorAll('.limited-bundle-card')];
      if (total) total.textContent = String(cards.length).padStart(2, '0');
      const hasMultipleCards = cards.length > 1;
      const shouldLoop = hasMultipleCards && !campaign.classList.contains('home-limited-sale--few');
      previous.disabled = !shouldLoop;
      next.disabled = !shouldLoop;
      if (!cards.length) {
        return;
      }

      const cloneCount = shouldLoop ? Math.min(3, cards.length) : 0;
      const createClone = (card) => {
        const clone = card.cloneNode(true);
        clone.classList.add('limited-bundle-card--clone');
        clone.classList.remove('reveal', 'is-in');
        clone.setAttribute('aria-hidden', 'true');
        clone.inert = true;
        clone.querySelectorAll('a, button, input').forEach((element) => {
          element.tabIndex = -1;
        });
        clone.querySelectorAll('img').forEach((image) => {
          image.loading = 'eager';
        });
        return clone;
      };

      if (shouldLoop) {
        cards.slice(-cloneCount).reverse().forEach((card) => track.prepend(createClone(card)));
        cards.slice(0, cloneCount).forEach((card) => track.append(createClone(card)));
      }

      const cardStep = () => {
        if (!cards.length) return track.clientWidth;
        const gap = parseFloat(window.getComputedStyle(track).columnGap) || 0;
        return cards[0].getBoundingClientRect().width + gap;
      };

      let physicalIndex = cloneCount;
      let scrollEndTimer;

      const physicalIndexFromScroll = () => {
        return Math.round(track.scrollLeft / cardStep());
      };

      const logicalIndex = (index = physicalIndexFromScroll()) => {
        return ((index - cloneCount) % cards.length + cards.length) % cards.length;
      };

      const jumpToPhysicalIndex = (index) => {
        physicalIndex = index;
        track.scrollTo({ left: index * cardStep(), behavior: 'auto' });
      };

      const update = () => {
        const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
        physicalIndex = physicalIndexFromScroll();
        const index = logicalIndex(physicalIndex);
        track.dataset.saleIndex = String(index);
        if (current) current.textContent = String(index + 1).padStart(2, '0');
        previous.disabled = !shouldLoop || maxScroll <= 2;
        next.disabled = !shouldLoop || maxScroll <= 2;
      };

      const normalizePosition = () => {
        physicalIndex = physicalIndexFromScroll();
        if (physicalIndex >= cloneCount + cards.length) {
          jumpToPhysicalIndex(physicalIndex - cards.length);
        } else if (physicalIndex < cloneCount) {
          jumpToPhysicalIndex(physicalIndex + cards.length);
        }
        update();
      };

      const move = (direction) => {
        if (!shouldLoop) return;
        physicalIndex = physicalIndexFromScroll() + direction;
        track.scrollTo({
          left: physicalIndex * cardStep(),
          behavior: 'smooth',
        });
      };

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let autoplayTimer;
      const stopAutoplay = () => window.clearTimeout(autoplayTimer);
      const startAutoplay = () => {
        stopAutoplay();
        if (!shouldLoop || reduceMotion || document.hidden || campaign.matches(':hover') || campaign.contains(document.activeElement) || campaign.classList.contains('is-expired')) return;
        autoplayTimer = window.setTimeout(() => {
          move(1);
          startAutoplay();
        }, 5000);
      };
      const moveManually = (direction) => {
        move(direction);
        startAutoplay();
      };

      previous.addEventListener('click', () => moveManually(-1));
      next.addEventListener('click', () => moveManually(1));
      track.addEventListener('scroll', () => {
        update();
        window.clearTimeout(scrollEndTimer);
        scrollEndTimer = window.setTimeout(normalizePosition, 140);
      }, { passive: true });
      campaign.addEventListener('mouseenter', stopAutoplay);
      campaign.addEventListener('mouseleave', startAutoplay);
      campaign.addEventListener('focusin', stopAutoplay);
      campaign.addEventListener('focusout', () => {
        window.setTimeout(() => {
          if (!campaign.contains(document.activeElement)) startAutoplay();
        }, 0);
      });
      track.addEventListener('pointerdown', stopAutoplay, { passive: true });
      track.addEventListener('pointerup', startAutoplay, { passive: true });
      track.addEventListener('pointercancel', startAutoplay, { passive: true });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAutoplay();
        else startAutoplay();
      });
      window.addEventListener('resize', () => {
        jumpToPhysicalIndex(cloneCount + logicalIndex(physicalIndex));
        update();
      }, { passive: true });
      jumpToPhysicalIndex(cloneCount);
      update();
      startAutoplay();
    };

    const initializeCampaign = (campaign) => {
      if (campaign.dataset.countdownInitialized === 'true') return;
      campaign.dataset.countdownInitialized = 'true';

      if (campaign.dataset.saleActive !== 'true') return;

      const deadlineElement = campaign.querySelector('[data-sale-deadline]');
      const timerElement = campaign.querySelector('[data-sale-timer]');
      const expiredElement = campaign.querySelector('[data-sale-expired]');
      const exactDateElement = campaign.querySelector('[data-sale-end-date]');
      const deadline = Date.parse(campaign.dataset.saleEnd || '');

      if (!Number.isFinite(deadline)) {
        if (deadlineElement) deadlineElement.hidden = true;
        return;
      }

      if (exactDateElement) {
        exactDateElement.dateTime = new Date(deadline).toISOString();
        exactDateElement.textContent = new Intl.DateTimeFormat('en-PK', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          hour: 'numeric',
          minute: '2-digit',
          timeZone: 'Asia/Karachi',
          timeZoneName: 'short',
        }).format(deadline);
      }

      const outputs = {
        days: campaign.querySelector('[data-sale-days]'),
        hours: campaign.querySelector('[data-sale-hours]'),
        minutes: campaign.querySelector('[data-sale-minutes]'),
        seconds: campaign.querySelector('[data-sale-seconds]'),
      };

      let interval;
      const update = () => {
        const remaining = deadline - Date.now();
        if (remaining <= 0) {
          campaign.classList.add('is-expired');
          if (timerElement) timerElement.hidden = true;
          if (expiredElement) expiredElement.hidden = false;
          window.clearInterval(interval);
          return;
        }

        const totalSeconds = Math.floor(remaining / 1000);
        const values = {
          days: Math.floor(totalSeconds / 86400),
          hours: Math.floor((totalSeconds % 86400) / 3600),
          minutes: Math.floor((totalSeconds % 3600) / 60),
          seconds: totalSeconds % 60,
        };

        Object.entries(values).forEach(([key, value]) => {
          if (outputs[key]) outputs[key].textContent = String(value).padStart(2, '0');
        });
      };

      update();
      if (campaign.classList.contains('is-expired')) return;
      interval = window.setInterval(update, 1000);
    };

    const initializeAll = (root = document) => {
      root.querySelectorAll('[data-limited-sale]').forEach((campaign) => {
        initializeSlider(campaign);
        initializeCampaign(campaign);
      });
    };

    initializeAll();
    document.addEventListener('shopify:section:load', (event) => initializeAll(event.target));
  })();
