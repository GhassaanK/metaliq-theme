{% doc %}
  Renders a generated linework rosette for places that have no merchant image —
  a product or collection without a photo, an empty gallery slot. It is drawn
  in the current text colour, so the caller tints it. Deterministic: the same
  seed always produces the same figure, so a catalogue stays visually stable
  between page loads.

  @param {number} [seed] - Integer selecting the figure (e.g. product.id)
  @param {string} [label] - Accessible label; omit to keep it decorative

  @example
  {% render 'engraving', seed: product.id %}
  {% render 'engraving', seed: collection.id, label: collection.title %}
{% enddoc %}

{% liquid
  assign s = seed | default: 3 | abs
  assign variant = s | modulo: 5
  case variant
    when 0
      assign points = 6
    when 1
      assign points = 8
    when 2
      assign points = 10
    when 3
      assign points = 12
    else
      assign points = 16
  endcase
  assign step = 360.0 | divided_by: points
  assign spin = s | modulo: 24
%}

<svg
  class="engraving"
  viewBox="0 0 240 240"
  xmlns="http://www.w3.org/2000/svg"
  {% if label != blank %}role="img" aria-label="{{ label | escape }}"{% else %}aria-hidden="true" focusable="false"{% endif %}
>
  <g fill="none" stroke="currentColor" stroke-width="1" transform="rotate({{ spin }} 120 120)">
    <circle cx="120" cy="120" r="113" stroke-width="1.4" />
    <circle cx="120" cy="120" r="86" />
    <circle cx="120" cy="120" r="54" />
    <circle cx="120" cy="120" r="22" />
    {%- for i in (1..points) -%}
      {%- assign angle = i | times: step -%}
      <g transform="rotate({{ angle }} 120 120)">
        <path d="M120 9 C 149 58 149 182 120 231 C 91 182 91 58 120 9 Z" opacity="0.55" />
        <line x1="120" y1="9" x2="120" y2="231" opacity="0.26" />
      </g>
    {%- endfor -%}
  </g>
</svg>
