[
  {
    "name": "theme_info",
    "theme_name": "MetaliQ",
    "theme_version": "1.1.0",
    "theme_author": "MetaliQ",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "1200px",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "1320px",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "1320px"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 16,
        "max": 64,
        "step": 2,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 40
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#F4F1EA",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#FFFDF9",
        "label": "t:general.section"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#16130D",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#6D665B",
        "label": "t:general.secondary"
      },
      {
        "type": "color",
        "id": "line_color",
        "default": "#E0D9C9",
        "label": "t:general.content"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#B0552E",
        "label": "t:general.primary"
      },
      {
        "type": "color",
        "id": "dark_color",
        "default": "#201C16",
        "label": "t:general.theme"
      }
    ]
  },
  {
    "name": "t:general.custom_sizing",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:info.custom_sizing"
      },
      {
        "type": "checkbox",
        "id": "custom_size_enabled",
        "label": "t:labels.custom_size_enabled",
        "default": true
      },
      {
        "type": "product",
        "id": "surcharge_product",
        "label": "t:labels.surcharge_variant"
      },
      {
        "type": "page",
        "id": "quote_page",
        "label": "t:labels.quote_page",
        "info": "t:info.quote_page"
      },
      {
        "type": "range",
        "id": "custom_size_min",
        "min": 0.5,
        "max": 5,
        "step": 0.5,
        "unit": "ft",
        "label": "t:labels.custom_size_min",
        "default": 1
      },
      {
        "type": "range",
        "id": "custom_size_max",
        "min": 5,
        "max": 30,
        "step": 1,
        "unit": "ft",
        "label": "t:labels.custom_size_max",
        "default": 12
      }
    ]
  }
]
