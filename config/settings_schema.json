[
  {
    "name": "theme_info",
    "theme_name": "MetaliQ",
    "theme_version": "1.1.0",
    "theme_author": "MetaliQ",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "default": "playfair_display_n7",
        "label": "t:general.primary"
      },
      {
        "type": "paragraph",
        "content": "t:info.body_font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "1280px",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "1440px",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "1440px"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 16,
        "max": 80,
        "step": 2,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 64
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#121210",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#1C1C19",
        "label": "t:general.section"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#F4F2ED",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#AAA69F",
        "label": "t:general.secondary"
      },
      {
        "type": "color",
        "id": "line_color",
        "default": "#383833",
        "label": "t:general.content"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#FF7A2F",
        "label": "t:general.primary"
      },
      {
        "type": "color",
        "id": "dark_color",
        "default": "#1C1C1A",
        "label": "t:general.theme"
      },
      {
        "type": "color",
        "id": "footer_color",
        "default": "#0E0E0D",
        "label": "t:general.footer"
      }
    ]
  },
  {
    "name": "t:general.business_details",
    "settings": [
      {
        "type": "text",
        "id": "business_legal_name",
        "label": "t:labels.legal_name",
        "default": "Steed Art"
      },
      {
        "type": "text",
        "id": "business_phone",
        "label": "t:labels.phone",
        "default": "03172920243"
      },
      {
        "type": "text",
        "id": "business_email",
        "label": "t:labels.email",
        "default": "hello@metaliq.art"
      },
      {
        "type": "textarea",
        "id": "business_address",
        "label": "t:labels.business_address",
        "default": "Plot No 635, Gali No 15, Sector-F, Punjab Road, Manzoor Colony, Karachi, Sindh, Pakistan"
      },
      {
        "type": "header",
        "content": "t:general.whatsapp"
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "t:labels.whatsapp_number",
        "default": "+923172920243"
      },
      {
        "type": "textarea",
        "id": "whatsapp_custom_message",
        "label": "t:labels.whatsapp_message",
        "default": "Hi MetaliQ Art, I have a custom design in mind and would like to discuss it."
      },
      {
        "type": "header",
        "content": "t:general.social_media"
      },
      {
        "type": "url",
        "id": "instagram_url",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "facebook_url",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "tiktok_url",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "youtube_url",
        "label": "YouTube"
      }
    ]
  },
  {
    "name": "Commerce compliance",
    "settings": [
      {
        "type": "checkbox",
        "id": "online_payments_active",
        "label": "Online payments are active",
        "info": "Enable only after the payment gateway is approved, connected, and tested.",
        "default": false
      },
      {
        "type": "text",
        "id": "payment_provider_name",
        "label": "Online payment provider",
        "default": "Rapid Gateway"
      }
    ]
  }
]
