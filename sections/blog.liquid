<section class="container section blog-section">
  {% render 'breadcrumbs' %}

  <header class="blog-hero">
    <p class="eyebrow">{{ 'blog.eyebrow' | t }}</p>
    <h1>{{ blog.title }}</h1>
  </header>

  {%- paginate blog.articles by section.settings.posts_per_page -%}
    <div class="blog-grid">
      {%- for article in blog.articles -%}
        <article class="blog-card">
          <a class="blog-card__media media" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
            {%- if article.image -%}
              {{
                article.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 900, 1200',
                  sizes: '(min-width: 990px) 33vw, 100vw',
                  alt: article.image.alt | default: article.title
              }}
            {%- else -%}
              <span class="media-fallback">{% render 'engraving', seed: forloop.index %}</span>
            {%- endif -%}
          </a>
          <div class="blog-card__body">
            <p class="article-meta">
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{- article.published_at | date: format: 'date' -}}
              </time>
            </p>
            <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="blog-card__excerpt">
              {{- article.excerpt_or_content | strip_html | truncatewords: 24 -}}
            </p>
            <span class="link">{{ 'general.read_more' | t }}</span>
          </div>
        </article>
      {%- else -%}
        <div class="empty-state">
          <p>{{ 'blog.empty' | t }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="pagination">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% stylesheet %}
  .blog-section {
    padding-top: var(--sp-6);
  }
  .blog-hero {
    padding-block: var(--sp-6) var(--sp-7);
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-8) var(--sp-5);
  }
  .blog-card__media {
    display: block;
    aspect-ratio: 3 / 2;
  }
  .blog-card__media img,
  .blog-card__media .media-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .blog-card:hover .blog-card__media img {
    transform: scale(1.03);
  }
  .blog-card__body {
    padding-top: var(--sp-4);
  }
  .blog-card h2 {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-h3);
  }
  .blog-card__excerpt {
    margin-bottom: var(--sp-3);
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  @media (max-width: 900px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .blog-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-7);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": [
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "t:labels.posts_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
