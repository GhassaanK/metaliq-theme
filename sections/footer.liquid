{% liquid
  assign whatsapp_number = settings.whatsapp_number | default: '+923172920243' | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign custom_whatsapp_message = settings.whatsapp_custom_message
  if custom_whatsapp_message == blank
    assign custom_whatsapp_message = 'general.whatsapp_custom_message' | t
  endif
  assign custom_whatsapp_message = custom_whatsapp_message | url_encode
  assign custom_link = 'https://wa.me/' | append: whatsapp_number | append: '?text=' | append: custom_whatsapp_message
  assign instagram_url = settings.instagram_url | default: 'https://www.instagram.com/metaliq.art/'
  assign facebook_url = settings.facebook_url | default: 'https://www.facebook.com/metaliq.art/'
  assign tiktok_url = settings.tiktok_url | default: 'https://www.tiktok.com/@metaliq.art'
  assign youtube_url = settings.youtube_url | default: 'https://www.youtube.com/@metaliq.art'
  assign legal_name = settings.business_legal_name | default: 'Steed Art'
  assign phone = settings.business_phone | default: '03172920243'
  assign phone_link = phone | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign email = settings.business_email | default: 'hello@metaliq.art'
  assign business_address = settings.business_address | default: 'Plot No 635, Gali No 15, Sector-F, Punjab Road, Manzoor Colony, Karachi, Sindh, Pakistan'
%}

<footer class="site-footer">
  <div class="container">
    <div class="footer-callout">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.headline }}</h2>
      </div>
      <a class="footer-callout__link" href="{{ custom_link }}" data-whatsapp-cta target="_blank" rel="noopener">
        <span>{{ section.settings.custom_label }}</span>
        {% render 'icon', name: 'arrow-right' %}
      </a>
    </div>

    <div class="footer-main">
      <div class="footer-brand">
        {%- if section.settings.statement != blank -%}<p>{{ section.settings.statement }}</p>{%- endif -%}

        <div class="footer-newsletter">
          <h2>{{ 'general.footer_newsletter_heading' | t }}</h2>
          <p>{{ 'general.footer_newsletter_body' | t }}</p>
          {% form 'customer', class: 'footer-newsletter__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="FooterEmail">{{ 'general.footer_email_label' | t }}</label>
            <div class="footer-newsletter__field">
              <input id="FooterEmail" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ 'general.footer_email_placeholder' | t }}" autocomplete="email" required>
              <button type="submit" aria-label="{{ 'general.footer_subscribe' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
            </div>
            {%- if form.posted_successfully? -%}<p class="footer-newsletter__message">{{ 'general.footer_success' | t }}</p>{%- endif -%}
            {{ form.errors | default_errors }}
          {% endform %}
        </div>
      </div>

      <div class="footer-navigation">
        {%- for i in (1..3) -%}
          {%- liquid
            assign menu_key = 'menu_' | append: i
            assign heading_key = 'heading_' | append: i
            assign menu = section.settings[menu_key]
            assign heading = section.settings[heading_key]
          -%}
          <div class="footer-col">
            <h2>{{ heading }}</h2>
            <nav aria-label="{{ heading | escape }}">
              {%- if menu != blank -%}
                {%- for link in menu.links -%}
                  {%- liquid
                    assign menu_link_url = link.url
                    assign menu_link_is_custom = false
                    assign menu_link_title = link.title | downcase
                    if link.url contains '/pages/custom-design'
                      assign menu_link_is_custom = true
                    endif
                    if menu_link_title contains 'custom design'
                      assign menu_link_is_custom = true
                    endif
                    if menu_link_is_custom
                      assign menu_link_url = custom_link
                    endif
                  -%}
                  <a href="{{ menu_link_url }}"{% if menu_link_is_custom %} data-whatsapp-cta target="_blank" rel="noopener"{% endif %}>{{ link.title }}</a>
                {%- endfor -%}
              {%- elsif i == 1 -%}
                <a href="{{ routes.all_products_collection_url }}">{{ 'general.shop_all' | t }}</a>
                <a href="{{ routes.collections_url }}">{{ 'collections.title' | t }}</a>
                {%- if collections['best-sellers'] != blank -%}<a href="{{ collections['best-sellers'].url }}">{{ collections['best-sellers'].title }}</a>{%- endif -%}
                {%- if collections['new-arrivals'] != blank -%}<a href="{{ collections['new-arrivals'].url }}">{{ collections['new-arrivals'].title }}</a>{%- endif -%}
              {%- elsif i == 2 -%}
                <a href="/pages/about">{{ 'general.about_us' | t }}</a>
                <a href="{{ pages.contact.url | default: routes.root_url }}">{{ 'general.contact' | t }}</a>
                <a href="/pages/ordering-and-payments">{{ 'general.ordering_payments' | t }}</a>
                <a href="{{ custom_link }}" data-whatsapp-cta target="_blank" rel="noopener">{{ 'general.footer_custom_cta' | t }}</a>
              {%- else -%}
                <a href="/policies/refund-policy">{{ 'general.refund_policy' | t }}</a>
                <a href="/policies/privacy-policy">{{ 'general.privacy_policy' | t }}</a>
                <a href="/policies/terms-of-service">{{ 'general.terms_conditions' | t }}</a>
                <a href="/policies/shipping-policy">{{ 'general.shipping_policy' | t }}</a>
              {%- endif -%}
            </nav>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <a class="footer-signature" href="{{ routes.root_url }}" aria-label="{{ 'general.brand_home' | t: shop_name: shop.name }}">
      <img src="{{ 'metaliq-wordmark-light.webp' | asset_url }}" width="1200" height="305" alt="MetaliQ">
    </a>

    <div class="footer-bottom">
      <div class="footer-meta">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.rights_reserved' | t }}</span>
      </div>

      <div class="footer-details">
        <span>{{ legal_name | escape }}</span>
        <a href="tel:{{ phone_link }}">{{ phone | escape }}</a>
        <a href="mailto:{{ email | escape }}">{{ email | escape }}</a>
      </div>

      <div class="footer-extras">
        <div class="footer-socials" aria-label="{{ 'general.social_media' | t }}">
          <span class="footer-socials__label">{{ 'general.follow_us' | t }}</span>
          <a href="{{ instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          <a href="{{ facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
          <a href="{{ youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>
          <a href="{{ tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
        </div>
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <div class="payment-icons">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}</div>
        {%- endif -%}
      </div>
    </div>

    <address class="footer-address">{{ business_address | escape }}</address>
  </div>
</footer>

{%- if section.settings.show_whatsapp -%}
  {%- liquid
    assign whatsapp_text = settings.whatsapp_custom_message
    if whatsapp_text == blank
      assign whatsapp_text = 'general.whatsapp_custom_message' | t
    endif
    assign whatsapp_text = whatsapp_text | url_encode
  -%}
  <aside class="whatsapp-widget" data-whatsapp-widget aria-label="{{ 'general.whatsapp_label' | t }}">
    {%- if section.settings.show_whatsapp_prompt -%}
      <div class="whatsapp-widget__prompt" data-whatsapp-prompt>
        <p>{{ section.settings.whatsapp_prompt | escape }}</p>
        <button type="button" aria-label="{{ 'general.whatsapp_close' | t }}" data-whatsapp-close>
          {% render 'icon', name: 'close' %}
        </button>
      </div>
    {%- endif -%}
    <a
      class="whatsapp-widget__button"
      href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_text }}"
      data-whatsapp-cta
      target="_blank"
      rel="noopener"
      aria-label="{{ 'general.whatsapp_unread_label' | t }}"
    >
      {% render 'icon', name: 'whatsapp' %}
      <span class="whatsapp-widget__count" aria-hidden="true">1</span>
    </a>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    { "type": "header", "content": "Footer callout" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made for your space" },
    { "type": "text", "id": "headline", "label": "Heading", "default": "Have a wall in mind? Let's make it impossible to ignore." },
    { "type": "text", "id": "custom_label", "label": "Button label", "default": "Start a custom design" },
    { "type": "textarea", "id": "statement", "label": "t:labels.text", "default": "Precision-cut metal art, designed to give modern spaces a point of view." },
    { "type": "header", "content": "t:general.explore" },
    { "type": "text", "id": "heading_1", "label": "t:labels.heading", "default": "Shop" },
    { "type": "link_list", "id": "menu_1", "label": "t:labels.menu" },
    { "type": "text", "id": "heading_2", "label": "t:labels.heading", "default": "MetaliQ" },
    { "type": "link_list", "id": "menu_2", "label": "t:labels.menu" },
    { "type": "text", "id": "heading_3", "label": "t:labels.heading", "default": "Policies" },
    { "type": "link_list", "id": "menu_3", "label": "t:labels.menu" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:labels.show_payment_icons", "default": true },
    { "type": "header", "content": "WhatsApp" },
    { "type": "checkbox", "id": "show_whatsapp", "label": "Show WhatsApp button", "default": true },
    { "type": "text", "id": "whatsapp_prompt", "label": "Popup message", "default": "Have a custom design in mind? Let's make it happen." },
    { "type": "checkbox", "id": "show_whatsapp_prompt", "label": "Show popup message", "default": true }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
