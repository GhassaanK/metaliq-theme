<div class="custom-section {% if section.settings.background_image %}custom-section--image{% endif %}">
  {%- if section.settings.background_image -%}
    <div class="custom-section__bg">
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag: loading: 'lazy', widths: '800, 1200, 1800, 2400', sizes: '100vw', alt: ''
      }}
    </div>
  {%- endif -%}

  <div class="container custom-section__content">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .custom-section {
    position: relative;
    padding-block: var(--section);
    overflow: hidden;
  }
  .custom-section__bg,
  .custom-section__bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .custom-section--image .custom-section__content {
    position: relative;
    color: var(--on-nav);
  }
  .custom-section--image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--background) 42%, transparent);
  }
  .custom-section__content {
    position: relative;
    display: grid;
    gap: var(--sp-5);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_section",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "t:labels.background_image" }
  ],
  "presets": [{ "name": "t:general.custom_section" }]
}
{% endschema %}
