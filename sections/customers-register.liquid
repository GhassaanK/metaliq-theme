<section class="container section auth-page auth-page--single">
  <div class="auth-card">
    <p class="eyebrow">{{ 'customer.account.eyebrow' | t }}</p>
    <h1>{{ 'customer.register.title' | t }}</h1>

    {% form 'create_customer' %}
      {%- if form.errors -%}
        <div class="form-errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="field-grid">
        <label class="field">
          {{ 'customer.register.first_name' | t }}
          <input type="text" name="customer[first_name]" autocomplete="given-name">
        </label>
        <label class="field">
          {{ 'customer.register.last_name' | t }}
          <input type="text" name="customer[last_name]" autocomplete="family-name">
        </label>
      </div>

      <label class="field">
        {{ 'customer.register.email' | t }}
        <input type="email" name="customer[email]" autocomplete="email" required>
      </label>

      <label class="field">
        {{ 'customer.register.password' | t }}
        <input type="password" name="customer[password]" autocomplete="new-password" required>
      </label>

      <button class="button button--primary" type="submit">{{ 'customer.register.submit' | t }}</button>
    {% endform %}

    <p class="auth-alt">
      {{ 'customer.register.has_account' | t }}
      <a class="link" href="{{ routes.account_login_url }}">{{ 'customer.register.login' | t }}</a>
    </p>
  </div>
</section>

{% render 'account-styles' %}

{% schema %}
{
  "name": "t:general.register",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
