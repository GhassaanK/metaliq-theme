<section class="container page-section">
  {% render 'breadcrumbs' %}

  <header class="page-header collections-header">
    <p class="eyebrow">{{ 'collections.eyebrow' | t }}</p>
    <h1>{{ 'collections.title' | t }}</h1>
  </header>

  {%- paginate collections by section.settings.per_page -%}
    <div class="collection-card-grid">
      {%- for collection in collections -%}
        <a class="collection-card" href="{{ collection.url }}">
          <div class="collection-card__media">
            {%- if collection.featured_image -%}
              {{
                collection.featured_image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 990px) 33vw, 100vw', alt: collection.featured_image.alt | default: collection.title
              }}
            {%- else -%}
              <span class="collection-card__placeholder" aria-hidden="true">{{ collection.title | slice: 0 }}</span>
            {%- endif -%}
          </div>
          <div class="collection-card__content">
            <h2>{{ collection.title }}</h2>
            <span>{{ 'collection.count' | t: count: collection.products_count }}</span>
          </div>
        </a>
      {%- else -%}
        <div class="empty-state">
          <p>{{ 'collections.empty' | t }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="pagination">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% stylesheet %}
  .collections-header {
    padding-block: 30px 40px;
  }

  .collection-card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .collection-card {
    min-width: 0;
  }

  .collection-card__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: color-mix(in srgb, var(--line) 55%, var(--background));
  }

  .collection-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .collection-card:hover img {
    transform: scale(1.03);
  }

  .collection-card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: color-mix(in srgb, var(--ink) 22%, transparent);
    font-family: var(--serif);
    font-size: 5rem;
  }

  .collection-card__content {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 0;
  }

  .collection-card__content h2 {
    margin: 0;
    font-size: 1.45rem;
  }

  .collection-card__content span {
    color: var(--muted);
    font-size: 0.7rem;
  }

  @media (max-width: 900px) {
    .collection-card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .collection-card-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "t:labels.products_per_page",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 12
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
