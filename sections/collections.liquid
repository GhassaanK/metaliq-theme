<section class="container section collection-section">
  {% render 'breadcrumbs' %}

  <header class="collection-hero">
    <p class="eyebrow">{{ 'collections.eyebrow' | t }}</p>
    <h1>{{ 'collections.title' | t }}</h1>
  </header>

  {%- paginate collections by section.settings.per_page -%}
    <div class="collections-grid">
      {%- for collection in collections -%}
        <a class="collections-grid__item" href="{{ collection.url }}">
          <span class="media collections-grid__media">
            {%- if collection.featured_image -%}
              {{
                collection.featured_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 900, 1200',
                  sizes: '(min-width: 990px) 33vw, 100vw',
                  alt: collection.featured_image.alt | default: collection.title
              }}
            {%- else -%}
              <span class="media-fallback">
                {% render 'engraving', seed: collection.id, label: collection.title %}
              </span>
            {%- endif -%}
          </span>
          <span class="collections-grid__caption">
            <span class="collections-grid__title">{{ collection.title }}</span>
            <span class="collections-grid__count">
              {{- 'collection.count' | t: count: collection.products_count -}}
            </span>
          </span>
        </a>
      {%- else -%}
        <div class="empty-state">
          <p>{{ 'collections.empty' | t }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="pagination">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% stylesheet %}
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-7) var(--sp-5);
  }
  .collections-grid__media {
    display: block;
    aspect-ratio: 3 / 4;
  }
  .collections-grid__media img,
  .collections-grid__media .media-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  .collections-grid__item:hover .collections-grid__media img,
  .collections-grid__item:hover .collections-grid__media .media-fallback {
    transform: scale(1.04);
  }
  .collections-grid__caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
    padding-top: var(--sp-3);
  }
  .collections-grid__title {
    font-family: var(--serif);
    font-size: var(--fs-h4);
  }
  .collections-grid__count {
    color: var(--muted);
    font-size: 0.72rem;
  }
  @media (max-width: 900px) {
    .collections-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .collections-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "t:labels.products_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
