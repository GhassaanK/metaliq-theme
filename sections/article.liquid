<article class="article-page">
  <div class="container container--narrow">
    {% render 'breadcrumbs' %}

    <header class="article-head">
      <p class="article-meta">
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{- article.published_at | date: format: 'date' -}}
        </time>
        {%- if article.author != blank %} &middot; {{ article.author }}{% endif -%}
      </p>
      <h1>{{ article.title }}</h1>
    </header>
  </div>

  {%- if article.image -%}
    <div class="container">
      <div class="article-hero media">
        {{
          article.image
          | image_url: width: 2000
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '700, 1000, 1400, 1800, 2000',
            sizes: '(min-width: 1200px) 1140px, 100vw',
            alt: article.image.alt | default: article.title
        }}
      </div>
    </div>
  {%- endif -%}

  <div class="container container--narrow">
    <div class="rte page-content article-body">{{ article.content }}</div>

    <p class="article-back">
      <a class="link" href="{{ blog.url }}">{{ 'blog.back_to_blog' | t: title: blog.title }}</a>
    </p>

    {%- if blog.comments_enabled? -%}
      <section class="article-comments">
        <h2>{{ 'blog.article_comments' | t }}</h2>

        {%- if article.comments_count > 0 -%}
          <ol class="comment-list">
            {%- for comment in article.comments -%}
              <li>
                <p class="article-meta">
                  {{ comment.author }} &middot;
                  <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
                    {{- comment.created_at | date: format: 'date' -}}
                  </time>
                </p>
                <div class="rte">{{ comment.content }}</div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        {% form 'new_comment', article %}
          <h3>{{ 'blog.comment_form_title' | t }}</h3>

          {%- if form.posted_successfully? -%}
            <p class="form-success" tabindex="-1" autofocus>
              {%- if blog.moderated? -%}
                {{ 'blog.comment_moderated' | t }}
              {%- else -%}
                {{ 'blog.comment_posted' | t }}
              {%- endif -%}
            </p>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="form-errors">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <div class="field-grid">
            <label class="field">
              {{ 'blog.comment_form_name' | t }}
              <input type="text" name="comment[author]" autocomplete="name" required>
            </label>
            <label class="field">
              {{ 'blog.comment_form_email' | t }}
              <input type="email" name="comment[email]" autocomplete="email" required>
            </label>
          </div>

          <label class="field">
            {{ 'blog.comment_form_body' | t }}
            <textarea name="comment[body]" rows="5" required></textarea>
          </label>

          <button class="button button--primary" type="submit">{{ 'blog.comment_form_submit' | t }}</button>
        {% endform %}
      </section>
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  .article-page {
    padding-block: var(--sp-6) var(--section);
  }
  .article-head {
    padding-block: var(--sp-5) var(--sp-6);
    text-align: center;
  }
  .article-head h1 {
    font-size: var(--fs-h1);
  }
  .article-hero {
    aspect-ratio: 16 / 9;
    margin-block: var(--sp-6) var(--sp-8);
  }
  .article-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-body {
    font-size: var(--fs-lead);
  }
  .article-back {
    margin-top: var(--sp-8);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line);
  }
  .article-comments {
    margin-top: var(--sp-9);
  }
  .comment-list {
    margin: 0 0 var(--sp-7);
  }
  .comment-list li {
    padding: var(--sp-5) 0;
    border-top: 1px solid var(--line);
  }
  .comment-list li .rte {
    margin-top: var(--sp-2);
  }
  .article-comments form {
    display: grid;
    gap: var(--sp-4);
  }
  .article-comments h3 {
    font-size: var(--fs-h3);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
