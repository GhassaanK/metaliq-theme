<article class="container page-section narrow-page article-page">
  {% render 'breadcrumbs' %}

  <header class="article-header">
    <p class="article-meta">
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
        {{- article.published_at | date: format: 'date' -}}
      </time>
      {%- if article.author != blank %} · {{ article.author }}{% endif -%}
    </p>
    <h1>{{ article.title }}</h1>
  </header>

  {%- if article.image -%}
    <div class="article-hero">
      {{
        article.image
        | image_url: width: 1800
        | image_tag: loading: 'eager', widths: '600, 900, 1200, 1800', sizes: '(min-width: 940px) 900px, 100vw', alt: article.image.alt | default: article.title
      }}
    </div>
  {%- endif -%}

  <div class="rte page-content">{{ article.content }}</div>

  <p class="article-back">
    <a class="text-link" href="{{ blog.url }}">{{ 'blog.back_to_blog' | t: title: blog.title }}</a>
  </p>

  {%- if blog.comments_enabled? -%}
    <section class="article-comments">
      <h2>{{ 'blog.article_comments' | t }}</h2>

      {%- if article.comments_count > 0 -%}
        <ol class="comment-list">
          {%- for comment in article.comments -%}
            <li>
              <p class="article-meta">
                {{- comment.author }} ·
                <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
                  {{- comment.created_at | date: format: 'date' -}}
                </time>
              </p>
              <div class="rte">{{ comment.content }}</div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {% form 'new_comment', article %}
        <h3>{{ 'blog.comment_form_title' | t }}</h3>

        {%- if form.posted_successfully? -%}
          <p class="form-success" tabindex="-1" autofocus>
            {%- if blog.moderated? -%}
              {{ 'blog.comment_moderated' | t }}
            {%- else -%}
              {{ 'blog.comment_posted' | t }}
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="form-errors">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="field-grid">
          <label class="field">
            {{ 'blog.comment_form_name' | t }}
            <input type="text" name="comment[author]" autocomplete="name" required>
          </label>
          <label class="field">
            {{ 'blog.comment_form_email' | t }}
            <input type="email" name="comment[email]" autocomplete="email" required>
          </label>
        </div>

        <label class="field">
          {{ 'blog.comment_form_body' | t }}
          <textarea name="comment[body]" rows="5" required></textarea>
        </label>

        <button class="button button--primary" type="submit">{{ 'blog.comment_form_submit' | t }}</button>
      {% endform %}
    </section>
  {%- endif -%}
</article>

{% stylesheet %}
  .article-header {
    padding-block: 20px 26px;
  }

  .article-page h1 {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
  }

  .article-hero {
    margin-bottom: 34px;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: color-mix(in srgb, var(--line) 55%, var(--background));
  }

  .article-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-back {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .article-comments {
    margin-top: 50px;
  }

  .comment-list {
    margin: 0 0 40px;
    padding: 0;
    list-style: none;
  }

  .comment-list li {
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }

  .article-comments form {
    display: grid;
    gap: 16px;
    max-width: 620px;
  }

  .article-comments h3 {
    margin: 0;
    font-size: 1.3rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
