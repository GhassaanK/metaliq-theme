{% comment %}
  A custom-size piece is two line items: the piece, and the surcharge units that
  make its price correct. This template folds the surcharge back into the piece
  it belongs to, so the customer sees one line at one honest price.
  `cart.total_price` already counts both, so the summary needs no adjustment.
{% endcomment %}

{%- capture visible_item_count -%}{%- render 'visible-cart-count', cart: cart -%}{%- endcapture -%}
{%- assign visible_item_count = visible_item_count | strip | plus: 0 -%}

<section class="container section cart-section">
  <header class="cart-head">
    <p class="eyebrow">{{ 'cart.eyebrow' | t }}</p>
    <h1>{{ 'cart.title' | t }}</h1>
    <div class="cart-head__meta">
      <p>{{ 'cart.intro' | t }}</p>
      <span>{{ 'cart.item_count' | t: count: visible_item_count }}</span>
    </div>
  </header>

  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      <h2>{{ 'cart.empty_title' | t }}</h2>
      <p>{{ 'cart.empty_body' | t }}</p>
      <a class="button button--primary" href="{{ routes.all_products_collection_url }}">
        {{- 'cart.empty_action' | t -}}
      </a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-layout">
      <div class="cart-lines">
        {%- for item in cart.items -%}
          {% liquid
            assign surcharge_for = item.properties['_surcharge_for']
            assign group = item.properties['_size_group']

            assign has_parent = false
            if surcharge_for != blank
              for other in cart.items
                if other.properties['_size_group'] == surcharge_for
                  assign has_parent = true
                  break
                endif
              endfor
            endif

            assign extra_price = 0
            assign remove_keys = item.key
            if group != blank
              for other in cart.items
                if other.properties['_surcharge_for'] == group
                  assign extra_price = extra_price | plus: other.final_line_price
                  assign remove_keys = remove_keys | append: ',' | append: other.key
                endif
              endfor
            endif

            assign line_total = item.final_line_price | plus: extra_price
            assign is_grouped = false
            if extra_price > 0
              assign is_grouped = true
            endif
          %}

          {%- if surcharge_for != blank and has_parent -%}
            {% continue %}
          {%- endif -%}

          <article class="cart-line">
            <a class="cart-line__media media" href="{{ item.url }}">
              {%- if item.image -%}
                {{
                  item.image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'eager',
                    widths: '180, 320, 480, 600',
                    sizes: '(max-width: 520px) calc(100vw - 64px), 180px',
                    alt: item.image.alt | default: item.product.title
                }}
              {%- else -%}
                <span class="media-fallback">{% render 'engraving', seed: item.product.id %}</span>
              {%- endif -%}
            </a>

            <div class="cart-line__info">
              {%- if item.product.type != blank -%}
                <p class="cart-line__kicker">{{ item.product.type }}</p>
              {%- endif -%}
              <h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2>

              {%- if item.product.description != blank -%}
                <div class="cart-line__description rte">{{ item.product.description }}</div>
              {%- endif -%}

              <div class="cart-line__controls">
                {%- if is_grouped -%}
                  <span class="cart-line__qty"><span>{{ 'general.quantity' | t }}</span> {{ item.quantity }}</span>
                {%- else -%}
                  <label class="cart-line__quantity" for="Updates-{{ item.key }}">
                    {{ 'general.quantity' | t }}
                    <input
                      id="Updates-{{ item.key }}"
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="1"
                      aria-label="{{ 'general.quantity' | t }}: {{ item.product.title | escape }}"
                    >
                  </label>
                {%- endif -%}
                <a
                  href="{{ item.url_to_remove }}"
                  class="cart-line__remove link"
                  data-remove-group="{{ remove_keys }}"
                >
                  {{- 'cart.remove' | t -}}
                </a>
              </div>

            </div>

            <div class="cart-line__aside">
              <span>{{ 'cart.line_total' | t }}</span>
              <strong class="cart-line__price price">{{ line_total | money }}</strong>
            </div>
          </article>
        {%- endfor -%}

        <button class="button button--ghost" type="submit" name="update">{{ 'cart.update' | t }}</button>
      </div>

      <aside class="cart-summary">
        <p class="eyebrow">{{ 'cart.summary_eyebrow' | t }}</p>
        <h2>{{ 'cart.summary' | t }}</h2>
        <div class="cart-summary__row cart-summary__row--items">
          <span>{{ 'cart.item_count' | t: count: visible_item_count }}</span>
        </div>
        <div class="cart-summary__row">
          <span>{{ 'cart.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <p class="field-note">{{ 'cart.tax_note' | t }}</p>
        <div class="cart-summary__disclosure">
          <p><strong>{{ 'cart.payment_title' | t }}</strong>
            {% render 'payment-status', active_key: 'cart.payment_active_body', inactive_key: 'cart.payment_body' %}
          </p>
          <p>{{ 'cart.delivery_body' | t }}</p>
          <a href="/pages/ordering-and-payments">{{ 'general.ordering_payments' | t }}</a>
          <a href="/policies/shipping-policy">{{ 'general.shipping_policy' | t }}</a>
        </div>
        <button class="button button--primary button--block" type="submit" name="checkout">
          {{- 'cart.checkout' | t -}}
        </button>
        <a class="link cart-summary__continue" href="{{ routes.all_products_collection_url }}">
          {{- 'cart.continue' | t -}}
        </a>
        {%- liquid
          assign cart_whatsapp_label = 'cart.whatsapp_cta' | t
          assign cart_whatsapp_message = 'cart.whatsapp_message' | t
        -%}
        {% render 'whatsapp-link', label: cart_whatsapp_label, message: cart_whatsapp_message, css_class: 'cart-summary__whatsapp' %}
      </aside>
    </form>
  {%- endif -%}
</section>

{% stylesheet %}
  .cart-section {
    padding-top: clamp(34px, 5vw, 72px);
  }
  .cart-head {
    margin-bottom: clamp(34px, 5vw, 64px);
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .cart-head h1 {
    margin-top: 12px;
    font-size: clamp(3rem, 2.3rem + 3vw, 6rem);
    line-height: 0.95;
  }
  .cart-head__meta {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-top: 22px;
    color: var(--muted);
  }
  .cart-head__meta p {
    max-width: 52ch;
    line-height: 1.65;
  }
  .cart-head__meta span {
    flex: 0 0 auto;
    color: var(--copper);
    font-size: var(--fs-label-sm);
    font-weight: 600;
    text-transform: uppercase;
  }
  .cart-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(300px, 0.68fr);
    align-items: start;
    gap: clamp(24px, 5vw, 56px);
  }
  .cart-lines {
    display: grid;
    gap: 16px;
  }
  .cart-line {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr) auto;
    align-items: start;
    gap: clamp(20px, 3vw, 34px);
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }
  .cart-line__media {
    display: block;
    width: 100%;
    min-width: 0;
    align-self: start;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 5px;
    background: var(--background);
  }
  .cart-line__media img {
    width: 100%;
    height: 100%;
    padding: 8px;
    object-fit: contain;
  }
  .cart-line__media .engraving {
    width: 66%;
  }
  .cart-line__info {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }
  .cart-line__info h2 {
    margin: 5px 0 14px;
    font-size: clamp(1.35rem, 1.15rem + 0.45vw, 1.75rem);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }
  .cart-line__kicker {
    color: var(--copper);
    font-size: 0.64rem;
    text-transform: uppercase;
  }
  .cart-line__description {
    max-width: 68ch;
    color: var(--muted);
    font-size: var(--fs-sm);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .cart-line__description > * + * {
    margin-top: 10px;
  }
  .cart-line__description img,
  .cart-line__description video,
  .cart-line__description iframe {
    max-width: 100%;
    height: auto;
  }
  .cart-line__controls {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    margin-top: auto;
    padding-top: 22px;
  }
  .cart-line__quantity {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: var(--fs-label-sm);
  }
  .cart-line__controls input {
    width: 64px;
    min-height: 38px;
    padding: 7px 9px;
    text-align: center;
  }
  .cart-line__qty {
    display: flex;
    gap: 10px;
    font-size: var(--fs-label-sm);
    font-weight: 500;
  }
  .cart-line__qty span {
    color: var(--muted);
    font-weight: 400;
  }
  .cart-line__remove {
    color: var(--muted);
    font-size: var(--fs-label-sm);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .cart-line__remove:hover {
    color: var(--copper);
  }
  .cart-line__aside {
    display: flex;
    min-width: 100px;
    align-items: flex-end;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    padding-left: 18px;
    border-left: 1px solid var(--line);
  }
  .cart-line__aside > span {
    color: var(--muted);
    font-size: 0.64rem;
    text-transform: uppercase;
  }
  .cart-line__price {
    font-size: clamp(1rem, 0.9rem + 0.3vw, 1.25rem);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .cart-lines > .button {
    justify-self: end;
    margin-top: 4px;
  }
  .cart-summary {
    position: sticky;
    top: calc(var(--header-height) + var(--sp-5));
    padding: clamp(24px, 3vw, 34px);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }
  .cart-summary > .eyebrow {
    margin-bottom: 10px;
  }
  .cart-summary h2 {
    font-size: var(--fs-h3);
  }
  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    margin-top: var(--sp-4);
    padding: var(--sp-4) 0;
    border-block: 1px solid var(--line);
    font-variant-numeric: tabular-nums;
  }
  .cart-summary__row--items {
    margin-top: 24px;
    padding: 12px 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 0;
    color: var(--muted);
    font-size: var(--fs-label-sm);
  }
  .cart-summary__row--items + .cart-summary__row {
    margin-top: 0;
    border-top: 0;
  }
  .cart-summary .button {
    margin-top: var(--sp-4);
  }
  .cart-summary__disclosure {
    display: grid;
    gap: 8px;
    margin-top: var(--sp-4);
    padding: var(--sp-4) 0;
    border-block: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.55;
  }
  .cart-summary__disclosure strong { color: var(--ink); }
  .cart-summary__disclosure a { width: fit-content; color: var(--copper); text-decoration: underline; text-underline-offset: 3px; }
  .cart-summary__continue {
    display: block;
    margin-top: var(--sp-4);
    text-align: center;
    font-size: var(--fs-sm);
  }
  .cart-summary__whatsapp {
    margin: var(--sp-5) auto 0;
  }
  @media (max-width: 860px) {
    .cart-layout {
      grid-template-columns: 1fr;
    }
    .cart-summary {
      position: static;
    }
  }
  @media (max-width: 680px) {
    .cart-head__meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }
    .cart-line {
      grid-template-columns: 118px minmax(0, 1fr);
      gap: 18px;
      padding: 14px;
    }
    .cart-line__aside {
      grid-column: 2;
      min-width: 0;
      align-items: center;
      flex-direction: row;
      padding: 14px 0 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }
  }
  @media (max-width: 520px) {
    .cart-section {
      padding-top: 28px;
    }
    .cart-line {
      grid-template-columns: 1fr;
    }
    .cart-line__media {
      aspect-ratio: 16 / 10;
      max-height: 240px;
    }
    .cart-line__aside {
      grid-column: 1;
    }
    .cart-line__controls {
      justify-content: space-between;
    }
    .cart-lines > .button {
      width: 100%;
      justify-self: stretch;
    }
    .cart-summary {
      padding: 22px 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
