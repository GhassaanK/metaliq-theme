<section class="container page-section cart-page"><header class="page-header"><p class="eyebrow">Your selection</p><h1>{{ 'cart.title' | t }}</h1></header>{% if cart.item_count == 0 %}<div class="empty-state"><h2>Your cart is empty</h2><p>Find a piece that gives the wall its character.</p><a class="button button--primary" href="{{ routes.all_products_collection_url }}">Explore metal art</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-layout"><div class="cart-lines">{% for item in cart.items %}<article class="cart-line"><a class="cart-line__image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: item.image.alt | default: item.product.title }}{% endif %}</a><div class="cart-line__content"><div><p class="cart-line__collection">{{ item.product.type }}</p><h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title }}</p>{% endunless %}{% for property in item.properties %}{% assign property_first = property.first | slice: 0 %}{% unless property.last == blank or property_first == '_' %}<p class="line-property"><span>{{ property.first }}:</span> {{ property.last }}</p>{% endunless %}{% endfor %}</div><div class="cart-line__controls"><label for="Updates-{{ item.key }}">Quantity</label><input id="Updates-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><a href="{{ item.url_to_remove }}">Remove</a></div></div><strong class="cart-line__price">{{ item.final_line_price | money }}</strong></article>{% endfor %}<button class="button button--secondary" type="submit" name="update">Update cart</button></div><aside class="cart-summary"><h2>Order summary</h2><div><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><p>Shipping and taxes are calculated at checkout.</p><button class="button button--primary" type="submit" name="checkout">Secure checkout</button><a class="text-link" href="{{ routes.all_products_collection_url }}">Continue shopping</a></aside></div></form>{% endif %}</section>
{% schema %}{"name":"t:general.cart","settings":[]}{% endschema %}
