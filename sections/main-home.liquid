    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .home-hero-card:hover .home-hero-card__info,
  .home-hero-card:focus-visible .home-hero-card__info {
    opacity: 1;
    transform: none;
  }
  .home-hero-card__info strong {
    font-size: 0.78rem;
    line-height: 1.25;
  }
  .home-hero-card__info span {
    color: rgb(255 255 255 / 0.72);
    font-size: 0.7rem;
  }
  .home-hero__footer {
    display: grid;
    justify-items: center;
    gap: 12px;
    text-align: center;
  }
  .home-hero__body {
    max-width: 44rem;
    color: rgb(247 245 240 / 0.76);
    font-size: 1rem;
    line-height: 1.5;
  }
  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 2px;
  }
  .home-hero__actions .button {
    min-width: 154px;
    background: #f7f5f0;
    color: #171715;
  }
  .home-hero__actions .button:hover { background: #fff; }
  .home-hero__text-link {
    padding-block: 8px;
    border-bottom: 1px solid rgb(247 245 240 / 0.5);
    color: #f7f5f0;
    font-size: 0.78rem;
    font-weight: 500;
  }
  .home-hero__text-link span { margin-left: 12px; }

  @media (max-width: 980px) {
    .home-hero__artworks {
      display: block;
      width: min(100%, 900px);
      padding-inline: 0;
      overflow-x: auto;
      overflow-y: hidden;
      cursor: grab;
      scrollbar-width: none;
      touch-action: pan-x pan-y;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    }
    .home-hero__artworks::-webkit-scrollbar { display: none; }
    .home-hero__artworks:active { cursor: grabbing; }
    .home-hero__track,
    .home-hero__group {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      width: max-content;
      gap: var(--reel-gap, 16px);
    }
    .home-hero__track {
      --reel-gap: 16px;
      --reel-half-gap: 8px;
      animation: none;
      transform: none;
    }
    .home-hero__group[aria-hidden='true'] {
      display: flex;
    }
    .home-hero-card {
      flex: 0 0 190px;
      margin-inline: 0;
      transform: none;
      animation: none;
      translate: none;
    }
    .home-hero-card:hover,
    .home-hero-card:focus-visible {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 760px) {
    .home-hero::before { opacity: 0.62; }
    .home-hero::after {
