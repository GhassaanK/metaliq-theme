    color: var(--muted);
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.12rem);
    line-height: 1.7;
  }
  .home-why__intro .link-rule {
    margin-top: 34px;
  }
  .home-why__benefits {
    border-top: 1px solid var(--line);
  }
  .home-why__benefit {
    display: grid;
    grid-template-columns: 34px 52px minmax(0, 1fr);
    align-items: start;
    gap: 18px;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }
  .home-why__number {
    padding-top: 4px;
    color: var(--muted);
    font-size: 0.64rem;
    font-variant-numeric: tabular-nums;
  }
  .home-why__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgb(255 122 47 / 0.35);
    border-radius: 50%;
    color: var(--copper);
  }
  .home-why__icon .icon {
    width: 20px;
    height: 20px;
  }
  .home-why__benefit h3 {
    margin-bottom: 7px;
    font-family: var(--serif);
    font-size: 1.18rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .home-why__benefit p {
    max-width: 52ch;
    color: var(--muted);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  /* ---- Custom design ---- */
  .home-custom {
    border-bottom: 1px solid var(--line);
    background: #10100f;
    color: var(--on-dark);
  }
  .home-custom__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(44px, 7vw, 104px);
  }
  .home-custom__copy .eyebrow {
    color: var(--copper);
  }
  .home-custom__copy h2 {
    max-width: 10ch;
    margin: 14px 0 22px;
    font-size: clamp(2.7rem, 2rem + 3vw, 5.4rem);
    line-height: 0.96;
  }
  .home-custom__body {
    max-width: 48ch;
    color: var(--on-dark-muted);
    font-size: clamp(1rem, 0.95rem + 0.22vw, 1.14rem);
    line-height: 1.7;
  }
  .home-custom__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 34px 0;
    border-block: 1px solid rgb(255 255 255 / 0.14);
  }
  .home-custom__steps li {
    display: grid;
    gap: 7px;
    padding: 18px 12px 18px 0;
  }
  .home-custom__steps li + li {
    padding-left: 16px;
    border-left: 1px solid rgb(255 255 255 / 0.14);
  }
  .home-custom__steps span {
    color: var(--copper);
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
  }
  .home-custom__steps strong {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .home-custom__button {
    display: inline-flex;
    align-items: center;
    gap: 30px;
    background: var(--copper);
    color: var(--on-accent);
  }
  .home-custom__button:hover {
    background: #ff9255;
  }
  .home-custom__note {
    margin-top: 14px;
    color: var(--on-dark-muted);
    font-size: 0.72rem;
  }
  .home-custom__visual {
    position: relative;
    min-height: 560px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 8px;
    background: #20201d;
  }
  .home-custom__visual::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 52%, rgb(0 0 0 / 0.76));
    content: '';
    pointer-events: none;
  }
  .home-custom__visual img {
    width: 100%;
    height: 100%;
    min-height: 560px;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  .home-custom__visual:hover img {
    transform: scale(1.025);
  }
  .home-custom__visual-label {
    position: absolute;
    z-index: 1;
    right: 24px;
    bottom: 24px;
    left: 24px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
  }
  .home-custom__visual-label span {
    color: rgb(255 255 255 / 0.65);
    font-size: 0.68rem;
    text-transform: uppercase;
  }
  .home-custom__visual-label strong {
    max-width: 13ch;
    font-family: var(--serif);
    font-size: clamp(1.5rem, 1rem + 1.4vw, 2.35rem);
    font-weight: var(--heading-weight);
    line-height: 1.05;
    text-align: right;
  }

  /* ---- Recently added ---- */
  .home-recent {
    border-bottom: 1px solid var(--line);
    background: var(--background);
  }
  .home-recent__head {
    align-items: end;
  }
  .home-recent__intro {
    max-width: 42ch;
    margin-top: 10px;
    color: var(--muted);
    font-size: var(--fs-label);
  }
  .home-recent__actions,
  .home-recent__controls {
    display: flex;
    align-items: center;
  }
  .home-recent__actions {
    gap: 24px;
  }
  .home-recent__controls {
    gap: 8px;
  }
  .home-recent__button {
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink);
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .home-recent__button:hover {
    border-color: var(--copper);
    color: var(--copper);
  }
  .home-recent__button:disabled {
    opacity: 0.28;
    cursor: default;
  }
  .home-recent__button--previous svg {
    transform: rotate(180deg);
  }
  .home-recent__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 60px) / 4);
    gap: 20px;
    padding-bottom: 8px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-behavior: smooth;
    scroll-snap-type: inline mandatory;
    scrollbar-width: none;
  }
  .home-recent__track::-webkit-scrollbar {
    display: none;
  }
  .home-recent__item {
    position: relative;
    min-width: 0;
    scroll-snap-align: start;
  }
  .home-recent__item .product-card {
    height: 100%;
    border-radius: 8px;
  }
  .home-recent__date-mark {
    position: absolute;
    z-index: 2;
    top: 14px;
    right: 14px;
    padding: 7px 9px;
    border: 1px solid rgb(255 122 47 / 0.52);
    border-radius: 4px;
    background: rgb(18 18 16 / 0.84);
    color: var(--copper);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1;
    backdrop-filter: blur(8px);
  }

  /* ---- Closing ---- */
  .home-closing {
    padding-block: var(--section);
    background: var(--copper);
    color: var(--on-accent);
  }
  .home-closing .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
  }
  .home-closing p {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 1rem + 3vw, 3.6rem);
    line-height: 1.05;
  }

  @media (max-width: 980px) {
    .home-collections__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .home-faq__layout {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .home-faq__heading {
      position: static;
    }
    .home-testimonials__layout {
      grid-template-columns: 1fr;
      gap: 42px;
    }
    .home-testimonials__video {
      position: relative;
      top: auto;
      grid-row: 2;
    }
    .home-testimonials__video video,
    .home-testimonials__poster,
    .home-testimonials__poster img {
      aspect-ratio: 16 / 9;
    }
    .home-testimonials__stage {
      grid-row: 1;
      grid-template-rows: auto auto 360px;
      height: auto;
      max-height: none;
    }
    .home-bestsellers__track {
      grid-auto-columns: calc((100% - 20px) / 2);
      gap: 20px;
    }
    .home-why__layout {
      grid-template-columns: 1fr;
      gap: 46px;
    }
    .home-why__intro {
      position: static;
    }
    .home-why__intro h2 {
      max-width: 12ch;
    }
    .home-custom__layout {
      grid-template-columns: 1fr;
    }
    .home-custom__copy h2 {
      max-width: 12ch;
    }
    .home-custom__visual,
    .home-custom__visual img {
      min-height: 460px;
    }
    .home-recent__track {
      grid-auto-columns: calc((100% - 20px) / 2);
      gap: 20px;
    }
  }

  @media (max-width: 560px) {
    .home-hero {
      align-items: center;
      text-align: left;
    }
    .home-collections__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .home-tile__caption {
      grid-template-columns: 1fr auto;
      gap: 8px;
      padding: 42px 12px 12px;
    }
    .home-tile__index {
      display: none;
    }
    .home-tile__title {
      font-size: 1rem;
    }
    .testimonial-card {
      gap: 18px;
      padding: 24px 0 4px;
    }
    .testimonial-card blockquote {
      font-size: var(--quote-fit-size, clamp(1.45rem, 1.1rem + 1.5vw, 1.8rem));
    }
    .testimonial-card blockquote::before {
      height: 24px;
      margin-bottom: 6px;
      font-size: 3.25rem;
    }
    .home-testimonials__stage {
      grid-template-rows: auto auto 330px;
      height: auto;
      max-height: none;
    }
    .home-testimonials__navigation {
      margin: 24px 0 20px;
      padding: 0;
    }
    .home-testimonials__heading h2 {
      font-size: clamp(2.65rem, 12vw, 3.35rem);
    }
    .home-testimonials__intro {
      margin-top: 14px;
      font-size: 0.92rem;
      line-height: 1.55;
    }
    .home-bestsellers .section-head {
      align-items: start;
      margin-bottom: 28px;
    }
    .home-bestsellers__actions {
      width: 100%;
      justify-content: space-between;
    }
    .home-bestsellers__track {
      grid-auto-columns: 78%;
      gap: 14px;
    }
    .home-why__benefit {
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 14px;
      padding: 22px 0;
    }
    .home-faq__item summary {
      grid-template-columns: minmax(0, 1fr) 28px;
      gap: 14px;
      min-height: 68px;
    }
    .home-faq__number {
      display: none;
    }
    .home-faq__answer {
      padding: 0 42px 22px 0;
    }
    .home-why__number {
      display: none;
    }
    .home-custom__steps {
      grid-template-columns: 1fr;
    }
    .home-custom__steps li,
    .home-custom__steps li + li {
      grid-template-columns: 28px 1fr;
      gap: 10px;
      padding: 14px 0;
      border-left: 0;
    }
    .home-custom__steps li + li {
      border-top: 1px solid rgb(255 255 255 / 0.14);
    }
    .home-custom__visual,
    .home-custom__visual img {
      min-height: 380px;
    }
    .home-custom__visual-label {
      right: 16px;
      bottom: 16px;
      left: 16px;
    }
    .home-recent__head {
      align-items: start;
    }
    .home-recent__actions {
      width: 100%;
      justify-content: space-between;
    }
    .home-recent__track {
      grid-auto-columns: 78%;
      gap: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.home.name",
  "settings": [
    { "type": "header", "content": "t:sections.home.hero" },
    { "type": "image_picker", "id": "image", "label": "t:labels.hero_image" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Art, Cut In Metal." },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:labels.text",
      "default": "Architectural wall pieces, precision-cut in steel and made to fit your space."
    },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Shop wall art" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" },
    { "type": "text", "id": "button2_label", "label": "t:labels.button_label", "default": "Create something custom" },
    { "type": "url", "id": "button2_link", "label": "t:labels.button_link" },

    { "type": "header", "content": "Testimonials" },
    {
      "type": "text",
      "id": "testimonial_heading",
      "label": "Heading",
      "default": "From Our Community."
    },
    {
      "type": "textarea",
      "id": "testimonial_intro",
      "label": "Introduction",
      "default": "Here's what our buyers had to say about MetaliQ Art."
    },
    { "type": "video", "id": "testimonial_video", "label": "Testimonial video" },
    { "type": "image_picker", "id": "testimonial_poster", "label": "Video placeholder image" },

    { "type": "header", "content": "t:sections.home.featured" },
    { "type": "collection", "id": "featured_collection", "label": "t:labels.featured_collection" },
    {
      "type": "text",
      "id": "featured_heading",
      "label": "t:labels.featured_heading",
      "default": "Best sellers"
    },

    { "type": "header", "content": "Why MetaliQ" },
    {
      "type": "text",
      "id": "why_heading",
      "label": "Heading",
      "default": "Why choose MetaliQ"
    },
    {
      "type": "textarea",
      "id": "why_intro",
      "label": "Introduction",
      "default": "Considered design, precise fabrication, and practical details that make every piece easier to choose, install, and live with."
    },
    { "type": "select", "id": "why_icon_1", "label": "Precision icon", "options": [{ "value": "precision", "label": "Precision" }, { "value": "cut", "label": "Cut" }], "default": "precision" },
    { "type": "select", "id": "why_icon_2", "label": "Durability icon", "options": [{ "value": "shield", "label": "Shield" }, { "value": "layers", "label": "Layers" }], "default": "shield" },
    { "type": "select", "id": "why_icon_3", "label": "Sizing icon", "options": [{ "value": "layers", "label": "Layers" }, { "value": "precision", "label": "Precision" }], "default": "layers" },
    { "type": "select", "id": "why_icon_4", "label": "Installation icon", "options": [{ "value": "cut", "label": "Cut" }, { "value": "package", "label": "Package" }], "default": "cut" },
    { "type": "select", "id": "why_icon_5", "label": "Delivery icon", "options": [{ "value": "package", "label": "Package" }, { "value": "truck", "label": "Truck" }], "default": "package" },

    { "type": "header", "content": "Custom design CTA" },
    { "type": "image_picker", "id": "custom_image", "label": "Artwork image" },
    { "type": "text", "id": "custom_heading", "label": "Heading", "default": "Your idea. Made in metal." },
    {
      "type": "textarea",
      "id": "custom_body",
      "label": "Introduction",
      "default": "Bring us a name, reference, sketch, or empty wall. We will shape it into a considered metal artwork made for your dimensions."
    },
    { "type": "text", "id": "custom_button", "label": "Button label", "default": "Start a custom design" },
    { "type": "url", "id": "custom_link", "label": "Button link" },

    { "type": "header", "content": "Recently added" },
    { "type": "collection", "id": "recent_collection", "label": "Collection" },
    { "type": "text", "id": "recent_heading", "label": "Heading", "default": "Recently added" },

    { "type": "header", "content": "t:sections.home.closing" },
    {
      "type": "text",
      "id": "closing",
      "label": "t:labels.text",
      "default": "Made to order. Sized for your space."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:sections.home.category",
      "limit": 12,
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:labels.collection" },
        { "type": "text", "id": "fallback_title", "label": "t:labels.fallback_title", "default": "Collection" },
        { "type": "paragraph", "content": "Hero products are selected automatically from Best Sellers and Recently Added." }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.home.name",
      "blocks": [
        { "type": "category", "settings": { "fallback_title": "Calligraphy" } },
        { "type": "category", "settings": { "fallback_title": "Islamic" } },
        { "type": "category", "settings": { "fallback_title": "Clocks" } },
        { "type": "category", "settings": { "fallback_title": "Anime & Comics" } },
        { "type": "category", "settings": { "fallback_title": "Floral" } },
        { "type": "category", "settings": { "fallback_title": "Portraits" } }
      ]
    }
  ]
}
{% endschema %}
