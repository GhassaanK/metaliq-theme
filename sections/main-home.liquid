{% liquid
  assign hero_heading = section.settings.heading
  if hero_heading == blank
    assign hero_heading = 'home.hero_heading' | t
  endif
  assign hero_body = section.settings.body
  if hero_body == blank
    assign hero_body = 'home.hero_body' | t
  endif
  assign hero_label_1 = section.settings.button_label
  if hero_label_1 == blank
    assign hero_label_1 = 'home.hero_cta' | t
  endif
  assign hero_label_2 = section.settings.button2_label
  if hero_label_2 == blank
    assign hero_label_2 = 'home.hero_cta2' | t
  endif
  assign hero_link_1 = section.settings.button_link | default: routes.all_products_collection_url
  assign hero_link_2 = section.settings.button2_link | default: settings.quote_page.url | default: routes.root_url
  assign intro_heading = section.settings.intro_heading
  if intro_heading == blank
    assign intro_heading = 'home.intro_heading' | t
  endif
  assign intro_body = section.settings.intro_body
  if intro_body == blank
    assign intro_body = 'home.intro_body' | t
  endif
  assign featured_heading = section.settings.featured_heading
  if featured_heading == blank
    assign featured_heading = 'home.featured_heading' | t
  endif
  assign featured = section.settings.featured_collection | default: collections.all
%}

<section class="home-hero">
  <div class="container home-hero__inner">
    <div class="home-hero__copy">
      <h1 class="home-hero__title">{{ hero_heading }}</h1>
    </div>
    <div class="home-hero__artworks" aria-label="Featured artwork">
      {%- assign hero_card_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          {%- liquid
            assign hero_product = block.settings.product
            if hero_product == blank
              assign hero_product = featured.products[hero_card_index]
            endif
            assign hero_card_url = hero_product.url | default: routes.all_products_collection_url
            assign hero_card_title = hero_product.title | default: block.settings.fallback_title | default: 'Explore artwork'
            assign hero_card_delta = hero_card_index | minus: 2
            assign hero_card_offset = hero_card_delta | times: 8
            assign hero_card_rotation = hero_card_delta | times: 3
          -%}
          <a class="home-hero-card" href="{{ hero_card_url }}" aria-label="{{ hero_card_title | escape }}" style="--fan-offset: {{ hero_card_offset }}px; --fan-rotation: {{ hero_card_rotation }}deg" {{ block.shopify_attributes }}>
            <span class="home-hero-card__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'eager', widths: '360, 540, 720, 900', sizes: '(max-width: 760px) 44vw, 220px', alt: hero_card_title }}
              {%- else -%}
                {%- case hero_card_index -%}
                  {%- when 1 -%}
                    <img src="{{ 'hero-art-botanical.jpg' | asset_url }}" width="733" height="1100" alt="{{ hero_card_title | escape }}" loading="eager">
                  {%- when 2 -%}
                    <img src="{{ 'hero-art-anime-silhouette.jpg' | asset_url }}" width="733" height="1100" alt="{{ hero_card_title | escape }}" loading="eager">
                  {%- when 3 -%}
                    <img src="{{ 'hero-art-anime-portrait.jpg' | asset_url }}" width="1100" height="1100" alt="{{ hero_card_title | escape }}" loading="eager">
                  {%- when 4 -%}
                    <img src="{{ 'metaliq-architectural-hero.jpg' | asset_url }}" width="1680" height="945" alt="{{ hero_card_title | escape }}" loading="eager">
                  {%- else -%}
                    <img src="{{ 'hero-art-western.jpg' | asset_url }}" width="1100" height="733" alt="{{ hero_card_title | escape }}" loading="eager">
                {%- endcase -%}
              {%- endif -%}
            </span>
            <span class="home-hero-card__info">
              <strong>{{ hero_card_title }}</strong>
              {%- if hero_product != blank -%}<span>{{ hero_product.price | money }}</span>{%- endif -%}
            </span>
          </a>
          {%- assign hero_card_index = hero_card_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="home-hero__footer">
      <p class="home-hero__body">{{ hero_body }}</p>
      <div class="home-hero__actions">
        <a class="button" href="{{ hero_link_1 }}">{{ hero_label_1 }}</a>
        {%- if hero_label_2 != blank -%}
          <a class="home-hero__text-link" href="{{ hero_link_2 }}">{{ hero_label_2 }} <span aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<section class="home-collections section">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">{{ 'home.collections_index' | t }}</p>
        <h2>{{ 'home.collections_heading' | t }}</h2>
      </div>
      <a class="link" href="{{ routes.collections_url }}">{{ 'collections.view_all' | t }}</a>
    </div>

    <div class="home-collections__grid">
      {%- for collection_item in collections -%}
        {%- liquid
          assign tile_image = collection_item.featured_image
          if tile_image == blank and collection_item.products.first != blank
            assign tile_image = collection_item.products.first.featured_image
          endif
          assign placeholder_index = forloop.index0 | modulo: 4
        -%}
        <a class="home-tile reveal" href="{{ collection_item.url }}">
          <span class="home-tile__media media">
            {%- if tile_image != blank -%}
              {{
                tile_image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 720, 1000',
                  sizes: '(min-width: 1100px) 25vw, (min-width: 620px) 50vw, 100vw',
                  alt: collection_item.title
              }}
            {%- else -%}
              {%- case placeholder_index -%}
                {%- when 1 -%}
                  <img src="{{ 'hero-art-botanical.jpg' | asset_url }}" width="733" height="1100" alt="" loading="lazy">
                {%- when 2 -%}
                  <img src="{{ 'hero-art-anime-silhouette.jpg' | asset_url }}" width="733" height="1100" alt="" loading="lazy">
                {%- when 3 -%}
                  <img src="{{ 'hero-art-anime-portrait.jpg' | asset_url }}" width="1100" height="1100" alt="" loading="lazy">
                {%- else -%}
                  <img src="{{ 'hero-art-western.jpg' | asset_url }}" width="1100" height="733" alt="" loading="lazy">
              {%- endcase -%}
            {%- endif -%}
          </span>
          <span class="home-tile__caption">
            <span class="home-tile__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="home-tile__title">{{ collection_item.title }}</span>
            <span class="home-tile__arrow" aria-hidden="true">&#8599;</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- capture testimonial_names -%}Ayesha R.|Hamza K.|Sarah M.|Bilal A.|Mariam S.|Usman T.|Noor F.|Daniyal H.|Zara I.|Farhan Q.{%- endcapture -%}
{%- capture testimonial_locations -%}Karachi|Lahore|Islamabad|Rawalpindi|Faisalabad|Karachi|Lahore|Islamabad|Multan|Peshawar{%- endcapture -%}
{%- capture testimonial_quotes -%}The piece has real presence without overpowering the room. The finish and detail are even better in person.|Ordering the right size was straightforward, and the installation guidance made mounting it simple.|It arrived carefully packed and looked exactly right above our console. The metalwork feels substantial and refined.|The custom sizing was accurate to the measurements we shared. It fits the wall as though it was designed with the room.|I was unsure how the black finish would sit against a warm wall, but the contrast is excellent.|The edges are clean, the coating is consistent, and the piece casts beautiful shadows throughout the day.|We wanted something personal without making the space feel busy. This struck the right balance.|The team kept us informed from confirmation through dispatch. Everything arrived secure and ready to install.|It feels more like an architectural object than wall decor. That is exactly what we were looking for.|The scale recommendation was useful and saved us from ordering too small. It anchors the entire room now.{%- endcapture -%}
{%- assign testimonial_name_list = testimonial_names | split: '|' -%}
{%- assign testimonial_location_list = testimonial_locations | split: '|' -%}
{%- assign testimonial_quote_list = testimonial_quotes | split: '|' -%}

<section class="home-testimonials section">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">02 / Customer stories</p>
        <h2>{{ section.settings.testimonial_heading | default: 'Made for their spaces' }}</h2>
      </div>
      <p class="home-testimonials__intro">{{ section.settings.testimonial_intro | default: 'Experiences with the artwork, the process, and the finished installation.' }}</p>
    </div>

    <div class="home-testimonials__layout">
      <div class="home-testimonials__cards" aria-label="Customer testimonials">
        {%- for quote in testimonial_quote_list -%}
          <article class="testimonial-card reveal">
            <div class="testimonial-card__rating" aria-label="5 out of 5 stars">
              <span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            </div>
            <blockquote>{{ quote }}</blockquote>
            <footer>
              <span class="testimonial-card__avatar" aria-hidden="true">{{ testimonial_name_list[forloop.index0] | slice: 0 }}</span>
              <span>
                <strong>{{ testimonial_name_list[forloop.index0] }}</strong>
                <small>{{ testimonial_location_list[forloop.index0] }}</small>
              </span>
            </footer>
          </article>
        {%- endfor -%}
      </div>

      <div class="home-testimonials__video reveal">
        {%- if section.settings.testimonial_video != blank -%}
          {{
            section.settings.testimonial_video
            | video_tag:
              controls: true,
              image_size: '1000x',
              preload: 'metadata'
          }}
        {%- else -%}
          <div class="home-testimonials__poster">
            {%- if section.settings.testimonial_poster != blank -%}
              {{ section.settings.testimonial_poster | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 980px) 42vw, 100vw', alt: '' }}
            {%- else -%}
              <img src="{{ 'hero-art-western.jpg' | asset_url }}" width="1100" height="733" alt="" loading="lazy">
            {%- endif -%}
            <span class="home-testimonials__play" aria-hidden="true">{% render 'icon', name: 'play' %}</span>
            <span class="home-testimonials__video-label">Customer stories &amp; installation</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<section class="home-statement section container reveal">
  <p class="eyebrow">{{ 'home.intro_eyebrow' | t }}</p>
  <h2>{{ intro_heading }}</h2>
  <p class="lede">{{ intro_body }}</p>
</section>

{%- if featured.products_count > 0 -%}
  <section class="home-featured section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">{{ 'home.featured_index' | t }}</p>
          <h2>{{ featured_heading }}</h2>
        </div>
        <a class="link" href="{{ featured.url }}">{{ 'home.featured_link' | t }}</a>
      </div>

      <div class="product-grid reveal">
        {%- for product in featured.products limit: 4 -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

<section class="home-process section container">
  <div class="home-process__visual reveal">
    {%- if section.settings.story_image -%}
      <div class="media">
        {{
          section.settings.story_image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '500, 800, 1100, 1400',
            sizes: '(min-width: 900px) 45vw, 100vw',
            alt: section.settings.story_image.alt | default: 'home.process_alt' | t
        }}
      </div>
    {%- else -%}
      <div class="media media-fallback home-process__art">
        {% render 'engraving', seed: 8 %}
      </div>
    {%- endif -%}
  </div>

  <div class="home-process__copy reveal">
    <p class="eyebrow">{{ 'home.process_index' | t }}</p>
    <blockquote class="home-process__quote">
      {{- section.settings.quote | default: 'Precision gives the piece its form. The hand finish gives it presence.' -}}
    </blockquote>
    <ol class="home-process__steps">
      {%- for i in (1..3) -%}
        {%- assign title_key = 'step_' | append: i | append: '_title' -%}
        {%- assign body_key = 'step_' | append: i | append: '_body' -%}
        <li>
          <span class="home-process__num">0{{ i }}</span>
          <div>
            <h3>{{ section.settings[title_key] }}</h3>
            <p>{{ section.settings[body_key] }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

<section class="home-closing">
  <div class="container">
    <p>{{ section.settings.closing | default: 'Made to order. Sized for your space.' }}</p>
    <a class="link-rule" href="{{ routes.all_products_collection_url }}">
      {{ 'home.closing_cta' | t }}
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

{% stylesheet %}
  /* ---- Hero: centered headline and interactive artwork fan ---- */
  .home-hero {
    position: relative;
    isolation: isolate;
    background:
      linear-gradient(112deg, #11110f 0%, #1c1c1a 46%, #242420 72%, #161614 100%);
    color: #f7f5f0;
    overflow: hidden;
  }
  .home-hero::before,
  .home-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .home-hero::before {
    background-image:
      linear-gradient(118deg, transparent 0 22%, rgb(255 255 255 / 0.055) 22.05% 22.14%, transparent 22.2%),
      linear-gradient(64deg, transparent 0 68%, rgb(255 255 255 / 0.045) 68.05% 68.14%, transparent 68.2%),
      linear-gradient(146deg, transparent 0 48%, rgb(166 93 53 / 0.11) 48.05% 48.13%, transparent 48.2%),
      linear-gradient(28deg, transparent 0 78%, rgb(255 255 255 / 0.035) 78.05% 78.14%, transparent 78.2%);
  }
  .home-hero::after {
    background-image:
      repeating-linear-gradient(90deg, transparent 0 119px, rgb(255 255 255 / 0.022) 119px 120px),
      repeating-linear-gradient(0deg, transparent 0 119px, rgb(255 255 255 / 0.018) 119px 120px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
  }
  .home-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: clamp(24px, 4vh, 42px);
    min-height: clamp(620px, calc(100svh - var(--header-height) - var(--announce-height) - 24px), 820px);
    padding-block: clamp(48px, 7vh, 76px);
  }
  .home-hero__copy {
    display: contents;
  }
  .home-hero__title {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(3rem, 5.5vw, 5.4rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.01em;
    text-align: center;
    text-wrap: balance;
  }
  .home-hero__artworks {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 880px);
    min-height: 250px;
    padding-inline: 44px;
    isolation: isolate;
  }
  .home-hero-card {
    position: relative;
    flex: 0 1 220px;
    aspect-ratio: 4 / 5;
    margin-inline: -14px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: var(--radius-lg);
    background: var(--charcoal-deep);
    box-shadow: 0 18px 34px rgb(0 0 0 / 0.28);
    transform: translateY(var(--fan-offset)) rotate(var(--fan-rotation));
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .home-hero-card:nth-child(2),
  .home-hero-card:nth-child(3) { z-index: 2; }
  .home-hero-card:hover,
  .home-hero-card:focus-visible {
    z-index: 5;
    box-shadow: 0 24px 48px rgb(0 0 0 / 0.42);
    transform: translateY(-18px) rotate(0deg) scale(1.04);
  }
  .home-hero-card__media,
  .home-hero-card__media img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .home-hero-card__media img { object-fit: cover; }
  .home-hero-card__info {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 2px;
    padding: 42px 14px 14px;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.9));
    color: #fff;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .home-hero-card:hover .home-hero-card__info,
  .home-hero-card:focus-visible .home-hero-card__info {
    opacity: 1;
    transform: none;
  }
  .home-hero-card__info strong {
    font-size: 0.78rem;
    line-height: 1.25;
  }
  .home-hero-card__info span {
    color: rgb(255 255 255 / 0.72);
    font-size: 0.7rem;
  }
  .home-hero__footer {
    display: grid;
    justify-items: center;
    gap: 18px;
    text-align: center;
  }
  .home-hero__body {
    max-width: 44rem;
    color: rgb(247 245 240 / 0.76);
    font-size: 1rem;
    line-height: 1.6;
  }
  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 8px;
  }
  .home-hero__actions .button {
    min-width: 154px;
    background: #f7f5f0;
    color: #171715;
  }
  .home-hero__actions .button:hover { background: #fff; }
  .home-hero__text-link {
    padding-block: 8px;
    border-bottom: 1px solid rgb(247 245 240 / 0.5);
    color: #f7f5f0;
    font-size: 0.78rem;
    font-weight: 500;
  }
  .home-hero__text-link span { margin-left: 12px; }

  @media (max-width: 760px) {
    .home-hero::before { opacity: 0.62; }
    .home-hero::after {
      opacity: 0.55;
      background-size: 84px 84px;
    }
    .home-hero__inner {
      min-height: 0;
      padding: clamp(48px, 12vw, 72px) 0;
    }
    .home-hero__title { font-size: clamp(3rem, 15vw, 4.2rem); }
    .home-hero__artworks {
      justify-content: flex-start;
      width: calc(100% + (var(--page-margin) * 2));
      min-height: 230px;
      margin-inline: calc(var(--page-margin) * -1);
      padding: 20px var(--page-margin) 30px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
    }
    .home-hero-card {
      flex: 0 0 min(52vw, 210px);
      margin-inline: 0;
      scroll-snap-align: center;
      transform: none;
    }
    .home-hero-card + .home-hero-card { margin-left: 12px; }
    .home-hero-card__info { opacity: 1; transform: none; }
    .home-hero__actions { flex-direction: column; gap: 12px; }
  }

  /* ---- Statement ---- */
  .home-statement {
    display: grid;
    gap: var(--sp-5);
    max-width: 62rem;
  }
  .home-statement h2 {
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.8rem);
    line-height: 1.06;
  }

  /* ---- Collections ---- */
  .home-collections {
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }
  .home-collections__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .home-tile {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-2);
  }
  .home-tile__media {
    display: block;
    aspect-ratio: 4 / 5;
  }
  .home-tile__media img,
  .home-tile__media .media-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  .home-tile:hover .home-tile__media img,
  .home-tile:hover .home-tile__media .media-fallback {
    transform: scale(1.04);
  }
  .home-tile__caption {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--sp-3);
    padding: 64px var(--sp-4) var(--sp-4);
    background: linear-gradient(transparent, rgb(0 0 0 / 0.82));
    color: #fff;
  }
  .home-tile__index {
    color: rgb(255 255 255 / 0.62);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }
  .home-tile__title {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.65rem);
    line-height: 1.1;
  }
  .home-tile__arrow {
    color: rgb(255 255 255 / 0.72);
    transition: transform 0.25s var(--ease);
  }
  .home-tile:hover .home-tile__arrow {
    transform: translate(3px, -3px);
    color: var(--copper);
  }

  /* ---- Testimonials ---- */
  .home-testimonials {
    border-bottom: 1px solid var(--line);
    background: var(--background);
  }
  .home-testimonials__intro {
    max-width: 38ch;
    color: var(--muted);
    font-size: var(--fs-label);
  }
  .home-testimonials__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(340px, 0.85fr);
    align-items: start;
    gap: clamp(32px, 5vw, 72px);
  }
  .home-testimonials__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    max-height: 670px;
    padding-right: 8px;
    overflow-y: auto;
    scrollbar-color: var(--line) transparent;
    scrollbar-width: thin;
  }
  .testimonial-card {
    display: grid;
    align-content: space-between;
    gap: 24px;
    min-height: 210px;
    padding: 24px;
    border: 1px solid #c9c2b8;
    border-radius: 8px;
    background: #e8e4dd;
    color: #171715;
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.16);
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .testimonial-card:hover {
    border-color: color-mix(in srgb, var(--copper) 62%, #c9c2b8);
    transform: translateY(-3px);
  }
  .testimonial-card__rating {
    color: var(--copper);
    font-size: 0.75rem;
    letter-spacing: 0;
  }
  .testimonial-card blockquote {
    padding: 0;
    border: 0;
    color: #171715;
    font-family: var(--serif);
    font-size: clamp(1.05rem, 0.96rem + 0.3vw, 1.25rem);
    font-style: normal;
    line-height: 1.45;
  }
  .testimonial-card footer {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .testimonial-card footer > span:last-child {
    display: grid;
  }
  .testimonial-card footer strong,
  .testimonial-card footer small {
    font-family: var(--sans);
    font-size: 0.72rem;
  }
  .testimonial-card footer small {
    color: #68645e;
  }
  .testimonial-card__avatar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    border-radius: 50%;
    background: var(--charcoal);
    color: var(--on-dark);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .home-testimonials__video {
    position: sticky;
    top: calc(var(--header-height) + 24px);
    overflow: hidden;
    border-radius: 8px;
    background: var(--charcoal-deep);
  }
  .home-testimonials__video video,
  .home-testimonials__poster,
  .home-testimonials__poster img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
  }
  .home-testimonials__video video,
  .home-testimonials__poster img {
    object-fit: cover;
  }
  .home-testimonials__poster {
    position: relative;
  }
  .home-testimonials__poster::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 52%, rgb(0 0 0 / 0.72));
  }
  .home-testimonials__play {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
    background: rgb(17 17 15 / 0.64);
    color: #fff;
    transform: translate(-50%, -50%);
    backdrop-filter: blur(8px);
  }
  .home-testimonials__play svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }
  .home-testimonials__video-label {
    position: absolute;
    z-index: 1;
    right: 24px;
    bottom: 22px;
    left: 24px;
    color: #fff;
    font-family: var(--serif);
    font-size: 1.35rem;
  }

  /* ---- Featured ---- */
  .home-featured {
    background: var(--charcoal);
    color: var(--on-dark);
  }
  .home-featured .section-head {
    border-color: rgb(255 255 255 / 0.16);
  }
  .home-featured .eyebrow {
    color: var(--copper-light);
  }
  .home-featured .link {
    color: var(--on-dark);
  }
  .home-featured .media-fallback {
    background: color-mix(in srgb, var(--charcoal) 88%, #000);
    color: color-mix(in srgb, var(--copper-light) 70%, transparent);
  }
  .home-featured .product-card__title a {
    color: var(--on-dark);
  }
  .home-featured .product-card__kicker {
    color: var(--on-dark-muted);
  }
  .home-featured .price {
    color: var(--copper-light);
  }
  .home-featured .price s {
    color: var(--on-dark-muted);
  }

  /* ---- Process ---- */
  .home-process {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
  }
  .home-process__visual .media {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
  }
  .home-process__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .home-process__art {
    display: grid;
    place-items: center;
  }
  .home-process__art .engraving {
    width: 62%;
  }
  .home-process__quote {
    margin: var(--sp-4) 0 var(--sp-7);
    padding: 0;
    border: 0;
    font-family: var(--serif);
    font-size: clamp(1.6rem, 1rem + 2.4vw, 3rem);
    font-style: normal;
    line-height: 1.14;
  }
  .home-process__quote::before {
    content: '\201C';
  }
  .home-process__quote::after {
    content: '\201D';
  }
  .home-process__steps {
    display: grid;
    gap: 0;
  }
  .home-process__steps li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: var(--sp-4);
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--line);
  }
  .home-process__num {
    color: var(--copper);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }
  .home-process__steps h3 {
    margin-bottom: 4px;
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .home-process__steps p {
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  /* ---- Closing ---- */
  .home-closing {
    padding-block: var(--section);
    background: var(--copper);
    color: var(--on-accent);
  }
  .home-closing .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
  }
  .home-closing p {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 1rem + 3vw, 3.6rem);
    line-height: 1.05;
  }

  @media (max-width: 980px) {
    .home-collections__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .home-process {
      grid-template-columns: 1fr;
      gap: var(--sp-7);
    }
    .home-testimonials__layout {
      grid-template-columns: 1fr;
    }
    .home-testimonials__video {
      position: relative;
      top: auto;
      grid-row: 1;
    }
    .home-testimonials__video video,
    .home-testimonials__poster,
    .home-testimonials__poster img {
      aspect-ratio: 16 / 9;
    }
    .home-testimonials__cards {
      max-height: none;
      padding-right: 0;
      overflow: visible;
    }
  }

  @media (max-width: 560px) {
    .home-hero {
      align-items: center;
      text-align: left;
    }
    .home-collections__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .home-tile__caption {
      grid-template-columns: 1fr auto;
      gap: 8px;
      padding: 42px 12px 12px;
    }
    .home-tile__index {
      display: none;
    }
    .home-tile__title {
      font-size: 1rem;
    }
    .home-testimonials__cards {
      grid-template-columns: 1fr;
    }
    .testimonial-card {
      min-height: 0;
      padding: 20px;
    }
  }
{% endstylesheet %}

