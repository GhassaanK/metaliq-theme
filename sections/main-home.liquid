  /* ---- FAQs ---- */
  .home-faq {
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }
  .home-faq__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    align-items: start;
    gap: clamp(54px, 9vw, 140px);
