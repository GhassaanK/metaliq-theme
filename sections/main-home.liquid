{% liquid
  assign hero_heading = section.settings.heading
  if hero_heading == blank
    assign hero_heading = 'home.hero_heading' | t
  endif
  assign hero_heading_accent = hero_heading | split: ',' | first
  assign hero_heading_rest = hero_heading | remove_first: hero_heading_accent
  assign hero_body = section.settings.body
  if hero_body == blank
    assign hero_body = 'home.hero_body' | t
  endif
  assign hero_label_1 = section.settings.button_label
  if hero_label_1 == blank
    assign hero_label_1 = 'home.hero_cta' | t
  endif
  assign hero_label_2 = section.settings.button2_label
  if hero_label_2 == blank
    assign hero_label_2 = 'home.hero_cta2' | t
  endif
  assign hero_link_1 = section.settings.button_link | default: routes.all_products_collection_url
  assign hero_link_2 = section.settings.button2_link | default: settings.quote_page.url | default: routes.root_url
  assign featured_heading = section.settings.featured_heading
  if featured_heading == blank
    assign featured_heading = 'home.featured_heading' | t
  endif
  assign featured = section.settings.featured_collection
  if featured == blank
    assign featured = collections['best-sellers']
  endif
  if featured == blank
    assign featured = collections.all
  endif
  assign why_heading = section.settings.why_heading
  if why_heading == blank
    assign why_heading = 'home.why_heading' | t
  endif
  assign why_intro = section.settings.why_intro
  if why_intro == blank
    assign why_intro = 'home.why_intro' | t
  endif
  assign custom_heading = section.settings.custom_heading
  if custom_heading == blank
    assign custom_heading = 'home.custom_heading' | t
  endif
  assign custom_body = section.settings.custom_body
  if custom_body == blank
    assign custom_body = 'home.custom_body' | t
  endif
  assign custom_button = section.settings.custom_button
  if custom_button == blank
    assign custom_button = 'home.custom_cta' | t
  endif
  assign custom_image_alt = section.settings.custom_image.alt
  if custom_image_alt == blank
    assign custom_image_alt = 'home.custom_image_alt' | t
  endif
  assign custom_link = section.settings.custom_link
  if custom_link == blank
    assign custom_link = settings.quote_page.url
  endif
  if custom_link == blank
    assign custom_link = routes.root_url
  endif
  assign recent_collection = section.settings.recent_collection
  if recent_collection == blank
    assign recent_collection = collections['new-arrivals']
  endif
  if recent_collection == blank
    assign recent_collection = collections.all
  endif
  assign recent_heading = section.settings.recent_heading
  if recent_heading == blank
    assign recent_heading = 'home.recent_heading' | t
  endif
  assign featured_product_handles = featured.products | map: 'handle'
  assign recent_product_handles = recent_collection.products | map: 'handle'
  assign all_product_handles = collections.all.products | map: 'handle'
  assign hero_product_handles = featured_product_handles | concat: recent_product_handles | concat: all_product_handles | uniq
%}

<section class="home-hero">
  <div class="container home-hero__inner">
    <div class="home-hero__copy">
      <h1 class="home-hero__title"><span>{{ hero_heading_accent }}</span>{{ hero_heading_rest }}</h1>
    </div>
    <div class="home-hero__artworks" aria-label="{{ 'home.hero_products_label' | t }}" data-hero-reel>
      <div class="home-hero__track">
        {%- for reel_pass in (1..2) -%}
          <div class="home-hero__group"{% if reel_pass == 2 %} aria-hidden="true"{% endif %}>
            {%- for hero_card_index in (0..6) -%}
                {%- liquid
                  assign hero_block = section.blocks[hero_card_index]
                  assign hero_product_handle = hero_product_handles[hero_card_index]
                  assign hero_product = all_products[hero_product_handle]
                  if hero_product == blank
                    continue
                  endif
                  if hero_product.featured_image == blank
                    continue
                  endif
                  assign hero_card_url = hero_product.url
                  assign hero_card_title = hero_product.title
                -%}
                <a class="home-hero-card" href="{{ hero_card_url }}" aria-label="{{ hero_card_title | escape }}"{% if reel_pass == 2 %} tabindex="-1"{% endif %}{% if reel_pass == 1 %}{% if hero_block != blank %} {{ hero_block.shopify_attributes }}{% endif %}{% endif %}>
                  <span class="home-hero-card__media">
                    {{
                      hero_product.featured_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'eager',
                        widths: '360, 540, 720, 900',
                        sizes: '(max-width: 760px) 46vw, 200px',
                        alt: hero_product.featured_image.alt | default: hero_card_title
                    }}
                  </span>
                  <span class="home-hero-card__info">
                    <strong>{{ hero_card_title }}</strong>
                    <span>{{ hero_product.price | money }}</span>
                  </span>
                </a>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
    <div class="home-hero__footer">
      <p class="home-hero__body">{{ hero_body }}</p>
      <div class="home-hero__actions">
        <a class="button" href="{{ hero_link_1 }}">{{ hero_label_1 }}</a>
        {%- if hero_label_2 != blank -%}
          <a class="home-hero__text-link" href="{{ hero_link_2 }}">{{ hero_label_2 }} <span aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<section class="home-collections section">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">{{ 'home.collections_index' | t }}</p>
        <h2>{{ 'home.collections_heading' | t }}</h2>
      </div>
      <a class="link" href="{{ routes.collections_url }}">{{ 'collections.view_all' | t }}</a>
    </div>

    <div class="home-collections__grid">
      {%- for collection_item in collections -%}
        {%- if collection_item.handle == 'best-sellers' -%}
          {%- continue -%}
        {%- endif -%}
        {%- if collection_item.handle == recent_collection.handle -%}
          {%- continue -%}
        {%- endif -%}
        {%- liquid
          assign tile_image = collection_item.featured_image
          if tile_image == blank and collection_item.products.first != blank
            assign tile_image = collection_item.products.first.featured_image
          endif
          assign placeholder_index = forloop.index0 | modulo: 4
        -%}
        <a class="home-tile reveal" href="{{ collection_item.url }}">
          <span class="home-tile__media media">
            {%- if tile_image != blank -%}
              {{
                tile_image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 720, 1000',
                  sizes: '(min-width: 1100px) 25vw, (min-width: 620px) 50vw, 100vw',
                  alt: collection_item.title
              }}
            {%- else -%}
              {%- case placeholder_index -%}
                {%- when 1 -%}
                  <img src="{{ 'hero-art-botanical.jpg' | asset_url }}" width="733" height="1100" alt="" loading="lazy">
                {%- when 2 -%}
                  <img src="{{ 'hero-art-anime-silhouette.jpg' | asset_url }}" width="733" height="1100" alt="" loading="lazy">
                {%- when 3 -%}
                  <img src="{{ 'hero-art-anime-portrait.jpg' | asset_url }}" width="1100" height="1100" alt="" loading="lazy">
                {%- else -%}
                  <img src="{{ 'hero-art-western.jpg' | asset_url }}" width="1100" height="733" alt="" loading="lazy">
              {%- endcase -%}
            {%- endif -%}
          </span>
          <span class="home-tile__caption">
            <span class="home-tile__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="home-tile__title">{{ collection_item.title }}</span>
            <span class="home-tile__arrow" aria-hidden="true">&#8599;</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- capture testimonial_names -%}Ayesha R.|Hamza K.|Sarah M.|Bilal A.|Mariam S.|Usman T.|Noor F.|Daniyal H.|Zara I.|Farhan Q.{%- endcapture -%}
{%- capture testimonial_locations -%}Karachi|Lahore|Islamabad|Rawalpindi|Faisalabad|Karachi|Lahore|Islamabad|Multan|Peshawar{%- endcapture -%}
{%- capture testimonial_quotes -%}The piece has real presence without overpowering the room. The finish and detail are even better in person.|Ordering the right size was straightforward, and the installation guidance made mounting it simple.|It arrived carefully packed and looked exactly right above our console. The metalwork feels substantial and refined.|The custom sizing was accurate to the measurements we shared. It fits the wall as though it was designed with the room.|I was unsure how the black finish would sit against a warm wall, but the contrast is excellent.|The edges are clean, the coating is consistent, and the piece casts beautiful shadows throughout the day.|We wanted something personal without making the space feel busy. This struck the right balance.|The team kept us informed from confirmation through dispatch. Everything arrived secure and ready to install.|It feels more like an architectural object than wall decor. That is exactly what we were looking for.|The scale recommendation was useful and saved us from ordering too small. It anchors the entire room now.{%- endcapture -%}
{%- assign testimonial_name_list = testimonial_names | split: '|' -%}
{%- assign testimonial_location_list = testimonial_locations | split: '|' -%}
{%- assign testimonial_quote_list = testimonial_quotes | split: '|' -%}

<section class="home-testimonials section">
  <div class="container">
    <div class="home-testimonials__layout">
      <div class="home-testimonials__stage reveal" data-testimonial-slider>
        <div class="home-testimonials__heading">
          <p class="eyebrow">02 / Customer stories</p>
          <h2>{{ section.settings.testimonial_heading | default: 'From Our Community.' }}</h2>
          <p class="home-testimonials__intro">{{ section.settings.testimonial_intro | default: "Here's what our buyers had to say about MetaliQ Art." }}</p>
        </div>
        <div class="home-testimonials__navigation">
          <div>
            <button class="icon-button home-testimonials__button home-testimonials__button--previous" type="button" aria-label="{{ 'home.testimonials_previous' | t }}" data-testimonial-previous>
              {% render 'icon', name: 'arrow-right' %}
            </button>
            <button class="icon-button home-testimonials__button" type="button" aria-label="{{ 'home.testimonials_next' | t }}" data-testimonial-next>
              {% render 'icon', name: 'arrow-right' %}
            </button>
          </div>
          <p><span data-testimonial-current>01</span> <span>/ {{ testimonial_quote_list.size }}</span></p>
        </div>
        <div class="home-testimonials__slides" aria-label="{{ 'home.testimonials_label' | t }}">
          {%- for quote in testimonial_quote_list -%}
            <article class="testimonial-card{% if forloop.first %} is-active{% endif %}" data-testimonial-slide aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
              <div class="testimonial-card__topline">
                <div class="testimonial-card__rating" aria-label="{{ 'home.testimonials_rating' | t }}">
                  <span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                </div>
                <span class="testimonial-card__index">{{ forloop.index | prepend: '0' }} / {{ testimonial_quote_list.size }}</span>
              </div>
              <blockquote>{{ quote }}</blockquote>
              <footer>
                <span class="testimonial-card__avatar" aria-hidden="true">{{ testimonial_name_list[forloop.index0] | slice: 0 }}</span>
                <span>
                  <strong>{{ testimonial_name_list[forloop.index0] }}</strong>
                  <small>{{ testimonial_location_list[forloop.index0] }}</small>
                </span>
              </footer>
            </article>
          {%- endfor -%}
        </div>
      </div>

      <div class="home-testimonials__video reveal">
        {%- if section.settings.testimonial_video != blank -%}
          {{
            section.settings.testimonial_video
            | video_tag:
              controls: true,
              image_size: '1000x',
              preload: 'metadata'
          }}
        {%- else -%}
          <div class="home-testimonials__poster">
            {%- if section.settings.testimonial_poster != blank -%}
              {{ section.settings.testimonial_poster | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 980px) 42vw, 100vw', alt: '' }}
            {%- else -%}
              <img src="{{ 'hero-art-western.jpg' | asset_url }}" width="1100" height="733" alt="" loading="lazy">
            {%- endif -%}
            <span class="home-testimonials__play" aria-hidden="true">{% render 'icon', name: 'play' %}</span>
            <span class="home-testimonials__video-label">Customer stories &amp; installation</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- if featured.products_count > 0 -%}
  <section class="home-featured home-bestsellers section" data-product-carousel>
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">03 / Best sellers</p>
          <h2>{{ featured_heading }}</h2>
          <p class="home-bestsellers__intro">The pieces customers choose most often.</p>
        </div>
        <div class="home-bestsellers__actions">
          <a class="link" href="{{ featured.url }}">{{ 'home.featured_link' | t }}</a>
          <div class="home-bestsellers__controls" aria-label="Best seller carousel controls">
            <button class="icon-button home-bestsellers__button home-bestsellers__button--previous" type="button" aria-label="Previous products" data-carousel-previous>
              {% render 'icon', name: 'arrow-right' %}
            </button>
            <button class="icon-button home-bestsellers__button" type="button" aria-label="Next products" data-carousel-next>
              {% render 'icon', name: 'arrow-right' %}
            </button>
          </div>
        </div>
      </div>

      <div class="home-bestsellers__track reveal" data-carousel-track tabindex="0" aria-label="Best selling products">
        {%- for product in featured.products limit: 12 -%}
          <div class="home-bestsellers__item">
            <span class="home-bestsellers__rank" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {% render 'product-card', product: product, sizes: '(min-width: 1100px) 31vw, (min-width: 700px) 45vw, 82vw' %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

<section class="home-why section">
  <div class="container home-why__layout">
    <div class="home-why__intro reveal">
      <p class="eyebrow">{{ 'home.why_index' | t }}</p>
      <h2>{{ why_heading }}</h2>
      <p>{{ why_intro }}</p>
      <a class="link-rule" href="{{ routes.all_products_collection_url }}">
        {{ 'home.why_cta' | t }}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <ol class="home-why__benefits">
      {%- for i in (1..5) -%}
        {%- liquid
          assign icon_key = 'why_icon_' | append: i
          assign title_key = 'home.why_' | append: i | append: '_title'
          assign body_key = 'home.why_' | append: i | append: '_body'
        -%}
        <li class="home-why__benefit reveal">
          <span class="home-why__number" aria-hidden="true">{{ i | prepend: '0' }}</span>
          <span class="home-why__icon" aria-hidden="true">{% render 'icon', name: section.settings[icon_key] %}</span>
          <div>
            <h3>{{ title_key | t }}</h3>
            <p>{{ body_key | t }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

<section class="home-custom section">
  <div class="container home-custom__layout">
    <div class="home-custom__copy reveal">
      <p class="eyebrow">{{ 'home.custom_index' | t }}</p>
      <h2>{{ custom_heading }}</h2>
      <p class="home-custom__body">{{ custom_body }}</p>

      <ol class="home-custom__steps" aria-label="{{ 'home.custom_steps_label' | t }}">
        {%- for i in (1..3) -%}
          {%- assign step_key = 'home.custom_step_' | append: i -%}
          <li>
            <span aria-hidden="true">{{ i | prepend: '0' }}</span>
            <strong>{{ step_key | t }}</strong>
          </li>
        {%- endfor -%}
      </ol>

      <a class="button home-custom__button" href="{{ custom_link }}">
        {{ custom_button }}
        <span aria-hidden="true">&rarr;</span>
      </a>
      <p class="home-custom__note">{{ 'home.custom_note' | t }}</p>
    </div>

    <div class="home-custom__visual reveal">
      {%- if section.settings.custom_image != blank -%}
        {{
          section.settings.custom_image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '500, 800, 1100, 1400',
            sizes: '(min-width: 980px) 48vw, 100vw',
            alt: custom_image_alt
        }}
      {%- else -%}
        <img src="{{ 'metaliq-architectural-hero.jpg' | asset_url }}" width="1680" height="945" alt="{{ 'home.custom_image_alt' | t }}" loading="lazy">
      {%- endif -%}
      <span class="home-custom__visual-label">
        <span>{{ 'home.custom_visual_label' | t }}</span>
        <strong>{{ 'home.custom_visual_value' | t }}</strong>
      </span>
    </div>
  </div>
</section>

{%- if recent_collection.products_count > 0 -%}
  <section class="home-recent section" data-product-carousel>
    <div class="container">
      <div class="section-head home-recent__head reveal">
        <div>
          <p class="eyebrow">{{ 'home.recent_index' | t }}</p>
          <h2>{{ recent_heading }}</h2>
          <p class="home-recent__intro">{{ 'home.recent_intro' | t }}</p>
        </div>
        <div class="home-recent__actions">
          <a class="link" href="{{ recent_collection.url }}">{{ 'home.recent_view_all' | t }}</a>
          <div class="home-recent__controls" aria-label="{{ 'home.recent_controls' | t }}">
            <button class="icon-button home-recent__button home-recent__button--previous" type="button" aria-label="{{ 'home.recent_previous' | t }}" data-carousel-previous>
              {% render 'icon', name: 'arrow-right' %}
            </button>
            <button class="icon-button home-recent__button" type="button" aria-label="{{ 'home.recent_next' | t }}" data-carousel-next>
              {% render 'icon', name: 'arrow-right' %}
            </button>
          </div>
        </div>
      </div>

      <div class="home-recent__track reveal" data-carousel-track tabindex="0" aria-label="{{ 'home.recent_products' | t }}">
        {%- for product in recent_collection.products limit: 12 -%}
          <div class="home-recent__item">
            <span class="home-recent__date-mark">{{ 'home.recent_badge' | t }}</span>
            {% render 'product-card', product: product, sizes: '(min-width: 1100px) 23vw, (min-width: 700px) 45vw, 82vw' %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

<section class="home-faq section">
  <div class="container home-faq__layout">
    <header class="home-faq__heading reveal">
      <p class="eyebrow">{{ 'home.faq_index' | t }}</p>
      <h2>{{ 'home.faq_heading' | t }}</h2>
      <p>{{ 'home.faq_intro' | t }}</p>
      <a class="link-rule" href="{{ pages.contact.url | default: routes.root_url }}">
        {{ 'home.faq_contact' | t }}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </header>

    <div class="home-faq__list" data-faq-accordion>
      {%- for i in (1..8) -%}
        {%- liquid
          assign question_key = 'home.faq_' | append: i | append: '_question'
          assign answer_key = 'home.faq_' | append: i | append: '_answer'
        -%}
        <details class="home-faq__item reveal"{% if forloop.first %} open{% endif %}>
          <summary>
            <span class="home-faq__number" aria-hidden="true">{{ i | prepend: '0' }}</span>
            <span>{{ question_key | t }}</span>
            <span class="home-faq__toggle" aria-hidden="true"></span>
          </summary>
          <div class="home-faq__answer">
            <p>{{ answer_key | t }}</p>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="home-closing">
  <div class="container">
    <p>{{ section.settings.closing | default: 'Made to order. Sized for your space.' }}</p>
    <a class="link-rule" href="{{ routes.all_products_collection_url }}">
      {{ 'home.closing_cta' | t }}
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

{% stylesheet %}
  /* ---- Hero: centered headline and interactive artwork fan ---- */
  .home-hero {
    position: relative;
    isolation: isolate;
    background:
      linear-gradient(112deg, #11110f 0%, #1c1c1a 46%, #242420 72%, #161614 100%);
    color: #f7f5f0;
    overflow: hidden;
  }
  .home-hero::before,
  .home-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .home-hero::before {
    background-image:
      linear-gradient(118deg, transparent 0 22%, rgb(255 255 255 / 0.055) 22.05% 22.14%, transparent 22.2%),
      linear-gradient(64deg, transparent 0 68%, rgb(255 255 255 / 0.045) 68.05% 68.14%, transparent 68.2%),
      linear-gradient(146deg, transparent 0 48%, rgb(166 93 53 / 0.11) 48.05% 48.13%, transparent 48.2%),
      linear-gradient(28deg, transparent 0 78%, rgb(255 255 255 / 0.035) 78.05% 78.14%, transparent 78.2%);
  }
  .home-hero::after {
    background-image:
      repeating-linear-gradient(90deg, transparent 0 119px, rgb(255 255 255 / 0.022) 119px 120px),
      repeating-linear-gradient(0deg, transparent 0 119px, rgb(255 255 255 / 0.018) 119px 120px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
  }
  .home-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: clamp(14px, 2.5vh, 22px);
    min-height: clamp(500px, calc(100svh - var(--header-height) - var(--announce-height) - 24px), 680px);
    padding-block: clamp(26px, 4vh, 40px);
  }
  .home-hero__copy {
    display: contents;
  }
  .home-hero__title {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(3rem, 5vw, 4.7rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.01em;
    text-align: center;
    text-transform: capitalize;
    text-wrap: balance;
  }
  .home-hero__title span {
    color: var(--copper);
  }
  .home-hero__artworks {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 1100px);
    min-height: 220px;
    padding-inline: 20px;
    isolation: isolate;
  }
  .home-hero__group {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .home-hero__track {
    width: 100%;
    padding-block: 12px;
  }
  .home-hero__group[aria-hidden='true'] {
    display: none;
  }
  .home-hero-card {
    position: relative;
    flex: 0 1 200px;
    aspect-ratio: 4 / 5;
    margin-inline: -25px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: var(--radius-lg);
    background: var(--charcoal-deep);
    box-shadow: 0 18px 34px rgb(0 0 0 / 0.28);
    transform: translateY(var(--fan-y, 0)) rotate(var(--fan-rotation, 0deg));
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
    animation: hero-card-float var(--float-duration, 7s) ease-in-out var(--float-delay, 0s) infinite alternate;
    translate: 0 calc(var(--float-distance, 5px) * -1);
    will-change: translate;
  }
  .home-hero-card:nth-child(1) { --fan-y: -18px; --fan-rotation: -7deg; --float-distance: 6px; --float-duration: 6.8s; --float-delay: -2.1s; }
  .home-hero-card:nth-child(2) { --fan-y: -10px; --fan-rotation: -5deg; --float-distance: 9px; --float-duration: 8.2s; --float-delay: -5.4s; }
  .home-hero-card:nth-child(3) { --fan-y: -4px; --fan-rotation: -2deg; --float-distance: 7px; --float-duration: 7.4s; --float-delay: -1.2s; }
  .home-hero-card:nth-child(4) { --fan-y: 0; --fan-rotation: 0deg; --float-distance: 10px; --float-duration: 9.1s; --float-delay: -6.3s; }
  .home-hero-card:nth-child(5) { --fan-y: 4px; --fan-rotation: 2deg; --float-distance: 7px; --float-duration: 7.8s; --float-delay: -3.7s; }
  .home-hero-card:nth-child(6) { --fan-y: 10px; --fan-rotation: 5deg; --float-distance: 9px; --float-duration: 8.7s; --float-delay: -4.6s; }
  .home-hero-card:nth-child(7) { --fan-y: 18px; --fan-rotation: 7deg; --float-distance: 6px; --float-duration: 7.1s; --float-delay: -2.9s; }
  .home-hero__artworks:hover .home-hero-card,
  .home-hero__artworks:focus-within .home-hero-card {
    animation-play-state: paused;
  }
  @keyframes hero-card-float {
    from { translate: 0 calc(var(--float-distance, 5px) * -1); }
    to { translate: 0 var(--float-distance, 5px); }
  }
  .home-hero-card:hover,
  .home-hero-card:focus-visible {
    z-index: 5;
    box-shadow: 0 24px 48px rgb(0 0 0 / 0.42);
    transform: translateY(-12px) rotate(0deg);
  }
  .home-hero-card__media,
  .home-hero-card__media img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .home-hero-card__media img { object-fit: cover; }
  .home-hero-card__info {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 2px;
    padding: 42px 14px 14px;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.9));
