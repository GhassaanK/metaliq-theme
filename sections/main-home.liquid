    margin: 14px 0 22px;
    font-size: clamp(2.8rem, 2rem + 2.6vw, 5rem);
    line-height: 0.98;
  }
  .home-faq__heading > p:not(.eyebrow) {
    max-width: 38ch;
    color: var(--muted);
    line-height: 1.7;
  }
  .home-faq__heading .link-rule {
    margin-top: 32px;
  }
  .home-faq__list {
    border-top: 1px solid var(--line);
  }
  .home-faq__item {
    border-bottom: 1px solid var(--line);
  }
  .home-faq__item summary {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) 28px;
    align-items: center;
    gap: 16px;
    min-height: 78px;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
  }
  .home-faq__item summary::-webkit-details-marker {
    display: none;
  }
  .home-faq__item summary > span:nth-child(2) {
    font-family: var(--serif);
    font-size: clamp(1.1rem, 1rem + 0.35vw, 1.35rem);
    font-weight: 600;
    line-height: 1.35;
  }
  .home-faq__number {
    color: var(--muted);
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
  }
  .home-faq__toggle {
    position: relative;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition: border-color 0.2s var(--ease), transform 0.3s var(--ease);
  }
  .home-faq__toggle::before,
  .home-faq__toggle::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 1px;
    background: currentColor;
    content: '';
    transform: translate(-50%, -50%);
  }
  .home-faq__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform 0.25s var(--ease);
  }
  .home-faq__item summary:hover {
    color: var(--copper);
  }
  .home-faq__item summary:hover .home-faq__toggle {
    border-color: var(--copper);
  }
  .home-faq__item[open] .home-faq__toggle {
    border-color: var(--copper);
    color: var(--copper);
    transform: rotate(180deg);
  }
  .home-faq__item[open] .home-faq__toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .home-faq__answer {
    padding: 0 44px 24px 50px;
  }
  .home-faq__answer p {
    max-width: 60ch;
    color: var(--muted);
