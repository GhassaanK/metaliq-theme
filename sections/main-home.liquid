{% liquid
  assign hero_heading = section.settings.heading | default: shop.name
  assign featured = section.settings.featured_collection | default: collections.all
  assign fallback_handles = 'calligraphy,islamic,clocks,anime-comics,floral' | split: ','
%}

<section class="home-hero {% unless section.settings.image %}home-hero--art{% endunless %}">
  {%- if section.settings.image -%}
    <div class="home-hero__media">
      {{
        section.settings.image
        | image_url: width: 2600
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '800, 1200, 1600, 2000, 2600',
          sizes: '100vw',
          alt: section.settings.image.alt | default: hero_heading
      }}
    </div>
  {%- else -%}
    <div class="home-hero__art" aria-hidden="true">
      {% render 'engraving', seed: 12 %}
    </div>
  {%- endif -%}

  <div class="container home-hero__inner">
    <p class="home-hero__kicker">{{ section.settings.kicker | default: 'home.kicker' | t }}</p>
    <h1 class="home-hero__title">{{ hero_heading }}</h1>
    <p class="home-hero__tagline">{{ section.settings.tagline | default: 'home.tagline' | t }}</p>
    <p class="home-hero__body">{{ section.settings.body | default: 'home.hero_body' | t }}</p>
    <a
      class="link-rule home-hero__cta"
      href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
    >
      {{ section.settings.button_label | default: 'home.hero_cta' | t }}
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

<section class="home-statement section container reveal">
  <p class="eyebrow">{{ 'home.intro_eyebrow' | t }}</p>
  <h2>{{ section.settings.intro_heading | default: 'home.intro_heading' | t }}</h2>
  <p class="lede">{{ section.settings.intro_body | default: 'home.intro_body' | t }}</p>
</section>

{%- if section.blocks.size > 0 -%}
  <section class="home-collections section container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">{{ 'home.collections_index' | t }}</p>
        <h2>{{ 'home.collections_heading' | t }}</h2>
      </div>
      <a class="link" href="{{ routes.all_products_collection_url }}">{{ 'general.shop_all' | t }}</a>
    </div>

    <div class="home-collections__grid">
      {%- for block in section.blocks -%}
        {% liquid
          assign chosen = block.settings.collection
          if chosen == blank
            assign chosen = collections[fallback_handles[forloop.index0]]
          endif
          assign tile_title = chosen.title | default: block.settings.fallback_title
          assign tile_seed = chosen.id | default: forloop.index
        %}
        <a
          class="home-tile reveal"
          href="{{ chosen.url | default: routes.all_products_collection_url }}"
          {{ block.shopify_attributes }}
        >
          <span class="home-tile__media media">
            {%- if chosen.featured_image -%}
              {{
                chosen.featured_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 900, 1200',
                  sizes: '(min-width: 900px) 33vw, 100vw',
                  alt: tile_title
              }}
            {%- else -%}
              <span class="media-fallback">{% render 'engraving', seed: tile_seed %}</span>
            {%- endif -%}
          </span>
          <span class="home-tile__caption">
            <span class="home-tile__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="home-tile__title">{{ tile_title }}</span>
            <span class="home-tile__arrow" aria-hidden="true">&#8599;</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{%- if featured.products_count > 0 -%}
  <section class="home-featured section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">{{ 'home.featured_index' | t }}</p>
          <h2>{{ section.settings.featured_heading | default: 'home.featured_heading' | t }}</h2>
        </div>
        <a class="link" href="{{ featured.url }}">{{ 'home.featured_link' | t }}</a>
      </div>

      <div class="product-grid reveal">
        {%- for product in featured.products limit: 4 -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

<section class="home-process section container">
  <div class="home-process__visual reveal">
    {%- if section.settings.story_image -%}
      <div class="media">
        {{
          section.settings.story_image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '500, 800, 1100, 1400',
            sizes: '(min-width: 900px) 45vw, 100vw',
            alt: section.settings.story_image.alt | default: 'home.process_alt' | t
        }}
      </div>
    {%- else -%}
      <div class="media media-fallback home-process__art">
        {% render 'engraving', seed: 8 %}
      </div>
    {%- endif -%}
  </div>

  <div class="home-process__copy reveal">
    <p class="eyebrow">{{ 'home.process_index' | t }}</p>
    <blockquote class="home-process__quote">
      {{- section.settings.quote | default: 'Precision gives the piece its form. The hand finish gives it presence.' -}}
    </blockquote>
    <ol class="home-process__steps">
      {%- for i in (1..3) -%}
        {%- assign title_key = 'step_' | append: i | append: '_title' -%}
        {%- assign body_key = 'step_' | append: i | append: '_body' -%}
        <li>
          <span class="home-process__num">0{{ i }}</span>
          <div>
            <h3>{{ section.settings[title_key] }}</h3>
            <p>{{ section.settings[body_key] }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

<section class="home-closing">
  <div class="container">
    <p>{{ section.settings.closing | default: 'Made to order. Sized for your space.' }}</p>
    <a class="link-rule" href="{{ routes.all_products_collection_url }}">
      {{ 'home.closing_cta' | t }}
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

{% stylesheet %}
  /* ---- Hero ---- */
  .home-hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(560px, 88svh, 920px);
    padding-block: var(--sp-8);
    background: var(--charcoal-deep);
    color: var(--on-dark);
    overflow: hidden;
    isolation: isolate;
  }
  .home-hero__media,
  .home-hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .home-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(18 15 12 / 0.82) 0%,
      rgb(18 15 12 / 0.5) 45%,
      rgb(18 15 12 / 0.15) 100%
    );
  }
  .home-hero__art {
    position: absolute;
    right: -8vw;
    top: 50%;
    translate: 0 -50%;
    width: min(96vh, 820px);
    color: var(--copper-light);
    opacity: 0.16;
  }
  .home-hero--art::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(80% 60% at 20% 90%, rgb(0 0 0 / 0.45), transparent 70%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .home-hero__art {
      animation: home-hero-spin 90s linear infinite;
    }
  }
  @keyframes home-hero-spin {
    to {
      rotate: 360deg;
    }
  }
  .home-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: var(--sp-4);
    max-width: 40rem;
  }
  .home-hero__kicker {
    color: var(--copper-light);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .home-hero__title {
    margin: 0;
    font-size: var(--fs-display);
    font-weight: 420;
    line-height: 0.92;
    letter-spacing: -0.02em;
  }
  .home-hero__tagline {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.3rem, 1rem + 1.5vw, 2rem);
    font-style: italic;
    color: color-mix(in srgb, var(--on-dark) 85%, transparent);
  }
  .home-hero__body {
    max-width: 34rem;
    margin: var(--sp-2) 0 var(--sp-3);
    color: color-mix(in srgb, var(--on-dark) 72%, transparent);
    font-size: var(--fs-sm);
  }
  .home-hero__cta {
    border-color: color-mix(in srgb, var(--on-dark) 55%, transparent);
  }

  /* ---- Statement ---- */
  .home-statement {
    display: grid;
    gap: var(--sp-5);
    max-width: 62rem;
  }
  .home-statement h2 {
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.8rem);
    line-height: 1.06;
  }

  /* ---- Collections ---- */
  .home-collections__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-7) var(--sp-5);
  }
  .home-tile__media {
    display: block;
    aspect-ratio: 3 / 4;
  }
  .home-tile__media img,
  .home-tile__media .media-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  .home-tile:hover .home-tile__media img,
  .home-tile:hover .home-tile__media .media-fallback {
    transform: scale(1.04);
  }
  .home-tile__caption {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: var(--sp-3);
    padding-top: var(--sp-3);
  }
  .home-tile__index {
    color: var(--muted);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }
  .home-tile__title {
    font-family: var(--serif);
    font-size: var(--fs-h4);
  }
  .home-tile__arrow {
    color: var(--muted);
    transition: transform 0.25s var(--ease);
  }
  .home-tile:hover .home-tile__arrow {
    transform: translate(3px, -3px);
    color: var(--copper);
  }

  /* ---- Featured ---- */
  .home-featured {
    background: var(--charcoal);
    color: var(--on-dark);
  }
  .home-featured .section-head {
    border-color: rgb(255 255 255 / 0.16);
  }
  .home-featured .eyebrow {
    color: var(--copper-light);
  }
  .home-featured .link {
    color: var(--on-dark);
  }
  .home-featured .media-fallback {
    background: color-mix(in srgb, var(--charcoal) 88%, #000);
    color: color-mix(in srgb, var(--copper-light) 70%, transparent);
  }
  .home-featured .product-card__title a {
    color: var(--on-dark);
  }
  .home-featured .product-card__kicker {
    color: var(--on-dark-muted);
  }
  .home-featured .price {
    color: var(--copper-light);
  }
  .home-featured .price s {
    color: var(--on-dark-muted);
  }

  /* ---- Process ---- */
  .home-process {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
  }
  .home-process__visual .media {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
  }
  .home-process__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .home-process__art {
    display: grid;
    place-items: center;
  }
  .home-process__art .engraving {
    width: 62%;
  }
  .home-process__quote {
    margin: var(--sp-4) 0 var(--sp-7);
    padding: 0;
    border: 0;
    font-family: var(--serif);
    font-size: clamp(1.6rem, 1rem + 2.4vw, 3rem);
    font-style: normal;
    line-height: 1.14;
  }
  .home-process__quote::before {
    content: '\201C';
  }
  .home-process__quote::after {
    content: '\201D';
  }
  .home-process__steps {
    display: grid;
    gap: 0;
  }
  .home-process__steps li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: var(--sp-4);
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--line);
  }
  .home-process__num {
    color: var(--copper);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }
  .home-process__steps h3 {
    margin-bottom: 4px;
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .home-process__steps p {
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  /* ---- Closing ---- */
  .home-closing {
    padding-block: var(--section);
    background: var(--copper);
    color: #fff;
  }
  .home-closing .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
  }
  .home-closing p {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 1rem + 3vw, 3.6rem);
    line-height: 1.05;
  }

  @media (max-width: 980px) {
    .home-collections__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .home-process {
      grid-template-columns: 1fr;
      gap: var(--sp-7);
    }
  }

  @media (max-width: 560px) {
    .home-hero {
      align-items: center;
      text-align: left;
    }
    .home-collections__grid {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.home.name",
  "settings": [
    { "type": "header", "content": "t:sections.home.hero" },
    { "type": "image_picker", "id": "image", "label": "t:labels.hero_image" },
    { "type": "text", "id": "kicker", "label": "t:labels.text", "default": "CNC-cut metalwork / Pakistan" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "MetaliQ" },
    { "type": "text", "id": "tagline", "label": "t:general.secondary", "default": "Art, Cut in Metal." },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:labels.text",
      "default": "Architectural wall pieces, drawn with precision and finished by hand."
    },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "View the collection" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" },

    { "type": "header", "content": "t:sections.home.intro" },
    {
      "type": "text",
      "id": "intro_heading",
      "label": "t:labels.heading",
      "default": "Metalwork that changes the character of a room."
    },
    {
      "type": "textarea",
      "id": "intro_body",
      "label": "t:labels.text",
      "default": "We turn considered linework into lasting objects. Each piece is cut in steel, refined by hand, and made to sit naturally within contemporary spaces."
    },

    { "type": "header", "content": "t:sections.home.featured" },
    { "type": "collection", "id": "featured_collection", "label": "t:labels.featured_collection" },
    {
      "type": "text",
      "id": "featured_heading",
      "label": "t:labels.featured_heading",
      "default": "Objects with presence"
    },

    { "type": "header", "content": "t:sections.home.process" },
    { "type": "image_picker", "id": "story_image", "label": "t:labels.story_image" },
    {
      "type": "textarea",
      "id": "quote",
      "label": "t:labels.text",
      "default": "Precision gives the piece its form. The hand finish gives it presence."
    },
    { "type": "text", "id": "step_1_title", "label": "t:labels.heading", "default": "Composed" },
    {
      "type": "text",
      "id": "step_1_body",
      "label": "t:labels.text",
      "default": "Artwork balanced for detail, strength, and scale."
    },
    { "type": "text", "id": "step_2_title", "label": "t:labels.heading", "default": "Cut" },
    {
      "type": "text",
      "id": "step_2_body",
      "label": "t:labels.text",
      "default": "Every line translated precisely into steel."
    },
    { "type": "text", "id": "step_3_title", "label": "t:labels.heading", "default": "Finished" },
    {
      "type": "text",
      "id": "step_3_body",
      "label": "t:labels.text",
      "default": "Refined and coated for a durable architectural surface."
    },

    { "type": "header", "content": "t:sections.home.closing" },
    {
      "type": "text",
      "id": "closing",
      "label": "t:labels.text",
      "default": "Made to order. Sized for your space."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:sections.home.category",
      "limit": 12,
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:labels.collection" },
        { "type": "text", "id": "fallback_title", "label": "t:labels.fallback_title", "default": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.home.name",
      "blocks": [
        { "type": "category", "settings": { "fallback_title": "Calligraphy" } },
        { "type": "category", "settings": { "fallback_title": "Islamic" } },
        { "type": "category", "settings": { "fallback_title": "Clocks" } },
        { "type": "category", "settings": { "fallback_title": "Anime & Comics" } },
        { "type": "category", "settings": { "fallback_title": "Floral" } },
        { "type": "category", "settings": { "fallback_title": "Portraits" } }
      ]
    }
  ]
}
{% endschema %}
