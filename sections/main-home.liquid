      mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    }
    .home-hero__track,
    .home-hero__group {
      --reel-gap: 12px;
    }
    .home-hero__track {
      --reel-half-gap: 6px;
    }
    .home-hero-card {
      flex-basis: min(46vw, 180px);
    }
    .home-hero-card__info { opacity: 1; transform: none; }
    .home-hero__actions { flex-direction: column; gap: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__track {
      animation: none;
    }
