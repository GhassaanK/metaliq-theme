{% liquid
  assign feature_image = section.settings.image
  if feature_image == blank
    for collection in collections
      if collection.featured_image != blank
        assign feature_image = collection.featured_image
        break
      endif
    endfor
  endif
%}

<section class="about-page">
  <div class="container">
    {% render 'breadcrumbs' %}

    <header class="about-page__hero">
      <div class="about-page__intro">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>
        <p>{{ section.settings.introduction }}</p>
      </div>
      <div class="about-page__mark" aria-hidden="true">
        <span>Metal</span>
        <span>Made</span>
        <span>Meaningful</span>
      </div>
    </header>

    <div class="about-page__story">
      <div class="about-page__media">
        {%- if feature_image != blank -%}
          {{ feature_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 55vw, 100vw', alt: section.settings.image_alt }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="about-page__copy">
        <p class="eyebrow">{{ section.settings.story_eyebrow }}</p>
        <h2>{{ section.settings.story_heading }}</h2>
        <div class="rte">{{ section.settings.story }}</div>
      </div>
    </div>

    <div class="about-page__principles">
      {%- for block in section.blocks -%}
        <article class="about-page__principle" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading }}</h2>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>

    <section class="about-page__operations" aria-labelledby="AboutOperations">
      <div class="about-page__operations-intro">
        <p class="eyebrow">{{ 'about.operations_eyebrow' | t }}</p>
        <h2 id="AboutOperations">{{ 'about.operations_title' | t }}</h2>
        <p>{{ 'about.operations_body' | t }}</p>
      </div>
      <div class="about-page__model">
        <article><h3>{{ 'about.catalog_title' | t }}</h3><p>{{ 'about.catalog_body' | t }}</p></article>
        <article><h3>{{ 'about.bespoke_title' | t }}</h3><p>{{ 'about.bespoke_body' | t }}</p></article>
        <article><h3>{{ 'about.fulfilment_title' | t }}</h3><p>{{ 'about.fulfilment_body' | t }}</p></article>
      </div>
      <div class="about-page__legal">
        <p>{{ 'about.legal_body' | t }}</p>
        <a class="link-rule" href="/pages/ordering-and-payments">{{ 'about.journey_link' | t }} <span aria-hidden="true">&rarr;</span></a>
      </div>
    </section>

    {%- if page.content != blank -%}
      <div class="about-page__body rte">{{ page.content }}</div>
    {%- endif -%}

    <div class="about-page__cta">
      <div>
        <p class="eyebrow">{{ 'about.cta_eyebrow' | t }}</p>
        <h2>{{ 'about.cta_heading' | t }}</h2>
      </div>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'about.cta_button' | t }}</a>
    </div>
  </div>
</section>

{% stylesheet %}
  .about-page {
    padding: 34px 0 clamp(72px, 10vw, 140px);
    overflow: hidden;
  }
  .about-page__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(230px, 0.75fr);
    align-items: end;
    gap: clamp(48px, 10vw, 150px);
    min-height: min(660px, 70vh);
    padding-block: clamp(70px, 10vw, 150px);
    border-bottom: 1px solid var(--line);
  }
  .about-page__intro h1 {
    max-width: 11ch;
    margin-top: 16px;
    font-size: clamp(3.8rem, 3rem + 5vw, 8.5rem);
    line-height: 0.9;
  }
  .about-page__intro > p:last-child {
    max-width: 48ch;
    margin-top: 30px;
    color: var(--muted);
    font-size: clamp(1rem, 0.92rem + 0.35vw, 1.22rem);
    line-height: 1.7;
  }
  .about-page__mark {
    display: grid;
    justify-items: end;
    color: var(--muted);
    font-size: clamp(0.7rem, 0.62rem + 0.3vw, 0.86rem);
    font-weight: 600;
    line-height: 2;
    text-transform: uppercase;
  }
  .about-page__mark span:nth-child(2) { color: var(--copper); }
  .about-page__story {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    align-items: center;
    gap: clamp(48px, 8vw, 120px);
    padding-block: clamp(72px, 10vw, 140px);
  }
  .about-page__media {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 8px;
    background: var(--surface);
  }
  .about-page__media img,
  .about-page__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-page__copy h2 {
    max-width: 12ch;
    margin: 14px 0 28px;
    font-size: clamp(2.6rem, 2rem + 2.8vw, 5.2rem);
    line-height: 0.98;
  }
  .about-page__copy .rte { color: var(--muted); }
  .about-page__principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .about-page__principle {
    min-height: 300px;
    padding: clamp(30px, 4vw, 54px);
    border-right: 1px solid var(--line);
  }
  .about-page__principle:last-child { border-right: 0; }
  .about-page__principle h2 {
    margin: 0 0 16px;
    font-size: clamp(1.7rem, 1.4rem + 0.8vw, 2.4rem);
  }
  .about-page__principle p {
    color: var(--muted);
    line-height: 1.7;
  }
  .about-page__body {
    max-width: 760px;
    margin: clamp(72px, 9vw, 120px) auto 0;
  }
  .about-page__operations { padding-block: clamp(72px, 10vw, 140px); border-bottom: 1px solid var(--line); }
  .about-page__operations-intro { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: 28px 60px; }
  .about-page__operations-intro h2 { max-width: 12ch; font-size: clamp(2.6rem, 2rem + 2.8vw, 5.2rem); line-height: 0.98; }
  .about-page__operations-intro > p:last-child { grid-column: 2; max-width: 62ch; color: var(--muted); line-height: 1.7; }
  .about-page__model { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 70px; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .about-page__model article { min-height: 260px; padding: clamp(24px, 4vw, 44px); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .about-page__model h3 { margin: 0 0 14px; font-family: var(--serif); font-size: var(--fs-h3); }
  .about-page__model p { color: var(--muted); line-height: 1.65; }
  .about-page__legal { display: flex; align-items: center; justify-content: space-between; gap: 40px; margin-top: 36px; }
  .about-page__legal p { max-width: 68ch; color: var(--muted); font-size: var(--fs-sm); line-height: 1.65; }
  .about-page__cta {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-top: clamp(72px, 10vw, 140px);
    padding: clamp(34px, 6vw, 72px);
    border-radius: 8px;
    background: var(--copper);
    color: var(--on-accent);
  }
  .about-page__cta .eyebrow { color: currentColor; }
  .about-page__cta h2 {
    max-width: 14ch;
    margin-top: 12px;
    font-size: clamp(2.1rem, 1.6rem + 2vw, 4rem);
    line-height: 1;
  }
  .about-page__cta .button {
    border-color: var(--on-accent);
    background: var(--on-accent);
    color: #fff;
  }
  @media (max-width: 820px) {
    .about-page__hero,
    .about-page__story { grid-template-columns: 1fr; }
    .about-page__hero { min-height: 0; }
    .about-page__mark { display: none; }
    .about-page__media { aspect-ratio: 4 / 4.6; }
    .about-page__principles { grid-template-columns: 1fr; }
    .about-page__principle { min-height: 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .about-page__principle:last-child { border-bottom: 0; }
    .about-page__operations-intro, .about-page__model { grid-template-columns: 1fr; }
    .about-page__operations-intro > p:last-child { grid-column: 1; }
    .about-page__legal { align-items: flex-start; flex-direction: column; }
    .about-page__cta { align-items: flex-start; flex-direction: column; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About MetaliQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About MetaliQ Art" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We turn empty walls into points of view." },
    { "type": "textarea", "id": "introduction", "label": "Introduction", "default": "MetaliQ Art creates precision-cut metal artwork for people who want their spaces to feel considered, personal, and unmistakably their own." },
    { "type": "image_picker", "id": "image", "label": "Feature image" },
    { "type": "text", "id": "image_alt", "label": "Image alternative text", "default": "MetaliQ metal wall art displayed in an interior" },
    { "type": "text", "id": "story_eyebrow", "label": "Story eyebrow", "default": "Our approach" },
    { "type": "text", "id": "story_heading", "label": "Story heading", "default": "Art engineered for real spaces." },
    { "type": "richtext", "id": "story", "label": "Story", "default": "<p>Every MetaliQ piece begins with an idea worth giving permanence. We refine the composition, translate it into a cut-ready design, and fabricate it in metal with close attention to proportion, edges, finish, and the way it will sit on a wall.</p><p>Our collection moves between nature, culture, calligraphy, fandom, and personal stories. For spaces that need something entirely individual, we also develop custom work around a reference, name, memory, or dimension.</p>" }
  ],
  "blocks": [
    { "type": "principle", "name": "Principle", "limit": 3, "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "max_blocks": 3,
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
