{%- liquid
  assign campaign_heading = section.settings.heading | default: collection.title
  assign campaign_intro = section.settings.intro
  if campaign_intro == blank
    assign campaign_intro = collection.description | strip_html
  endif
-%}

<div class="container limited-offers-breadcrumbs">
  {% render 'breadcrumbs' %}
</div>

{%- if collection.products_count > 0 -%}
  {% render 'limited-time-sale',
    section: section,
    products: collection.products,
    heading: campaign_heading,
    intro: campaign_intro,
    eyebrow: section.settings.eyebrow,
    fallback_image: collection.featured_image,
    collection_page: true
  %}
{%- else -%}
  <section class="container section">
    <div class="empty-state">
      <h1>{{ campaign_heading | escape }}</h1>
      <p>{{ 'collection.limited_empty_body' | t }}</p>
      <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty_action' | t }}</a>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .limited-offers-breadcrumbs {
    padding-top: var(--stack-lg);
  }
  .limited-offers-breadcrumbs .breadcrumbs {
    margin-bottom: var(--stack-lg);
  }
  .home-limited-sale--collection {
    border-top: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.limited_offers.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.limited_offers.shared_settings"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.campaign_eyebrow",
      "default": "Limited-time bundles"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.campaign_heading"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "t:labels.campaign_intro"
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
