<section class="hero full-width">
  <picture>{% if section.settings.image %}{{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '900, 1400, 1900, 2400', sizes: '100vw', alt: section.settings.image.alt | default: 'CNC-cut metal wall art' }}{% else %}<img src="{{ 'metaliq-hero.png' | asset_url }}" width="1680" height="945" alt="Intricate CNC-cut metal wall art mounted on concrete" fetchpriority="high">{% endif %}</picture>
  <div class="hero-shade"></div><div class="container hero-content"><p class="hero-kicker">CNC-cut metalwork / Pakistan</p><h1>MetaliQ</h1><p class="hero-tagline">Art, Cut in Metal.</p><div class="hero-action"><p>Architectural wall pieces, drawn with precision and finished by hand.</p><a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | default: 'View the collection' }} <span aria-hidden="true">&#8594;</span></a></div></div>
</section>
<section class="editorial-intro container"><p class="eyebrow">The MetaliQ collection</p><div><h2>Metalwork that changes the character of a room.</h2><p>We turn considered linework into lasting objects. Each piece is cut in steel, refined by hand, and made to sit naturally within contemporary spaces.</p></div></section>
<section class="collection-showcase container"><header class="showcase-heading"><span>01 / Collections</span><h2>Explore by expression</h2></header><div class="editorial-grid">
  {% assign fallback_handles = 'calligraphy,islamic,clocks,anime-comics,floral' | split: ',' %}
  {% for block in section.blocks %}{% assign chosen_collection = block.settings.collection %}{% if chosen_collection == blank %}{% assign chosen_collection = collections[fallback_handles[forloop.index0]] %}{% endif %}<a class="editorial-tile editorial-tile--{{ forloop.index }}" href="{{ chosen_collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><div class="editorial-tile__media">{% if chosen_collection.featured_image %}{{ chosen_collection.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 900px) 50vw, 100vw', alt: chosen_collection.featured_image.alt | default: chosen_collection.title }}{% else %}<img src="{{ 'metaliq-hero.png' | asset_url }}" width="1680" height="945" loading="lazy" alt="{{ block.settings.fallback_title | escape }} metal art">{% endif %}</div><div class="editorial-tile__caption"><span>0{{ forloop.index }}</span><h3>{{ chosen_collection.title | default: block.settings.fallback_title }}</h3><span aria-hidden="true">&#8599;</span></div></a>{% endfor %}
</div></section>
{% assign featured_collection = section.settings.featured_collection | default: collections.all %}
{% if featured_collection.products_count > 0 %}<section class="featured-work full-width"><div class="container"><header class="showcase-heading showcase-heading--light"><span>02 / Selected work</span><h2>{{ section.settings.featured_heading }}</h2><a href="{{ featured_collection.url }}">See all pieces</a></header><div class="product-grid product-grid--featured">{% for product in featured_collection.products limit: 4 %}{% render 'product-card', product: product %}{% endfor %}</div></div></section>{% endif %}
<section class="craft-story container"><div class="craft-story__image"><img src="{{ 'metaliq-hero.png' | asset_url }}" width="1680" height="945" loading="lazy" alt="Close detail of CNC-cut metal artwork"></div><div class="craft-story__copy"><span>03 / The process</span><p class="craft-quote">“Precision gives the piece its form. The hand finish gives it presence.”</p><ol><li><span>01</span><div><h3>Composed</h3><p>Artwork balanced for detail, strength, and scale.</p></div></li><li><span>02</span><div><h3>Cut</h3><p>Every line translated precisely into steel.</p></div></li><li><span>03</span><div><h3>Finished</h3><p>Refined and coated for a durable architectural surface.</p></div></li></ol></div></section>
<section class="closing-statement full-width"><div class="container"><p>Made to order. Sized for your space.</p><a href="{{ routes.all_products_collection_url }}">Find your piece <span aria-hidden="true">&#8594;</span></a></div></section>
{% schema %}
{"name":"MetaliQ home","settings":[{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"button_label","label":"Button label","default":"View the collection"},{"type":"url","id":"button_link","label":"Button link"},{"type":"collection","id":"featured_collection","label":"Featured collection"},{"type":"text","id":"featured_heading","label":"Featured heading","default":"Objects with presence"}],"blocks":[{"type":"category","name":"Category","limit":5,"settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"fallback_title","label":"Fallback title","default":"Collection"}]}],"presets":[{"name":"MetaliQ home","blocks":[{"type":"category","settings":{"fallback_title":"Calligraphy"}},{"type":"category","settings":{"fallback_title":"Islamic"}},{"type":"category","settings":{"fallback_title":"Clocks"}},{"type":"category","settings":{"fallback_title":"Anime & Comics"}},{"type":"category","settings":{"fallback_title":"Floral"}}]}]}
{% endschema %}
