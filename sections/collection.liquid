<section class="container section collection-section">
  {% render 'breadcrumbs' %}

  <header class="collection-hero">
    <p class="eyebrow">{{ 'collection.eyebrow' | t }}</p>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="rte collection-hero__desc">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="collection-toolbar">
      <p>{{ 'collection.count' | t: count: collection.products_count }}</p>

      {%- if collection.sort_options.size > 0 -%}
        <form>
          <label for="SortBy">{{ 'general.sort_by' | t }}</label>
          <select id="SortBy" name="sort_by" data-sort-by>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
                {{- option.name -}}
              </option>
            {%- endfor -%}
          </select>
          <noscript>
            <button class="button button--ghost" type="submit">{{ 'general.sort_by' | t }}</button>
          </noscript>
        </form>
      {%- endif -%}
    </div>

    <div class="product-grid">
      {%- for product in collection.products -%}
        {%- if forloop.index <= 4 -%}
          {% render 'product-card', product: product, loading: 'eager', heading_level: 2 %}
        {%- else -%}
          {% render 'product-card', product: product, heading_level: 2 %}
        {%- endif -%}
      {%- else -%}
        <div class="empty-state">
          <h2>{{ 'collection.empty_title' | t }}</h2>
          <p>{{ 'collection.empty_body' | t }}</p>
          <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">
            {{- 'cart.empty_action' | t -}}
          </a>
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="pagination">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% stylesheet %}
  .collection-hero__desc {
    margin-top: var(--sp-4);
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .collection-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .collection-toolbar p {
    color: var(--muted);
  }
  .collection-toolbar form {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .collection-toolbar label {
    color: var(--muted);
  }
  .collection-toolbar select {
    width: auto;
    padding: 9px 40px 9px 12px;
  }
  @media (max-width: 620px) {
    .collection-toolbar {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--sp-3);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:labels.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
