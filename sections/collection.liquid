<section class="container section collection-section">
  {% render 'breadcrumbs' %}

  <header class="collection-hero">
    <p class="eyebrow">{{ 'collection.eyebrow' | t }}</p>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="rte collection-hero__desc">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- liquid
      assign active_filter_count = 0
      for filter in collection.filters
        assign active_filter_count = active_filter_count | plus: filter.active_values.size
        if filter.type == 'price_range'
          if filter.min_value.value != nil
            assign active_filter_count = active_filter_count | plus: 1
          elsif filter.max_value.value != nil
            assign active_filter_count = active_filter_count | plus: 1
          endif
        endif
      endfor
    -%}
    <div class="collection-toolbar">
      <div class="collection-toolbar__summary">
        <button class="collection-filter-trigger" type="button" data-filter-open aria-haspopup="dialog">
          {% render 'icon', name: 'filter' %}
          <span>{{ 'collection.filters' | t }}</span>
          {%- if active_filter_count > 0 -%}<span class="collection-filter-trigger__count">{{ active_filter_count }}</span>{%- endif -%}
        </button>
        <p>{{ 'collection.count' | t: count: paginate.items }}</p>
      </div>

      {%- if collection.sort_options.size > 0 -%}
        <form action="{{ collection.url }}" method="get">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != nil -%}
                <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | divided_by: 100.0 }}">
              {%- endif -%}
              {%- if filter.max_value.value != nil -%}
                <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | divided_by: 100.0 }}">
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <label for="SortBy">{{ 'general.sort_by' | t }}</label>
          <select id="SortBy" name="sort_by" data-sort-by>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
                {{- option.name -}}
              </option>
            {%- endfor -%}
          </select>
          <noscript>
            <button class="button button--ghost" type="submit">{{ 'general.sort_by' | t }}</button>
          </noscript>
        </form>
      {%- endif -%}
    </div>

    {%- if active_filter_count > 0 -%}
      <div class="collection-active-filters" aria-label="{{ 'collection.active_filters' | t }}">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a href="{{ value.url_to_remove }}">
              <span>{{ filter.label | escape }}: {{ value.label | escape }}</span>
              <span aria-hidden="true">&times;</span>
            </a>
          {%- endfor -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
              <a href="{{ filter.url_to_remove }}">
                <span>
                  {{- filter.label | escape }}:
                  {{ filter.min_value.value | default: 0 | money }}&ndash;{{ filter.max_value.value | default: filter.range_max | money -}}
                </span>
                <span aria-hidden="true">&times;</span>
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <a class="collection-active-filters__clear" href="{{ collection.url }}">{{ 'collection.clear_all' | t }}</a>
      </div>
    {%- endif -%}

    <div class="collection-layout">
      <aside class="collection-sidebar" aria-label="{{ 'collection.filters' | t }}">
        {% render 'collection-filters', collection: collection, id_prefix: 'desktop', show_heading: true, auto_apply: true %}
      </aside>

      <div class="collection-results">
        <div class="product-grid">
          {%- for product in collection.products -%}
            {%- if forloop.index <= 4 -%}
              {% render 'product-card', product: product, loading: 'eager', heading_level: 2, sizes: '(min-width: 1280px) 18vw, (min-width: 1000px) 22vw, (min-width: 620px) 31vw, 50vw' %}
            {%- else -%}
              {% render 'product-card', product: product, heading_level: 2, sizes: '(min-width: 1280px) 18vw, (min-width: 1000px) 22vw, (min-width: 620px) 31vw, 50vw' %}
            {%- endif -%}
          {%- else -%}
            <div class="empty-state collection-empty">
              {%- if active_filter_count > 0 -%}
                <h2>{{ 'collection.no_matches_title' | t }}</h2>
                <p>{{ 'collection.no_matches_body' | t }}</p>
                <a class="button button--secondary" href="{{ collection.url }}">{{ 'collection.clear_all' | t }}</a>
              {%- else -%}
                <h2>{{ 'collection.empty_title' | t }}</h2>
                <p>{{ 'collection.empty_body' | t }}</p>
                <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty_action' | t }}</a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="pagination">{{ paginate | default_pagination }}</div>
        {%- endif -%}
      </div>
    </div>

    <dialog class="collection-filter-drawer" data-filter-dialog aria-labelledby="FilterDrawerTitle">
      <div class="collection-filter-drawer__header">
        <h2 id="FilterDrawerTitle">{{ 'collection.filters' | t }}</h2>
        <button class="icon-button" type="button" data-filter-close aria-label="{{ 'general.close' | t }}">
          {% render 'icon', name: 'close' %}
        </button>
      </div>
      <div class="collection-filter-drawer__body">
        {% render 'collection-filters', collection: collection, id_prefix: 'mobile', show_heading: false %}
      </div>
    </dialog>
  {%- endpaginate -%}
</section>

{% stylesheet %}
  .collection-hero__desc {
    margin-top: var(--sp-4);
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .collection-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .collection-toolbar p {
    color: var(--muted);
  }
  .collection-toolbar__summary {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .collection-filter-trigger {
    display: none;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
  }
  .collection-filter-trigger .icon {
    width: 18px;
    height: 18px;
  }
  .collection-filter-trigger__count,
  .collection-filter__count {
    display: inline-grid;
    min-width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 50%;
    background: var(--copper);
    color: var(--on-accent);
    font-size: 0.68rem;
  }
  .collection-toolbar form {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .collection-toolbar label {
    color: var(--muted);
  }
  .collection-toolbar select {
    width: auto;
    padding: 9px 40px 9px 12px;
  }
  .collection-layout {
    display: grid;
    grid-template-columns: minmax(210px, 240px) minmax(0, 1fr);
    align-items: start;
    gap: clamp(28px, 4vw, 56px);
  }
  .collection-results {
    min-width: 0;
  }
  .collection-results .product-grid {
    --cols: 4;
    gap: 20px;
  }
  .collection-sidebar {
    position: sticky;
    top: 20px;
  }
  .collection-filters__heading,
  .collection-filter summary,
  .collection-filter__categories a,
  .collection-filter__values label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .collection-filters__heading {
    min-height: 48px;
    border-bottom: 1px solid var(--line);
  }
  .collection-filters__heading h2,
  .collection-filter-drawer__header h2 {
    font-family: var(--serif);
    font-size: 1.35rem;
  }
  .collection-filters__heading a {
    color: var(--copper-light);
    font-size: 0.72rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .collection-filter {
    border-bottom: 1px solid var(--line);
  }
  .collection-filter summary {
    min-height: 52px;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 700;
    list-style: none;
  }
  .collection-filter summary::-webkit-details-marker {
    display: none;
  }
  .collection-filter summary > span:first-child {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .collection-filter__chevron {
    width: 8px;
    height: 8px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.2s var(--ease);
  }
  .collection-filter:not([open]) .collection-filter__chevron {
    transform: rotate(-45deg);
  }
  .collection-filter__categories,
  .collection-filter__values {
    display: grid;
    gap: 2px;
    padding: 2px 0 16px;
  }
  .collection-filter__categories a,
  .collection-filter__values label {
    min-height: 36px;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .collection-filter__categories a[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
  }
  .collection-filter__categories a:hover,
  .collection-filter__values label:hover {
    color: var(--copper-light);
  }
  .collection-filter__values li {
    position: relative;
  }
  .collection-filter__values input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .collection-filter__values label {
    position: relative;
    padding-left: 28px;
    cursor: pointer;
  }
  .collection-filter__values label::before {
    position: absolute;
    left: 0;
    width: 18px;
    height: 18px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--surface);
    content: '';
  }
  .collection-filter__values input:checked + label::before {
    border-color: var(--copper);
    background: var(--copper);
    box-shadow: inset 0 0 0 4px var(--surface);
  }
  .collection-filter__values input:focus-visible + label::before {
    outline: 2px solid var(--copper-light);
    outline-offset: 2px;
  }
  .collection-filter__values input:disabled + label {
    cursor: not-allowed;
    opacity: 0.42;
  }
  .collection-filter__price {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 2px 0 18px;
  }
  .collection-filter__price > p {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: 0.7rem;
  }
  .collection-filter__price label {
    display: block;
    margin-bottom: 6px;
    color: var(--muted);
    font-size: 0.7rem;
  }
  .collection-filter__price div > span {
    position: relative;
    display: block;
  }
  .collection-filter__price small {
    position: absolute;
    top: 50%;
    left: 10px;
    color: var(--muted);
    transform: translateY(-50%);
  }
  .collection-filter__price input {
    min-width: 0;
    padding-left: 28px;
  }
  .collection-filters__actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    padding-top: 18px;
  }
  .collection-filters__actions .button {
    width: 100%;
    min-height: 44px;
  }
  .collection-active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: calc(var(--sp-6) * -0.45) 0 var(--sp-5);
  }
  .collection-active-filters a {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.72rem;
  }
  .collection-active-filters a:hover {
    border-color: var(--copper);
    color: var(--ink);
  }
  .collection-active-filters .collection-active-filters__clear {
    border-color: transparent;
    background: transparent;
    color: var(--copper-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .collection-filter-drawer {
    display: none;
  }
  html.filter-drawer-open {
    overflow: hidden;
  }
  .collection-empty {
    grid-column: 1 / -1;
  }
  @media (max-width: 1240px) {
    .collection-results .product-grid {
      --cols: 3;
    }
  }
  @media (max-width: 900px) {
    .collection-layout {
      grid-template-columns: 1fr;
    }
    .collection-sidebar {
      display: none;
    }
    .collection-results .product-grid {
      --cols: 3;
    }
    .collection-filter-trigger {
      display: inline-flex;
    }
    .collection-filter-drawer[open] {
      position: fixed;
      inset: 0 0 0 auto;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr);
      width: min(92vw, 390px);
      max-width: none;
      height: 100dvh;
      max-height: none;
      margin: 0;
      padding: 0;
      border: 0;
      background: var(--background);
      color: var(--ink);
      box-shadow: -18px 0 50px rgb(0 0 0 / 0.4);
    }
    .collection-filter-drawer::backdrop {
      background: rgb(0 0 0 / 0.66);
      backdrop-filter: blur(2px);
    }
    .collection-filter-drawer__header {
      display: flex;
      min-height: 68px;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 12px 20px;
      border-bottom: 1px solid var(--line);
    }
    .collection-filter-drawer__body {
      padding: 8px 20px 28px;
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .collection-filter-drawer .collection-filters__actions {
      position: sticky;
      bottom: -28px;
      padding-block: 16px 28px;
      background: var(--background);
      box-shadow: 0 -18px 28px var(--background);
    }
  }
  @media (max-width: 680px) {
    .collection-toolbar {
      align-items: stretch;
      gap: var(--sp-3);
    }
    .collection-toolbar__summary {
      justify-content: space-between;
    }
    .collection-toolbar form {
      justify-content: space-between;
    }
    .collection-toolbar select {
      width: min(220px, 68vw);
    }
    .collection-results .product-grid {
      --cols: 2;
      gap: 14px;
    }
  }
  @media (max-width: 359px) {
    .collection-results .product-grid {
      --cols: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:labels.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
