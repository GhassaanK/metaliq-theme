<section class="container page-section narrow-page">
  {% render 'breadcrumbs' %}

  <header class="page-header">
    <p class="eyebrow">{{ section.settings.eyebrow | default: shop.name }}</p>
    <h1>{{ page.title }}</h1>
  </header>

  <div class="rte page-content">{{ page.content }}</div>
</section>

{% schema %}
{
  "name": "t:general.page",
  "settings": [{ "type": "text", "id": "eyebrow", "label": "t:labels.text" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
