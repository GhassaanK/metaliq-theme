<section class="container container--narrow section">
  {% render 'breadcrumbs' %}

  <header class="page-header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1>{{ page.title }}</h1>
  </header>

  <div class="rte page-content">{{ page.content }}</div>
</section>

{% schema %}
{
  "name": "t:general.page",
  "settings": [{ "type": "text", "id": "eyebrow", "label": "t:labels.text" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
