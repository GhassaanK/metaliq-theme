{% comment %}
  Landing page shown while the storefront is password protected.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<section class="password-page">
  <div class="password-art" aria-hidden="true">{% render 'engraving', seed: 16 %}</div>

  <div class="password-card">
    <span class="brand__mark" aria-hidden="true">{{ shop.name | slice: 0 }}</span>
    <h1>{{ shop.name }}</h1>
    <p class="password-tagline">{{ 'password.opening_soon' | t }}</p>

    {%- if shop.password_message != blank -%}
      <div class="rte password-message">{{ shop.password_message }}</div>
    {%- endif -%}

    {% form 'storefront_password' %}
      {%- if form.errors -%}
        <div class="form-errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <label class="field" for="password-input">{{ 'password.password' | t }}</label>
      <input type="password" name="password" id="password-input" autocomplete="current-password">
      <button class="button button--primary button--block" type="submit">{{ 'password.enter' | t }}</button>
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .password-page {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: var(--page-margin);
    background: var(--charcoal-deep);
    color: var(--on-dark);
    overflow: hidden;
  }
  .password-art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--copper-light);
    opacity: 0.1;
  }
  .password-art .engraving {
    width: min(80vh, 620px);
  }
  .password-card {
    position: relative;
    width: min(100%, 400px);
    text-align: center;
  }
  .password-card .brand__mark {
    margin: 0 auto var(--sp-5);
    width: 48px;
    color: var(--copper-light);
    font-size: 1.6rem;
  }
  .password-card h1 {
    margin-bottom: var(--sp-2);
    font-size: clamp(2.4rem, 8vw, 3.6rem);
  }
  .password-tagline {
    margin-bottom: var(--sp-6);
    color: var(--on-dark-muted);
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--fs-lead);
  }
  .password-message {
    margin-bottom: var(--sp-5);
    color: var(--on-dark-muted);
    font-size: var(--fs-sm);
  }
  .password-card form {
    display: grid;
    gap: var(--sp-3);
    text-align: left;
  }
  .password-card .field {
    color: var(--on-dark-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
