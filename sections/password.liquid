{% comment %}
  Landing page shown while the storefront is password protected.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<section class="password-page">
  <div class="password-card">
    <span class="brand-mark" aria-hidden="true">Q</span>
    <h1>{{ shop.name }}</h1>
    <p class="password-tagline">{{ 'password.opening_soon' | t }}</p>

    {%- if shop.password_message != blank -%}
      <div class="rte">{{ shop.password_message }}</div>
    {%- endif -%}

    {% form 'storefront_password' %}
      {%- if form.errors -%}
        <div class="form-errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <label class="field" for="password-input">{{ 'password.password' | t }}</label>
      <input type="password" name="password" id="password-input" autocomplete="current-password">
      <button class="button button--primary" type="submit">{{ 'password.enter' | t }}</button>
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .password-page {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: var(--page-margin);
    background: var(--charcoal-deep);
    color: var(--on-dark);
  }

  .password-card {
    width: min(100%, 420px);
    text-align: center;
  }

  .password-card .brand-mark {
    margin: 0 auto 20px;
    width: 46px;
    border-color: var(--copper-light);
    color: var(--copper-light);
    font-size: 1.8rem;
  }

  .password-card h1 {
    margin-bottom: 6px;
    font-size: clamp(2.6rem, 9vw, 4rem);
  }

  .password-tagline {
    margin-bottom: 28px;
    color: var(--on-dark-muted);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
  }

  .password-card form {
    display: grid;
    gap: 10px;
    text-align: left;
  }

  .password-card .field {
    color: var(--on-dark-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
