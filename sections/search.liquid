<section class="container section search-section">
  <header class="search-hero">
    <p class="eyebrow">{{ 'search.eyebrow' | t }}</p>
    <h1>{{ 'search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label class="visually-hidden" for="SearchInput">{{ 'search.title' | t }}</label>
      <input
        id="SearchInput"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        autocomplete="off"
      >
      <button class="button button--primary" type="submit">{{ 'search.submit' | t }}</button>
    </form>
  </header>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <div class="empty-state">
        <h2>{{ 'search.no_results_html' | t: terms: search.terms }}</h2>
        <p>{{ 'search.no_results_body' | t }}</p>
        <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">
          {{- 'cart.empty_action' | t -}}
        </a>
      </div>
    {%- else -%}
      <p class="search-count">
        {{- 'search.results_for_html' | t: count: search.results_count, terms: search.terms -}}
      </p>

      {%- paginate search.results by section.settings.results_per_page -%}
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, heading_level: 2 %}
            {%- else -%}
              <article class="product-card">
                <a
                  class="product-card__media media"
                  href="{{ item.url }}"
                  aria-label="{{ item.title | escape }}"
                >
                  {%- if item.image -%}
                    {{
                      item.image
                      | image_url: width: 1000
                      | image_tag:
                        loading: 'lazy',
                        widths: '300, 500, 700, 1000',
                        sizes: '(min-width: 990px) 25vw, 50vw',
                        alt: item.title
                    }}
                  {%- else -%}
                    <span class="media-fallback">{% render 'engraving', seed: forloop.index %}</span>
                  {%- endif -%}
                </a>
                <div class="product-card__body">
                  <div>
                    <p class="product-card__kicker">{{ item.object_type }}</p>
                    <h3 class="product-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  </div>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="pagination">{{ paginate | default_pagination }}</div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</section>

{% stylesheet %}
  .search-section {
    padding-top: var(--sp-7);
  }
  .search-hero {
    max-width: 44rem;
    margin-bottom: var(--sp-7);
  }
  .search-form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
  }
  .search-count {
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  @media (max-width: 540px) {
    .search-form {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "label": "t:labels.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
