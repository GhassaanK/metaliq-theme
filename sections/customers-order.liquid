<section class="container page-section narrow-page">
  <header class="page-header account-header">
    <div>
      <p class="eyebrow">{{ 'customer.order.placed_on' | t: date: order.created_at | date: format: 'date' }}</p>
      <h1>{{ 'customer.order.title' | t: name: order.name }}</h1>
    </div>
    <a class="text-link" href="{{ routes.account_url }}">{{ 'customer.order.back' | t }}</a>
  </header>

  <div class="table-scroll">
    <table class="account-table">
      <thead>
        <tr>
          <th>{{ 'customer.order.product' | t }}</th>
          <th>{{ 'customer.order.price' | t }}</th>
          <th>{{ 'customer.order.quantity' | t }}</th>
          <th>{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>
              {{ line_item.title }}
              {%- for property in line_item.properties -%}
                {%- assign first_char = property.first | slice: 0 -%}
                {%- unless property.last == blank or first_char == '_' -%}
                  <span class="order-property">{{ property.first }}: {{ property.last }}</span>
                {%- endunless -%}
              {%- endfor -%}
            </td>
            <td>{{ line_item.price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3">{{ 'customer.order.subtotal' | t }}</td>
          <td>{{ order.subtotal_price | money }}</td>
        </tr>
        {%- for shipping_method in order.shipping_methods -%}
          <tr>
            <td colspan="3">{{ 'customer.order.shipping' | t }} — {{ shipping_method.title }}</td>
            <td>{{ shipping_method.price | money }}</td>
          </tr>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <tr>
            <td colspan="3">{{ 'customer.order.tax' | t }} — {{ tax_line.title }}</td>
            <td>{{ tax_line.price | money }}</td>
          </tr>
        {%- endfor -%}
        <tr>
          <td colspan="3"><strong>{{ 'customer.order.total' | t }}</strong></td>
          <td><strong>{{ order.total_price | money }}</strong></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="order-addresses">
    <div class="account-aside">
      <h2>{{ 'customer.order.billing_address' | t }}</h2>
      {{ order.billing_address | format_address }}
    </div>
    <div class="account-aside">
      <h2>{{ 'customer.order.shipping_address' | t }}</h2>
      {{ order.shipping_address | format_address }}
    </div>
  </div>
</section>

{% render 'account-styles' %}

{% stylesheet %}
  .order-property {
    display: block;
    color: var(--muted);
    font-size: 0.7rem;
    white-space: normal;
  }

  .order-addresses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
    margin-top: 40px;
  }

  .order-addresses h2 {
    margin-bottom: 10px;
    font-size: 1.1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.order",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
