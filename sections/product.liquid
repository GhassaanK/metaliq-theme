{% liquid
  assign current_variant = product.selected_or_first_available_variant

  assign base_width = product.metafields.custom.default_width.value | default: section.settings.default_width
  assign base_height = product.metafields.custom.default_height.value | default: section.settings.default_height

  assign surcharge_product = settings.surcharge_product
  assign surcharge_variant = surcharge_product.variants.first
  assign surcharge_unit = surcharge_variant.price

  comment
    Custom sizing only charges correctly when a surcharge product is configured
    and priced above zero — the theme adds N units of it alongside the piece to
    make up the difference. Without one we never show a scaled price: an
    estimate plus a quote request instead.
  endcomment
  assign can_charge_custom = false
  if settings.custom_size_enabled
    if surcharge_variant != blank
      if surcharge_variant.available
        if surcharge_unit > 0
          assign can_charge_custom = true
        endif
      endif
    endif
  endif

  assign quote_url = settings.quote_page.url | default: routes.root_url
  assign related_collection = product.collections.first | default: collections.all
  assign detail_media = product.media[1] | default: product.featured_media

  assign min_height = settings.custom_size_min
  if min_height < base_height
    assign min_height = base_height
  endif
%}

<section class="container section product-section">
  {% render 'breadcrumbs' %}

  <div
    class="product-layout"
    data-product-calculator
    data-base-width="{{ base_width }}"
    data-base-height="{{ base_height }}"
    data-min-height="{{ min_height }}"
    data-max-height="{{ settings.custom_size_max }}"
    data-pricing-basis="{{ section.settings.pricing_basis }}"
    data-money-format="{{ shop.money_format | strip_html | escape }}"
    data-can-charge="{{ can_charge_custom }}"
    data-quote-url="{{ quote_url }}"
    {% if can_charge_custom %}
      data-surcharge-id="{{ surcharge_variant.id }}"
      data-surcharge-unit="{{ surcharge_unit }}"
    {% endif %}
  >
    <div class="product-gallery" data-product-gallery>
      {%- if product.media.size > 0 -%}
        <div class="product-gallery__thumbs" role="list" aria-label="{{ 'product.gallery_thumbnails' | t }}">
          {%- for media in product.media -%}
            <button
              class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
              type="button"
              aria-label="{{ 'product.view_image' | t: index: forloop.index }}"
              aria-controls="ProductMedia-{{ section.id }}-{{ media.id }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              data-gallery-thumbnail="{{ media.id }}"
              role="listitem"
            >
              {{
                media.preview_image
                | image_url: width: 180
                | image_tag:
                  loading: 'lazy',
                  widths: '90, 140, 180',
                  sizes: '84px',
                  alt: ''
              }}
            </button>
          {%- endfor -%}
        </div>

        <div class="product-gallery__stage">
          {%- for media in product.media -%}
            {%- if forloop.first -%}
              {%- assign media_loading = 'eager' -%}
            {%- else -%}
              {%- assign media_loading = 'lazy' -%}
            {%- endif -%}
            <div
              class="product-gallery__item media"
              id="ProductMedia-{{ section.id }}-{{ media.id }}"
              data-gallery-media="{{ media.id }}"
              {% unless forloop.first %}hidden{% endunless %}
            >
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {{
                    media
                    | image_url: width: 1800
                    | image_tag:
                      loading: media_loading,
                      widths: '500, 800, 1100, 1400, 1800',
                      sizes: '(min-width: 1050px) 48vw, 100vw',
                      alt: media.alt | default: product.title
                  }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="product-gallery__stage">
          <div class="product-gallery__item media media-fallback">
            {% render 'engraving', seed: product.id, label: product.title %}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="product-details">
      <p class="eyebrow">{{ 'product.eyebrow' | t }}</p>
      <h1 class="product-title">{{ product.title }}</h1>

      <div class="product-price price" data-product-price data-base-price="{{ current_variant.price }}">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s>{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
        {{ current_variant.price | money }}
      </div>

      {%- if product.description != blank -%}
        <div class="product-description">{{ product.description | strip_html | truncatewords: 38 }}</div>
      {%- endif -%}

      {% form 'product', product, class: 'product-form', novalidate: 'novalidate' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          <label class="field" for="Variant-{{ section.id }}">
            {{ 'product.option' | t }}
            <select id="Variant-{{ section.id }}" data-variant-select>
              {%- for variant in product.variants -%}
                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price }}"
                  {% if variant == current_variant %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title }}
                  {%- unless variant.available %} — {{ 'product.sold_out' | t }}{% endunless -%}
                </option>
              {%- endfor -%}
            </select>
          </label>
        {%- endunless -%}

        {%- if settings.custom_size_enabled -%}
          <fieldset class="size-options">
            <legend>{{ 'product.size' | t }}</legend>

            <div class="segmented">
              <label>
                <input type="radio" name="properties[_Size type]" value="Standard" checked data-size-mode>
                <span>{{ 'product.size_standard' | t }}</span>
              </label>
              <label>
                <input type="radio" name="properties[_Size type]" value="Custom" data-size-mode>
                <span>{{ 'product.size_custom' | t }}</span>
              </label>
            </div>

            <p class="standard-size">
              {{- 'product.standard_size_html' | t: width: base_width, height: base_height -}}
            </p>

            <div class="custom-size" data-custom-size hidden>
              <label class="field" for="CustomHeight-{{ section.id }}">
                {{ 'product.height' | t }}
                <input
                  id="CustomHeight-{{ section.id }}"
                  type="number"
                  inputmode="decimal"
                  min="{{ min_height }}"
                  max="{{ settings.custom_size_max }}"
                  step="0.1"
                  value="{{ base_height }}"
                  data-custom-height
                >
              </label>
              <p class="custom-size__readout">
                {{ 'product.width_readout' | t }}:
                <strong data-calculated-width>{{ base_width }}</strong>
                {{ 'product.feet' | t }}
              </p>
              <p class="field-note">{{ 'product.proportional_note' | t }}</p>
              <p
                class="field-note field-note--error"
                data-size-error
                data-message="{{ 'product.size_range_error' | t: min: min_height, max: settings.custom_size_max }}"
                hidden
              ></p>
            </div>
          </fieldset>

          <input
            type="hidden"
            name="properties[{{ 'product.dimensions' | t }}]"
            value="{{ base_width }} × {{ base_height }} ft"
            data-dimensions-property
            disabled
          >
          <input type="hidden" name="properties[_size_group]" value="" data-group-property disabled>
        {%- endif -%}

        <div class="purchase-row">
          <label class="field quantity-label" for="Quantity-{{ section.id }}">
            {{ 'general.quantity' | t }}
            <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1">
          </label>

          <button
            class="button button--primary purchase-row__add"
            type="submit"
            data-add-button
            data-adding="{{ 'product.adding' | t }}"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}
              {{ 'product.add_to_cart' | t }}
            {%- else -%}
              {{ 'product.sold_out' | t }}
            {%- endif -%}
          </button>

          <a class="button button--secondary purchase-row__quote" href="{{ quote_url }}" data-quote-button hidden>
            {{- 'product.request_size' | t -}}
          </a>
        </div>

        <p class="estimate-line" data-estimate hidden>
          <span>{{ 'product.estimate' | t }}</span>
          <strong data-estimate-value></strong>
        </p>

        <p class="pricing-note" data-pricing-note hidden>
          {%- if can_charge_custom -%}
            {{ 'product.custom_priced_note' | t }}
          {%- else -%}
            {{ 'product.estimate_note' | t }}
          {%- endif -%}
        </p>

        <p class="form-errors" data-add-error hidden role="alert">{{ 'product.add_error' | t }}</p>
      {% endform %}

      <ul class="product-assurances">
        {%- for i in (1..3) -%}
          {%- assign t_key = 'product.assurance_' | append: i | append: '_title' -%}
          {%- assign b_key = 'product.assurance_' | append: i | append: '_body' -%}
          <li>
            <strong>{{ t_key | t }}</strong>
            <span>{{ b_key | t }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <div class="product-information section--product">
    <div class="product-tabs" data-product-tabs>
      <div class="product-tabs__list" role="tablist" aria-label="{{ 'product.information' | t }}">
        <button class="product-tabs__tab is-active" type="button" role="tab" aria-selected="true" aria-controls="ProductTabDetails-{{ section.id }}" id="ProductTabButtonDetails-{{ section.id }}" data-product-tab="details">
          {{ 'product.details' | t }}
        </button>
        <button class="product-tabs__tab" type="button" role="tab" aria-selected="false" aria-controls="ProductTabMaterials-{{ section.id }}" id="ProductTabButtonMaterials-{{ section.id }}" data-product-tab="materials">
          {{ 'product.materials' | t }}
        </button>
        <button class="product-tabs__tab" type="button" role="tab" aria-selected="false" aria-controls="ProductTabSizing-{{ section.id }}" id="ProductTabButtonSizing-{{ section.id }}" data-product-tab="sizing">
          {{ 'product.sizing_installation' | t }}
        </button>
        <button class="product-tabs__tab" type="button" role="tab" aria-selected="false" aria-controls="ProductTabShipping-{{ section.id }}" id="ProductTabButtonShipping-{{ section.id }}" data-product-tab="shipping">
          {{ 'product.shipping_returns' | t }}
        </button>
      </div>

      <div class="product-tabs__panel rte" id="ProductTabDetails-{{ section.id }}" role="tabpanel" aria-labelledby="ProductTabButtonDetails-{{ section.id }}" data-product-panel="details">
        {{ product.description }}
      </div>
      <div class="product-tabs__panel rte" id="ProductTabMaterials-{{ section.id }}" role="tabpanel" aria-labelledby="ProductTabButtonMaterials-{{ section.id }}" data-product-panel="materials" hidden>
        {%- if product.metafields.custom.materials != blank -%}
          {{ product.metafields.custom.materials | metafield_tag }}
        {%- else -%}
          {{ section.settings.materials_text }}
        {%- endif -%}
      </div>
      <div class="product-tabs__panel rte" id="ProductTabSizing-{{ section.id }}" role="tabpanel" aria-labelledby="ProductTabButtonSizing-{{ section.id }}" data-product-panel="sizing" hidden>
        <p>{{ 'product.standard_size_html' | t: width: base_width, height: base_height }}</p>
        {{ section.settings.installation_text }}
      </div>
      <div class="product-tabs__panel rte" id="ProductTabShipping-{{ section.id }}" role="tabpanel" aria-labelledby="ProductTabButtonShipping-{{ section.id }}" data-product-panel="shipping" hidden>
        {{ section.settings.shipping_text }}
      </div>
    </div>

    <div class="product-information__media media">
      {%- if detail_media != blank -%}
        {{
          detail_media.preview_image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '500, 800, 1100, 1400',
            sizes: '(min-width: 860px) 50vw, 100vw',
            alt: detail_media.alt | default: product.title
        }}
      {%- else -%}
        <span class="media-fallback">{% render 'engraving', seed: product.id %}</span>
      {%- endif -%}
    </div>
  </div>

  {%- if related_collection.products_count > 1 -%}
    <section class="product-related section--product">
      <div class="section-head">
        <div>
          <p class="eyebrow">{{ 'product.related_eyebrow' | t }}</p>
          <h2>{{ 'product.related_title' | t }}</h2>
        </div>
        <a class="link" href="{{ related_collection.url }}">{{ 'product.related_view_all' | t }}</a>
      </div>
      <div class="product-grid">
        {%- assign related_count = 0 -%}
        {%- for related_product in related_collection.products limit: 5 -%}
          {%- unless related_product.id == product.id -%}
            {% render 'product-card', product: related_product, sizes: '(min-width: 1100px) 23vw, (min-width: 620px) 45vw, 50vw' %}
            {%- assign related_count = related_count | plus: 1 -%}
            {%- if related_count == 4 -%}{%- break -%}{%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
</section>

{% stylesheet %}
  .product-section {
    padding-top: var(--sp-6);
  }

  .product-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(340px, 0.82fr);
    align-items: start;
    gap: clamp(28px, 5vw, 72px);
  }

  .product-gallery {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    align-items: start;
    gap: 16px;
    min-width: 0;
  }
  .product-gallery__thumbs {
    display: grid;
    gap: 12px;
    max-height: 720px;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .product-gallery__thumbs::-webkit-scrollbar {
    display: none;
  }
  .product-gallery__thumb {
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    cursor: pointer;
    opacity: 0.62;
    transition: border-color 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .product-gallery__thumb:hover,
  .product-gallery__thumb.is-active {
    border-color: var(--copper);
    opacity: 1;
  }
  .product-gallery__thumb:focus-visible {
    outline: 2px solid var(--copper);
    outline-offset: 3px;
  }
  .product-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-gallery__stage {
    min-width: 0;
    overflow: hidden;
    border-radius: 8px;
  }
  .product-gallery__item {
    aspect-ratio: 4 / 5;
  }
  .product-gallery__item[hidden] {
    display: none;
  }
  .product-gallery__item img,
  .product-gallery__item video,
  .product-gallery__item model-viewer {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-gallery__item.media-fallback .engraving {
    width: 55%;
  }

  .product-details {
    position: sticky;
    top: calc(var(--header-height) + var(--sp-6));
    min-width: 0;
  }
  .product-title {
    margin: var(--sp-2) 0 var(--sp-4);
  }
  .product-price {
    margin-bottom: var(--sp-5);
    font-size: var(--fs-h4);
  }
  .product-description {
    margin-bottom: var(--sp-5);
    color: var(--muted);
    font-size: var(--fs-sm);
    line-height: 1.65;
  }

  .product-form {
    display: grid;
    gap: var(--sp-5);
    padding-block: var(--sp-5);
    border-block: 1px solid var(--line);
  }

  .size-options {
    display: grid;
    gap: var(--sp-2);
    padding: 0;
    border: 0;
  }
  .size-options legend {
    font-size: var(--fs-sm);
    font-weight: 500;
  }
  .segmented {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-2);
  }
  .segmented input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .segmented span {
    display: grid;
    place-items: center;
    min-height: 46px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: var(--fs-sm);
    cursor: pointer;
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease), color 0.15s var(--ease);
  }
  .segmented input:checked + span {
    border-color: var(--copper);
    box-shadow: inset 0 0 0 1px var(--copper);
    color: var(--copper);
  }
  .segmented input:focus-visible + span {
    outline: 2px solid var(--copper);
    outline-offset: 3px;
  }

  .standard-size {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .custom-size {
    display: grid;
    gap: var(--sp-2);
    margin-top: var(--sp-2);
    padding: var(--sp-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .custom-size[hidden] {
    display: none;
  }
  .custom-size__readout {
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .estimate-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
  }
  .estimate-line span {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .estimate-line strong {
    color: var(--copper);
    font-size: var(--fs-h4);
  }
  .pricing-note {
    padding: var(--sp-3) var(--sp-4);
    border-left: 2px solid var(--copper);
    background: color-mix(in srgb, var(--copper) 8%, var(--surface));
    font-size: 0.74rem;
  }

  .purchase-row {
    display: grid;
    grid-template-columns: 88px 1fr;
    align-items: end;
    gap: var(--sp-2);
  }
  .quantity-label input {
    margin-top: 6px;
  }
  .purchase-row__add,
  .purchase-row__quote {
    min-height: 56px;
  }
  .purchase-row__quote {
    grid-column: 2;
  }

  .product-assurances {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: var(--sp-5);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--line);
  }
  .product-assurances li {
    display: grid;
    gap: 4px;
    padding: 0;
    border: 0;
    font-size: 0.68rem;
  }
  .product-assurances span {
    color: var(--muted);
  }

  .section--product {
    margin-top: clamp(64px, 9vw, 112px);
    padding-top: clamp(48px, 6vw, 72px);
    border-top: 1px solid var(--line);
  }
  .product-information {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
    gap: clamp(32px, 6vw, 84px);
  }
  .product-tabs__list {
    display: flex;
    gap: 28px;
    margin-bottom: 28px;
    overflow-x: auto;
    border-bottom: 1px solid var(--line);
    scrollbar-width: none;
  }
  .product-tabs__list::-webkit-scrollbar {
    display: none;
  }
  .product-tabs__tab {
    position: relative;
    flex: 0 0 auto;
    padding: 0 0 14px;
    color: var(--muted);
    font-size: 0.75rem;
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }
  .product-tabs__tab::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--copper);
    transform: scaleX(0);
    transition: transform 0.2s var(--ease);
  }
  .product-tabs__tab:hover,
  .product-tabs__tab.is-active {
    color: var(--ink);
  }
  .product-tabs__tab.is-active::after {
    transform: scaleX(1);
  }
  .product-tabs__panel {
    min-height: 220px;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .product-tabs__panel[hidden] {
    display: none;
  }
  .product-information__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
  }
  .product-information__media img,
  .product-information__media .media-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-related {
    margin-bottom: var(--section);
  }

  @media (max-width: 1050px) {
    .product-layout {
      grid-template-columns: minmax(0, 1fr) minmax(320px, 380px);
      gap: 32px;
    }
    .product-gallery {
      grid-template-columns: 68px minmax(0, 1fr);
    }
    .product-assurances {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 860px) {
    .product-layout {
      grid-template-columns: 1fr;
    }
    .product-details {
      position: static;
    }
    .product-gallery {
      grid-template-columns: 1fr;
    }
    .product-gallery__stage {
      grid-row: 1;
    }
    .product-gallery__thumbs {
      grid-row: 2;
      grid-template-columns: repeat(auto-fit, 64px);
      grid-auto-flow: column;
      justify-content: start;
      max-height: none;
      overflow-x: auto;
      overflow-y: hidden;
    }
    .product-information {
      grid-template-columns: 1fr;
    }
    .product-information__media {
      grid-row: 1;
    }
    .product-tabs__panel {
      min-height: 0;
    }
    .product-related .product-grid {
      --cols: 2;
    }
  }
  @media (max-width: 480px) {
    .product-assurances li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "range",
      "id": "default_width",
      "label": "t:labels.default_width",
      "min": 0.5,
      "max": 12,
      "step": 0.5,
      "unit": "ft",
      "default": 2
    },
    {
      "type": "range",
      "id": "default_height",
      "label": "t:labels.default_height",
      "min": 0.5,
      "max": 12,
      "step": 0.5,
      "unit": "ft",
      "default": 2
    },
    {
      "type": "select",
      "id": "pricing_basis",
      "label": "t:labels.pricing_basis",
      "options": [
        { "value": "area", "label": "t:options.pricing.area" },
        { "value": "height", "label": "t:options.pricing.height" }
      ],
      "default": "area"
    },
    {
      "type": "header",
      "content": "Product information"
    },
    {
      "type": "richtext",
      "id": "materials_text",
      "label": "Default materials",
      "default": "<p>Precision-cut metal with a durable finished surface. Product-specific material details can be added through the custom.materials metafield.</p>"
    },
    {
      "type": "richtext",
      "id": "installation_text",
      "label": "Installation guidance",
      "default": "<p>Mounting requirements depend on the artwork size and wall construction. Installation guidance is included with your order.</p>"
    },
