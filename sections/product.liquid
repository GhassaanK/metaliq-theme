{% liquid
  assign current_variant = product.selected_or_first_available_variant

  assign related_collection = product.collections.first | default: collections.all
  assign detail_media = product.media[1] | default: product.featured_media

  assign factual_description = product.description
  assign factual_description = factual_description | replace: ' without fading or chipping', ''
  assign factual_description = factual_description | replace: 'Ready to hang out of the box.', 'Contact us if you need mounting guidance for your wall.'
  assign factual_description = factual_description | replace: 'Locked this format in for all upcoming listings.', ''
  assign custom_size_message = 'product.custom_size_whatsapp_message' | t: product_title: product.title | url_encode
  assign custom_size_url = 'https://wa.me/923172920243?text=' | append: custom_size_message
%}

<section class="container section product-section">
  {% render 'breadcrumbs' %}

  <div
    class="product-layout"
    data-product-purchase
    data-money-format="{{ shop.money_format | strip_html | escape }}"
  >
    <div class="product-gallery" data-product-gallery>
      {%- if product.media.size > 0 -%}
        <div class="product-gallery__thumbs" role="list" aria-label="{{ 'product.gallery_thumbnails' | t }}">
          {%- for media in product.media -%}
            <button
              class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
              type="button"
              aria-label="{{ 'product.view_image' | t: index: forloop.index }}"
              aria-controls="ProductMedia-{{ section.id }}-{{ media.id }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              data-gallery-thumbnail="{{ media.id }}"
              role="listitem"
            >
              {{
                media.preview_image
                | image_url: width: 180
                | image_tag:
                  loading: 'lazy',
                  widths: '90, 140, 180',
                  sizes: '84px',
                  alt: ''
              }}
            </button>
          {%- endfor -%}
        </div>

        <div class="product-gallery__stage">
          {%- for media in product.media -%}
            {%- if forloop.first -%}
              {%- assign media_loading = 'eager' -%}
            {%- else -%}
              {%- assign media_loading = 'lazy' -%}
            {%- endif -%}
            <div
              class="product-gallery__item media"
              id="ProductMedia-{{ section.id }}-{{ media.id }}"
              data-gallery-media="{{ media.id }}"
              {% unless forloop.first %}hidden{% endunless %}
            >
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {{
                    media
                    | image_url: width: 1800
                    | image_tag:
                      loading: media_loading,
                      widths: '500, 800, 1100, 1400, 1800',
                      sizes: '(min-width: 1050px) 48vw, 100vw',
                      alt: media.alt | default: product.title
                  }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="product-gallery__stage">
          <div class="product-gallery__item media media-fallback">
            {% render 'engraving', seed: product.id, label: product.title %}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="product-details">
      <p class="eyebrow">{{ 'product.eyebrow' | t }}</p>
      <h1 class="product-title">{{ product.title }}</h1>

      <div class="product-price price" data-product-price data-base-price="{{ current_variant.price }}">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s>{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
        {{ current_variant.price | money }}
      </div>

      {%- if factual_description != blank -%}
        <div class="product-description rte">{{ factual_description }}</div>
      {%- endif -%}

      {% form 'product', product, class: 'product-form', novalidate: 'novalidate' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          <label class="field" for="Variant-{{ section.id }}">
            {{ 'product.option' | t }}
            <select id="Variant-{{ section.id }}" data-variant-select>
              {%- for variant in product.variants -%}
                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price }}"
                  {% if variant == current_variant %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title }}
                  {%- unless variant.available %} — {{ 'product.sold_out' | t }}{% endunless -%}
                </option>
              {%- endfor -%}
            </select>
          </label>
        {%- endunless -%}

        <div class="purchase-row">
          <label class="field quantity-label" for="Quantity-{{ section.id }}">
            {{ 'general.quantity' | t }}
            <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1">
          </label>

          <button
            class="button button--primary purchase-row__add"
            type="submit"
            data-add-button
            data-adding="{{ 'product.adding' | t }}"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}
              {{ 'product.add_to_cart' | t }}
            {%- else -%}
              {{ 'product.sold_out' | t }}
            {%- endif -%}
          </button>

        </div>

        <a class="product-custom-size-link" href="{{ custom_size_url }}" target="_blank" rel="noopener">
          <span class="product-custom-size-link__icon" aria-hidden="true">{% render 'icon', name: 'whatsapp' %}</span>
          <span class="product-custom-size-link__copy">
            <small>{{ 'product.custom_size_eyebrow' | t }}</small>
            <strong>{{ 'product.custom_size_request' | t }}</strong>
          </span>
          <span class="product-custom-size-link__arrow" aria-hidden="true">&nearr;</span>
        </a>

        <p class="form-errors" data-add-error hidden role="alert">{{ 'product.add_error' | t }}</p>
      {% endform %}

      {%- liquid
        assign product_whatsapp_label = 'product.whatsapp_cta' | t
        assign product_whatsapp_message = 'product.whatsapp_message' | t: product_title: product.title
      -%}
      {% render 'whatsapp-link', label: product_whatsapp_label, message: product_whatsapp_message, css_class: 'product-whatsapp' %}

      <ul class="product-assurances">
        {%- for i in (1..3) -%}
          {%- assign t_key = 'product.assurance_' | append: i | append: '_title' -%}
          {%- assign b_key = 'product.assurance_' | append: i | append: '_body' -%}
          <li>
            <strong>{{ t_key | t }}</strong>
            <span>{{ b_key | t }}</span>
          </li>
        {%- endfor -%}
      </ul>

      <aside class="product-commerce-note" aria-label="{{ 'product.ordering_note_label' | t }}">
        <p><strong>{{ 'product.cod_title' | t }}</strong>
          {%- if settings.online_payments_active -%}
            {{ 'product.payment_active_body' | t: provider: settings.payment_provider_name }}
          {%- else -%}
            {{ 'product.cod_body' | t: provider: settings.payment_provider_name }}
          {%- endif -%}
        </p>
        <p>{{ 'product.delivery_body' | t }}</p>
        <div>
          <a href="/pages/ordering-and-payments">{{ 'general.ordering_payments' | t }}</a>
          <a href="/policies/shipping-policy">{{ 'general.shipping_policy' | t }}</a>
          <a href="/policies/refund-policy">{{ 'general.refund_policy' | t }}</a>
        </div>
      </aside>
    </div>
  </div>

  <div class="product-information section--product">
    <div class="product-tabs" data-product-tabs>
      <div class="product-tabs__list" role="tablist" aria-label="{{ 'product.information' | t }}">
        <button class="product-tabs__tab is-active" type="button" role="tab" aria-selected="true" aria-controls="ProductTabDetails-{{ section.id }}" id="ProductTabButtonDetails-{{ section.id }}" data-product-tab="details">
          {{ 'product.details' | t }}
        </button>
        <button class="product-tabs__tab" type="button" role="tab" aria-selected="false" aria-controls="ProductTabMaterials-{{ section.id }}" id="ProductTabButtonMaterials-{{ section.id }}" data-product-tab="materials">
          {{ 'product.materials' | t }}
        </button>
        <button class="product-tabs__tab" type="button" role="tab" aria-selected="false" aria-controls="ProductTabSizing-{{ section.id }}" id="ProductTabButtonSizing-{{ section.id }}" data-product-tab="sizing">
          {{ 'product.sizing_installation' | t }}
        </button>
        <button class="product-tabs__tab" type="button" role="tab" aria-selected="false" aria-controls="ProductTabShipping-{{ section.id }}" id="ProductTabButtonShipping-{{ section.id }}" data-product-tab="shipping">
          {{ 'product.shipping_returns' | t }}
        </button>
      </div>

      <div class="product-tabs__panel rte" id="ProductTabDetails-{{ section.id }}" role="tabpanel" aria-labelledby="ProductTabButtonDetails-{{ section.id }}" data-product-panel="details">
        {{ factual_description }}
      </div>
      <div class="product-tabs__panel rte" id="ProductTabMaterials-{{ section.id }}" role="tabpanel" aria-labelledby="ProductTabButtonMaterials-{{ section.id }}" data-product-panel="materials" hidden>
        {%- if product.metafields.custom.materials != blank -%}
          {{ product.metafields.custom.materials | metafield_tag }}
        {%- else -%}
          {{ section.settings.materials_text }}
        {%- endif -%}
      </div>
      <div class="product-tabs__panel rte" id="ProductTabSizing-{{ section.id }}" role="tabpanel" aria-labelledby="ProductTabButtonSizing-{{ section.id }}" data-product-panel="sizing" hidden>
        {{ section.settings.installation_text }}
      </div>
      <div class="product-tabs__panel rte" id="ProductTabShipping-{{ section.id }}" role="tabpanel" aria-labelledby="ProductTabButtonShipping-{{ section.id }}" data-product-panel="shipping" hidden>
        {{ section.settings.shipping_text }}
        <p>{{ 'product.delivery_body' | t }}</p>
        <p><a href="/policies/shipping-policy">{{ 'product.read_shipping_policy' | t }}</a></p>
      </div>
    </div>

    <div class="product-information__media media">
      {%- if detail_media != blank -%}
        {{
          detail_media.preview_image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '500, 800, 1100, 1400',
            sizes: '(min-width: 860px) 50vw, 100vw',
            alt: detail_media.alt | default: product.title
        }}
      {%- else -%}
        <span class="media-fallback">{% render 'engraving', seed: product.id %}</span>
      {%- endif -%}
    </div>
  </div>

  {%- if related_collection.products_count > 1 -%}
    <section class="product-related section--product">
      <div class="section-head">
        <div>
          <p class="eyebrow">{{ 'product.related_eyebrow' | t }}</p>
          <h2>{{ 'product.related_title' | t }}</h2>
        </div>
        <a class="link" href="{{ related_collection.url }}">{{ 'product.related_view_all' | t }}</a>
      </div>
      <div class="product-grid">
        {%- assign related_count = 0 -%}
        {%- for related_product in related_collection.products limit: 5 -%}
          {%- unless related_product.id == product.id -%}
            {% render 'product-card', product: related_product, sizes: '(min-width: 1100px) 23vw, (min-width: 620px) 45vw, 50vw' %}
            {%- assign related_count = related_count | plus: 1 -%}
            {%- if related_count == 4 -%}{%- break -%}{%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
</section>

{% stylesheet %}
  .product-section {
    padding-top: var(--sp-6);
  }

  .product-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(340px, 0.82fr);
    align-items: start;
    gap: clamp(28px, 5vw, 72px);
  }

  .product-gallery {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    align-items: start;
    gap: 16px;
    min-width: 0;
  }
  .product-gallery__thumbs {
    display: grid;
    gap: 12px;
    max-height: 720px;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .product-gallery__thumbs::-webkit-scrollbar {
    display: none;
  }
  .product-gallery__thumb {
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    cursor: pointer;
    opacity: 0.62;
    transition: border-color 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .product-gallery__thumb:hover,
  .product-gallery__thumb.is-active {
    border-color: var(--copper);
    opacity: 1;
  }
  .product-gallery__thumb:focus-visible {
    outline: 2px solid var(--copper);
    outline-offset: 3px;
  }
  .product-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-gallery__stage {
    min-width: 0;
    overflow: hidden;
    border-radius: 8px;
  }
  .product-gallery__item {
    aspect-ratio: 4 / 5;
  }
  .product-gallery__item[hidden] {
    display: none;
  }
  .product-gallery__item img,
  .product-gallery__item video,
  .product-gallery__item model-viewer {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-gallery__item.media-fallback .engraving {
    width: 55%;
  }

  .product-details {
    position: sticky;
    top: calc(var(--header-height) + var(--sp-6));
    min-width: 0;
  }
  .product-title {
    margin: var(--sp-2) 0 var(--sp-4);
  }
  .product-price {
    margin-bottom: var(--sp-5);
    font-size: var(--fs-h4);
  }
  .product-description {
    margin-bottom: var(--sp-5);
    color: var(--muted);
    font-size: var(--fs-sm);
    line-height: 1.65;
  }

  .product-form {
    display: grid;
    gap: var(--sp-5);
    padding-block: var(--sp-5);
    border-block: 1px solid var(--line);
  }

  .purchase-row {
    display: grid;
    grid-template-columns: 88px 1fr;
    align-items: end;
    gap: var(--sp-2);
  }
  .quantity-label input {
    margin-top: 6px;
  }
  .purchase-row__add {
    min-height: 56px;
  }
  .product-custom-size-link {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) auto;
    align-items: center;
    gap: 13px;
    width: 100%;
    min-height: 68px;
    padding: 11px 15px;
    border: 1.5px solid var(--copper);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--copper) 11%, var(--surface));
    color: var(--ink);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.14);
    transition: transform 0.2s var(--ease), background 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .product-custom-size-link:hover,
  .product-custom-size-link:focus-visible {
    background: color-mix(in srgb, var(--copper) 19%, var(--surface));
    box-shadow: 0 11px 30px rgb(0 0 0 / 0.22);
    transform: translateY(-2px);
  }
  .product-custom-size-link__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
  }
  .product-custom-size-link__icon .icon {
    width: 21px;
    height: 21px;
  }
  .product-custom-size-link__copy {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .product-custom-size-link__copy small {
    color: var(--copper);
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .product-custom-size-link__copy strong {
    font-size: var(--fs-sm);
    line-height: 1.35;
  }
  .product-custom-size-link__arrow {
    color: var(--copper);
    font-size: 1.15rem;
    transition: transform 0.2s var(--ease);
  }
  .product-custom-size-link:hover .product-custom-size-link__arrow,
  .product-custom-size-link:focus-visible .product-custom-size-link__arrow {
    transform: translate(2px, -2px);
  }
  .product-whatsapp {
    margin-top: var(--sp-4);
  }

  .product-assurances {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: var(--sp-5);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--line);
  }
  .product-assurances li {
    display: grid;
    gap: 4px;
    padding: 0;
    border: 0;
    font-size: 0.68rem;
  }
  .product-commerce-note {
    display: grid;
    gap: 9px;
    margin-top: var(--sp-5);
    padding: var(--sp-4);
    border: 1px solid var(--line);
    border-left: 2px solid var(--copper);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.55;
  }
  .product-commerce-note strong { color: var(--ink); }
  .product-commerce-note div { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 3px; }
  .product-commerce-note a { color: var(--copper); text-decoration: underline; text-underline-offset: 3px; }
  .product-assurances span {
    color: var(--muted);
  }

  .section--product {
    margin-top: clamp(64px, 9vw, 112px);
    padding-top: clamp(48px, 6vw, 72px);
    border-top: 1px solid var(--line);
  }
  .product-information {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
    gap: clamp(32px, 6vw, 84px);
  }
  .product-tabs__list {
    display: flex;
    gap: 28px;
    margin-bottom: 28px;
    overflow-x: auto;
    border-bottom: 1px solid var(--line);
    scrollbar-width: none;
  }
  .product-tabs__list::-webkit-scrollbar {
    display: none;
  }
  .product-tabs__tab {
    position: relative;
    flex: 0 0 auto;
    padding: 0 0 14px;
    color: var(--muted);
    font-size: 0.75rem;
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }
  .product-tabs__tab::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--copper);
    transform: scaleX(0);
    transition: transform 0.2s var(--ease);
  }
  .product-tabs__tab:hover,
  .product-tabs__tab.is-active {
    color: var(--ink);
  }
  .product-tabs__tab.is-active::after {
    transform: scaleX(1);
  }
  .product-tabs__panel {
    min-height: 220px;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .product-tabs__panel[hidden] {
    display: none;
  }
  .product-information__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
  }
  .product-information__media img,
  .product-information__media .media-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-related {
    margin-bottom: var(--section);
  }

  @media (max-width: 1050px) {
    .product-layout {
      grid-template-columns: minmax(0, 1fr) minmax(320px, 380px);
      gap: 32px;
    }
    .product-gallery {
      grid-template-columns: 68px minmax(0, 1fr);
    }
    .product-assurances {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 860px) {
    .product-layout {
      grid-template-columns: 1fr;
    }
    .product-details {
      position: static;
    }
    .product-gallery {
      grid-template-columns: 1fr;
    }
    .product-gallery__stage {
      grid-row: 1;
    }
    .product-gallery__thumbs {
      grid-row: 2;
      grid-template-columns: repeat(auto-fit, 64px);
      grid-auto-flow: column;
      justify-content: start;
      max-height: none;
      overflow-x: auto;
      overflow-y: hidden;
    }
    .product-information {
      grid-template-columns: 1fr;
    }
    .product-information__media {
      grid-row: 1;
    }
    .product-tabs__panel {
      min-height: 0;
    }
    .product-related .product-grid {
      --cols: 2;
    }
  }
  @media (max-width: 480px) {
    .product-assurances li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "header",
      "content": "Product information"
    },
    {
      "type": "richtext",
      "id": "materials_text",
      "label": "Default materials",
      "default": "<p>Powder-coated mild steel with a matte black finish.</p>"
    },
    {
      "type": "richtext",
      "id": "installation_text",
      "label": "Installation guidance",
      "default": "<p>Mounting requirements depend on the artwork dimensions and wall construction. Review the product description and contact us before ordering if you need mounting guidance.</p>"
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Shipping and returns",
      "default": "<p>Each piece is made to order and packed for delivery. See the estimates below and review the Shipping and Refund Policies before ordering.</p>"
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
