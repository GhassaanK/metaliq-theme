{% assign current_variant = product.selected_or_first_available_variant %}
{% assign base_width = product.metafields.custom.default_width.value | default: 2 %}
{% assign base_height = product.metafields.custom.default_height.value | default: 2 %}
<section class="container page-section">{% render 'breadcrumbs' %}<div class="product-layout" data-product-calculator data-base-width="{{ base_width }}" data-base-height="{{ base_height }}" data-currency="{{ cart.currency.iso_code }}" data-locale="{{ request.locale.iso_code }}">
  <div class="product-gallery">{% for media in product.media %}<div class="product-media">{% if media.media_type == 'image' %}{{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 58vw, 100vw' }}{% else %}{{ media | media_tag }}{% endif %}</div>{% else %}<div class="product-media">{{ 'product-1' | placeholder_svg_tag }}</div>{% endfor %}</div>
  <div class="product-details"><p class="eyebrow">Made to order</p><h1>{{ product.title }}</h1><div class="product-price price" data-product-price data-base-price="{{ current_variant.price }}">{{ current_variant.price | money }}</div>{% if product.description != blank %}<div class="rte product-description">{{ product.description }}</div>{% endif %}
    {% form 'product', product, class: 'product-form' %}
      {% unless product.has_only_default_variant %}<label for="Variant-{{ section.id }}">Finish or option</label><select id="Variant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ current_variant.id }}">{% endunless %}
      <fieldset class="size-options"><legend>Size</legend><div class="segmented"><label><input type="radio" name="properties[_Size type]" value="Standard" checked data-size-mode><span>Standard</span></label><label><input type="radio" name="properties[_Size type]" value="Custom" data-size-mode><span>Custom size</span></label></div><p class="standard-size">Standard size: <strong>{{ base_width }} × {{ base_height }} ft</strong></p>
        <div class="custom-size" data-custom-size hidden><label for="CustomHeight-{{ section.id }}">Height (ft)</label><div class="dimension-row"><input id="CustomHeight-{{ section.id }}" type="number" inputmode="decimal" min="0.5" max="20" step="0.1" value="{{ base_height }}" data-custom-height><span>Width: <strong data-calculated-width>{{ base_width }}</strong> ft</span></div><p class="field-note">Width stays proportional to the original artwork.</p></div>
      </fieldset>
      <input type="hidden" name="properties[Dimensions]" value="{{ base_width }} × {{ base_height }} ft" data-dimensions-property><input type="hidden" name="properties[Calculated price]" value="{{ current_variant.price | money }}" data-price-property>
      <div class="purchase-row"><label class="quantity-label" for="Quantity-{{ section.id }}">Qty<input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1"></label><button class="button button--primary add-button" type="submit"{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</button></div>
      <p class="pricing-note" data-pricing-note hidden>Your custom dimensions are recorded with the piece and confirmed before production.</p>
    {% endform %}
    <div class="product-assurances"><p><strong>Precision cut</strong><span>Clean detail, engineered in steel</span></p><p><strong>Made for your wall</strong><span>Custom proportions calculated live</span></p><p><strong>Secure checkout</strong><span>Processed by Shopify</span></p></div>
  </div>
</div></section>
{% schema %}{"name":"t:general.product","settings":[],"disabled_on":{"groups":["header","footer"]}}{% endschema %}
