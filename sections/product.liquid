{% liquid
  assign current_variant = product.selected_or_first_available_variant

  assign base_width = product.metafields.custom.default_width.value | default: section.settings.default_width
  assign base_height = product.metafields.custom.default_height.value | default: section.settings.default_height

  assign surcharge_product = settings.surcharge_product
  assign surcharge_variant = surcharge_product.variants.first
  assign surcharge_unit = surcharge_variant.price

  comment
    Custom sizing only charges correctly when a surcharge product is configured
    and priced above zero — the theme adds N units of it alongside the piece to
    make up the difference. Without one we never show a scaled price: an
    estimate plus a quote request instead.
  endcomment
  assign can_charge_custom = false
  if settings.custom_size_enabled
    if surcharge_variant != blank
      if surcharge_variant.available
        if surcharge_unit > 0
          assign can_charge_custom = true
        endif
      endif
    endif
  endif

  assign quote_url = settings.quote_page.url | default: routes.root_url

  assign min_height = settings.custom_size_min
  if min_height < base_height
    assign min_height = base_height
  endif
%}

<section class="container section product-section">
  {% render 'breadcrumbs' %}

  <div
    class="product-layout"
    data-product-calculator
    data-base-width="{{ base_width }}"
    data-base-height="{{ base_height }}"
    data-min-height="{{ min_height }}"
    data-max-height="{{ settings.custom_size_max }}"
    data-pricing-basis="{{ section.settings.pricing_basis }}"
    data-money-format="{{ shop.money_format | strip_html | escape }}"
    data-can-charge="{{ can_charge_custom }}"
    data-quote-url="{{ quote_url }}"
    {% if can_charge_custom %}
      data-surcharge-id="{{ surcharge_variant.id }}"
      data-surcharge-unit="{{ surcharge_unit }}"
    {% endif %}
  >
    <div class="product-gallery">
      {%- for media in product.media -%}
        {%- if forloop.first -%}
          {%- assign media_loading = 'eager' -%}
        {%- else -%}
          {%- assign media_loading = 'lazy' -%}
        {%- endif -%}
        <div class="product-gallery__item media">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {{
                media
                | image_url: width: 1800
                | image_tag:
                  loading: media_loading,
                  widths: '500, 800, 1100, 1400, 1800',
                  sizes: '(min-width: 900px) 56vw, 100vw',
                  alt: media.alt | default: product.title
              }}
            {%- else -%}
              {{ media | media_tag }}
          {%- endcase -%}
        </div>
      {%- else -%}
        <div class="product-gallery__item media media-fallback">
          {% render 'engraving', seed: product.id, label: product.title %}
        </div>
      {%- endfor -%}
    </div>

    <div class="product-details">
      <p class="eyebrow">{{ 'product.eyebrow' | t }}</p>
      <h1 class="product-title">{{ product.title }}</h1>

      <div class="product-price price" data-product-price data-base-price="{{ current_variant.price }}">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s>{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
        {{ current_variant.price | money }}
      </div>

      {%- if product.description != blank -%}
        <div class="rte product-description">{{ product.description }}</div>
      {%- endif -%}

      {% form 'product', product, class: 'product-form', novalidate: 'novalidate' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          <label class="field" for="Variant-{{ section.id }}">
            {{ 'product.option' | t }}
            <select id="Variant-{{ section.id }}" data-variant-select>
              {%- for variant in product.variants -%}
                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price }}"
                  {% if variant == current_variant %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title }}
                  {%- unless variant.available %} — {{ 'product.sold_out' | t }}{% endunless -%}
                </option>
              {%- endfor -%}
            </select>
          </label>
        {%- endunless -%}

        {%- if settings.custom_size_enabled -%}
          <fieldset class="size-options">
            <legend>{{ 'product.size' | t }}</legend>

            <div class="segmented">
              <label>
                <input type="radio" name="properties[_Size type]" value="Standard" checked data-size-mode>
                <span>{{ 'product.size_standard' | t }}</span>
              </label>
              <label>
                <input type="radio" name="properties[_Size type]" value="Custom" data-size-mode>
                <span>{{ 'product.size_custom' | t }}</span>
              </label>
            </div>

            <p class="standard-size">
              {{- 'product.standard_size_html' | t: width: base_width, height: base_height -}}
            </p>

            <div class="custom-size" data-custom-size hidden>
              <label class="field" for="CustomHeight-{{ section.id }}">
                {{ 'product.height' | t }}
                <input
                  id="CustomHeight-{{ section.id }}"
                  type="number"
                  inputmode="decimal"
                  min="{{ min_height }}"
                  max="{{ settings.custom_size_max }}"
                  step="0.1"
                  value="{{ base_height }}"
                  data-custom-height
                >
              </label>
              <p class="custom-size__readout">
                {{ 'product.width_readout' | t }}:
                <strong data-calculated-width>{{ base_width }}</strong>
                {{ 'product.feet' | t }}
              </p>
              <p class="field-note">{{ 'product.proportional_note' | t }}</p>
              <p
                class="field-note field-note--error"
                data-size-error
                data-message="{{ 'product.size_range_error' | t: min: min_height, max: settings.custom_size_max }}"
                hidden
              ></p>
            </div>
          </fieldset>

          <input
            type="hidden"
            name="properties[{{ 'product.dimensions' | t }}]"
            value="{{ base_width }} × {{ base_height }} ft"
            data-dimensions-property
            disabled
          >
          <input type="hidden" name="properties[_size_group]" value="" data-group-property disabled>
        {%- endif -%}

        <div class="purchase-row">
          <label class="field quantity-label" for="Quantity-{{ section.id }}">
            {{ 'general.quantity' | t }}
            <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1">
          </label>

          <button
            class="button button--primary purchase-row__add"
            type="submit"
            data-add-button
            data-adding="{{ 'product.adding' | t }}"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}
              {{ 'product.add_to_cart' | t }}
            {%- else -%}
              {{ 'product.sold_out' | t }}
            {%- endif -%}
          </button>

          <a class="button button--secondary purchase-row__quote" href="{{ quote_url }}" data-quote-button hidden>
            {{- 'product.request_size' | t -}}
          </a>
        </div>

        <p class="estimate-line" data-estimate hidden>
          <span>{{ 'product.estimate' | t }}</span>
          <strong data-estimate-value></strong>
        </p>

        <p class="pricing-note" data-pricing-note hidden>
          {%- if can_charge_custom -%}
            {{ 'product.custom_priced_note' | t }}
          {%- else -%}
            {{ 'product.estimate_note' | t }}
          {%- endif -%}
        </p>

        <p class="form-errors" data-add-error hidden role="alert">{{ 'product.add_error' | t }}</p>
      {% endform %}

      <ul class="product-assurances">
        {%- for i in (1..3) -%}
          {%- assign t_key = 'product.assurance_' | append: i | append: '_title' -%}
          {%- assign b_key = 'product.assurance_' | append: i | append: '_body' -%}
          <li>
            <strong>{{ t_key | t }}</strong>
            <span>{{ b_key | t }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% stylesheet %}
  .product-section {
    padding-top: var(--sp-6);
  }

  .product-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(320px, 0.78fr);
    align-items: start;
    gap: clamp(28px, 5vw, 72px);
  }

  .product-gallery {
    display: grid;
    gap: var(--sp-2);
  }
  .product-gallery__item {
    aspect-ratio: 4 / 5;
  }
  .product-gallery__item img,
  .product-gallery__item video,
  .product-gallery__item model-viewer {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-gallery__item.media-fallback .engraving {
    width: 55%;
  }

  .product-details {
    position: sticky;
    top: calc(var(--header-height) + var(--sp-6));
  }
  .product-title {
    margin: var(--sp-2) 0 var(--sp-4);
  }
  .product-price {
    margin-bottom: var(--sp-5);
    font-size: var(--fs-h4);
  }
  .product-description {
    margin-bottom: var(--sp-5);
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .product-form {
    display: grid;
    gap: var(--sp-5);
    padding-block: var(--sp-5);
    border-block: 1px solid var(--line);
  }

  .size-options {
    display: grid;
    gap: var(--sp-2);
    padding: 0;
    border: 0;
  }
  .size-options legend {
    font-size: var(--fs-sm);
    font-weight: 500;
  }
  .segmented {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-2);
  }
  .segmented input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .segmented span {
    display: grid;
    place-items: center;
    min-height: 46px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: var(--fs-sm);
    cursor: pointer;
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease), color 0.15s var(--ease);
  }
  .segmented input:checked + span {
    border-color: var(--copper);
    box-shadow: inset 0 0 0 1px var(--copper);
    color: var(--copper);
  }
  .segmented input:focus-visible + span {
    outline: 2px solid var(--copper);
    outline-offset: 3px;
  }

  .standard-size {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .custom-size {
    display: grid;
    gap: var(--sp-2);
    margin-top: var(--sp-2);
    padding: var(--sp-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .custom-size__readout {
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .estimate-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
  }
  .estimate-line span {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .estimate-line strong {
    color: var(--copper);
    font-size: var(--fs-h4);
  }
  .pricing-note {
    padding: var(--sp-3) var(--sp-4);
    border-left: 2px solid var(--copper);
    background: color-mix(in srgb, var(--copper) 8%, var(--surface));
    font-size: 0.74rem;
  }

  .purchase-row {
    display: grid;
    grid-template-columns: 88px 1fr;
    align-items: end;
    gap: var(--sp-2);
  }
  .quantity-label input {
    margin-top: 6px;
  }
  .purchase-row__add,
  .purchase-row__quote {
    min-height: 56px;
  }
  .purchase-row__quote {
    grid-column: 2;
  }

  .product-assurances {
    margin-top: var(--sp-5);
  }
  .product-assurances li {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: var(--sp-3);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.76rem;
  }
  .product-assurances span {
    color: var(--muted);
  }

  @media (max-width: 1050px) {
    .product-layout {
      grid-template-columns: 1fr minmax(320px, 400px);
    }
  }
  @media (max-width: 860px) {
    .product-layout {
      grid-template-columns: 1fr;
    }
    .product-details {
      position: static;
    }
    .product-gallery {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .product-gallery::-webkit-scrollbar {
      display: none;
    }
    .product-gallery__item {
      flex: 0 0 88%;
      scroll-snap-align: center;
    }
  }
  @media (max-width: 480px) {
    .product-assurances li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "range",
      "id": "default_width",
      "label": "t:labels.default_width",
      "min": 0.5,
      "max": 12,
      "step": 0.5,
      "unit": "ft",
      "default": 2
    },
    {
      "type": "range",
      "id": "default_height",
      "label": "t:labels.default_height",
      "min": 0.5,
      "max": 12,
      "step": 0.5,
      "unit": "ft",
      "default": 2
    },
    {
      "type": "select",
      "id": "pricing_basis",
      "label": "t:labels.pricing_basis",
      "options": [
        { "value": "area", "label": "t:options.pricing.area" },
        { "value": "height", "label": "t:options.pricing.height" }
      ],
      "default": "area"
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
