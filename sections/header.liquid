{% liquid
  assign collections_menu = section.settings.collections_menu
  assign instagram_url = settings.instagram_url | default: 'https://www.instagram.com/metaliq.art/'
  assign facebook_url = settings.facebook_url | default: 'https://www.facebook.com/metaliq.art/'
  assign tiktok_url = settings.tiktok_url | default: 'https://www.tiktok.com/@metaliq.art'
  assign youtube_url = settings.youtube_url | default: 'https://www.youtube.com/@metaliq.art'
  assign whatsapp_number = settings.whatsapp_number | default: '+923172920243' | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign custom_whatsapp_message = settings.whatsapp_custom_message
  if custom_whatsapp_message == blank
    assign custom_whatsapp_message = 'general.whatsapp_custom_message' | t
  endif
  assign custom_whatsapp_message = custom_whatsapp_message | url_encode
  assign custom_whatsapp_url = 'https://wa.me/' | append: whatsapp_number | append: '?text=' | append: custom_whatsapp_message
  capture visible_cart_count
    render 'visible-cart-count', cart: cart
  endcapture
  assign visible_cart_count = visible_cart_count | strip | plus: 0
%}

{%- if section.settings.announcement_1 != blank -%}
  <div class="announcement" data-announcement-slider>
    <button class="announcement__control announcement__control--previous" type="button" aria-label="{{ 'general.previous_promotion' | t }}" data-announcement-previous>
      {% render 'icon', name: 'arrow-right' %}
    </button>
    <div class="announcement__viewport">
      {%- for i in (1..4) -%}
        {%- liquid
          assign message_key = 'announcement_' | append: i
          assign icon_name = 'sparkle'
          if i == 1
            assign icon_name = 'truck'
          elsif i == 2 or i == 3
            assign icon_name = 'sparkle'
          endif
        -%}
        {%- if section.settings[message_key] != blank -%}
          <p class="announcement__slide{% if i == 1 %} is-active{% endif %}" data-announcement-slide aria-hidden="{% if i == 1 %}false{% else %}true{% endif %}">
            <span class="announcement__icon" aria-hidden="true">{% render 'icon', name: icon_name %}</span>
            <span>{{ section.settings[message_key] | escape }}</span>
          </p>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <button class="announcement__control" type="button" aria-label="{{ 'general.next_promotion' | t }}" data-announcement-next>
      {% render 'icon', name: 'arrow-right' %}
    </button>
  </div>
{%- endif -%}

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <button
      class="icon-button nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="PrimaryNav"
      data-nav-toggle
    >
      <span aria-hidden="true"></span>
      <span class="visually-hidden">{{ 'general.menu' | t }}</span>
    </button>

    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ 'general.brand_home' | t: shop_name: shop.name }}">
      <img class="brand__logo brand__logo--mark" src="{{ 'metaliq-mark-light.webp' | asset_url }}" width="256" height="257" alt="">
    </a>

    <nav class="header-nav" id="PrimaryNav" aria-label="{{ 'general.primary_navigation' | t }}" data-nav>
      <a href="{{ routes.root_url }}"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>{{ 'general.home' | t }}</a>
      <a href="{{ routes.all_products_collection_url }}"{% if request.path == routes.all_products_collection_url %} aria-current="page"{% endif %}>{{ 'general.shop_all' | t }}</a>

      <details class="nav-dropdown">
        <summary><span class="nav-dropdown__label">{{ 'collections.title' | t }}</span><span class="nav-dropdown__chevron" aria-hidden="true"></span></summary>
        <div class="nav-dropdown__menu">
          {%- if collections_menu != blank -%}
            {%- for link in collections_menu.links -%}
              {%- liquid
                assign menu_link_url = link.url
                assign menu_link_is_custom = false
                assign menu_link_is_sale_collection = false
                assign menu_link_is_view_all = false
                assign menu_link_title = link.title | downcase
                if link.url contains '/collections/sale'
                  assign menu_link_is_sale_collection = true
                endif
                if link.url == routes.collections_url
                  assign menu_link_is_view_all = true
                endif
                if menu_link_title contains 'view all'
                  assign menu_link_is_view_all = true
                endif
                if link.url contains '/pages/custom-design'
                  assign menu_link_is_custom = true
                endif
                if menu_link_title contains 'custom design'
                  assign menu_link_is_custom = true
                endif
                if menu_link_is_custom
                  assign menu_link_url = custom_whatsapp_url
                endif
              -%}
              {%- unless menu_link_is_sale_collection -%}
                <a class="nav-dropdown__item{% if menu_link_is_view_all %} nav-dropdown__item--all{% endif %}" href="{{ menu_link_url }}"{% if menu_link_is_custom %} data-whatsapp-cta target="_blank" rel="noopener"{% endif %}{% if link.current %} aria-current="page"{% endif %}>
                  <span class="nav-dropdown__item-label">{{ link.title }}</span>
                  {%- if menu_link_is_view_all -%}
                    <span class="nav-dropdown__item-arrow" aria-hidden="true">&rarr;</span>
                  {%- elsif link.type == 'collection_link' and link.object != blank -%}
                    <span class="nav-dropdown__item-meta">{{ 'collection.count' | t: count: link.object.products_count }}</span>
                  {%- else -%}
                    <span class="nav-dropdown__item-arrow" aria-hidden="true">&nearr;</span>
                  {%- endif -%}
                </a>
              {%- endunless -%}
            {%- endfor -%}
          {%- else -%}
            {%- for collection_item in collections -%}
              {%- if collection_item.handle == 'sale' -%}
                {%- continue -%}
              {%- endif -%}
              <a class="nav-dropdown__item" href="{{ collection_item.url }}"{% if collection_item.handle == collection.handle %} aria-current="page"{% endif %}>
                <span class="nav-dropdown__item-label">{{ collection_item.title }}</span>
                <span class="nav-dropdown__item-meta">{{ 'collection.count' | t: count: collection_item.products_count }}</span>
              </a>
            {%- endfor -%}
            <a class="nav-dropdown__item nav-dropdown__item--all" href="{{ routes.collections_url }}">
              <span class="nav-dropdown__item-label">{{ 'collections.view_all' | t }}</span>
              <span class="nav-dropdown__item-arrow" aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </div>
      </details>

      <a href="/pages/about"{% if page.handle == 'about' %} aria-current="page"{% endif %}>{{ 'general.about_us' | t }}</a>
      <a href="{{ custom_whatsapp_url }}" data-whatsapp-cta target="_blank" rel="noopener">{{ 'general.footer_custom_cta' | t }}</a>
      <a href="{{ pages.contact.url | default: routes.root_url }}"{% if page.handle == 'contact' %} aria-current="page"{% endif %}>{{ 'general.contact' | t }}</a>

      <div class="mobile-nav__footer">
        <div>
          <p>{{ 'general.mobile_nav_statement' | t }}</p>
          <span>{{ 'general.mobile_nav_location' | t }}</span>
        </div>
        <div class="mobile-nav__socials" aria-label="{{ 'general.social_media' | t }}">
          <a href="{{ instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          <a href="{{ facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
          <a href="{{ tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
          <a href="{{ youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>
        </div>
      </div>
    </nav>

    <div class="header-actions">
      <div class="header-socials" aria-label="{{ 'general.social_media' | t }}">
        <a href="{{ instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
        <a href="{{ facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
        <a href="{{ tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
        <a href="{{ youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>
      </div>
      <a
        class="icon-button"
        href="{{ routes.search_url }}"
        aria-label="{{ 'general.search' | t }}"
        aria-controls="SearchOverlay"
        aria-expanded="false"
        data-search-open
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
      </a>
      <a
        class="icon-button cart-link"
        href="{{ routes.cart_url }}"
        aria-label="{{ 'general.cart_label' | t: count: visible_cart_count }}"
        data-cart-label="{{ 'general.cart_label' | t: count: '__COUNT__' }}"
        aria-controls="CartDrawer"
        aria-expanded="false"
        data-cart-drawer-trigger
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        {%- if visible_cart_count > 0 -%}<span class="cart-count" data-cart-count>{{ visible_cart_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>
</header>

<dialog
  class="search-overlay"
  id="SearchOverlay"
  aria-labelledby="SearchOverlayTitle"
  data-search-dialog
  data-predictive-url="{{ routes.predictive_search_url }}"
>
  <div class="search-overlay__panel">
    <div class="container search-overlay__inner">
      <div class="search-overlay__header">
        <div>
          <p class="eyebrow">{{ 'search.eyebrow' | t }}</p>
          <h2 id="SearchOverlayTitle">{{ 'search.overlay_title' | t }}</h2>
        </div>
        <button class="icon-button search-overlay__close" type="button" aria-label="{{ 'general.close' | t }}" data-search-close>
          {% render 'icon', name: 'close' %}
        </button>
      </div>

      <form class="search-overlay__form" action="{{ routes.search_url }}" method="get" role="search" data-search-overlay-form>
        <label class="visually-hidden" for="SearchOverlayInput">{{ 'search.title' | t }}</label>
        <div class="search-overlay__field">
          <span class="search-overlay__field-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
          </span>
          <input
            id="SearchOverlayInput"
            type="search"
            name="q"
            placeholder="{{ 'search.placeholder' | t }}"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="SearchPredictiveResults"
            aria-haspopup="listbox"
            aria-autocomplete="list"
            data-search-input
          >
          <input name="options[prefix]" type="hidden" value="last">
          <button class="button button--primary search-overlay__submit" type="submit">{{ 'search.submit' | t }}</button>
        </div>
      </form>

      <div
        class="search-overlay__results"
        id="SearchPredictiveResults"
        aria-live="polite"
        data-search-results
        data-loading-label="{{ 'search.loading' | t }}"
      >
        <p class="search-overlay__hint">{{ 'search.overlay_hint' | t }}</p>
      </div>
    </div>
  </div>
</dialog>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "text",
      "id": "announcement_1",
      "label": "t:labels.announcement",
      "default": "Free delivery on orders above PKR 4,999"
    },
    { "type": "text", "id": "announcement_2", "label": "Promotion 2", "default": "Get 10% cashback on video review submissions" },
    { "type": "text", "id": "announcement_3", "label": "Promotion 3", "default": "Get PKR 200 cashback on every prepaid order" },
    { "type": "text", "id": "announcement_4", "label": "Promotion 4" },
    { "type": "link_list", "id": "collections_menu", "label": "t:labels.collections_menu" },
    { "type": "paragraph", "content": "MetaliQ brand assets are loaded from the theme." }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
