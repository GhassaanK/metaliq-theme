<section class="container page-section auth-page">
  <div class="auth-card">
    <p class="eyebrow">{{ 'customer.account.eyebrow' | t }}</p>
    <h1>{{ 'customer.login.title' | t }}</h1>

    {% form 'customer_login' %}
      {%- if form.errors -%}
        <div class="form-errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <label class="field">
        {{ 'customer.login.email' | t }}
        <input type="email" name="customer[email]" autocomplete="email" required>
      </label>

      <label class="field">
        {{ 'customer.login.password' | t }}
        <input type="password" name="customer[password]" autocomplete="current-password" required>
      </label>

      <button class="button button--primary" type="submit">{{ 'customer.login.submit' | t }}</button>
      <a class="text-link" href="{{ routes.account_recover_url }}">{{ 'customer.login.forgot' | t }}</a>
    {% endform %}

    <p class="auth-alt">
      {{ 'customer.login.new_customer' | t }}
      <a class="text-link" href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a>
    </p>
  </div>

  <div class="auth-card">
    <h2>{{ 'customer.login.recover_title' | t }}</h2>
    <p class="field-note">{{ 'customer.login.recover_body' | t }}</p>

    {% form 'recover_customer_password' %}
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'customer.login.recover_success' | t }}</p>
      {%- endif -%}

      <label class="field">
        {{ 'customer.login.email' | t }}
        <input type="email" name="email" autocomplete="email" required>
      </label>

      <button class="button button--secondary" type="submit">{{ 'customer.login.recover_submit' | t }}</button>
    {% endform %}
  </div>
</section>


{% render 'account-styles' %}

{% schema %}
{
  "name": "t:general.login",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
