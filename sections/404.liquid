{% comment %}
  Rendered by templates/404.json when a customer reaches a URL that no longer
  resolves. https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<section class="container page-section not-found">
  <p class="eyebrow">{{ '404.eyebrow' | t }}</p>
  <h1>{{ '404.title' | t }}</h1>
  <p class="lede">{{ '404.not_found' | t }}</p>
  <a class="button button--primary" href="{{ routes.all_products_collection_url }}">
    {{- '404.back_to_shopping' | t -}}
  </a>
</section>

{% stylesheet %}
  .not-found {
    max-width: 620px;
    padding-block: 90px 130px;
  }

  .not-found h1 {
    margin-bottom: 16px;
    font-size: clamp(3rem, 8vw, 6rem);
  }

  .not-found .lede {
    margin-bottom: 28px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
