{% comment %}
  The product page sends customers here with `piece` and `size` query params
  when a store has no surcharge product configured, so a custom-size request
  arrives with the details already filled in.
{% endcomment %}

{% liquid
  assign requested_piece = request.get.piece
  assign requested_size = request.get.size
%}

<section class="container section contact-layout">
  <div class="contact-intro">
    <p class="eyebrow">{{ 'contact.eyebrow' | t }}</p>
    <h1>{{ page.title | default: 'contact.title' | t }}</h1>
    <p class="lede">{{ section.settings.lede | default: 'contact.lede' | t }}</p>

    <dl class="contact-details">
      {%- if section.settings.email != blank -%}
        <div>
          <dt>{{ 'general.email' | t }}</dt>
          <dd><a class="link" href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a></dd>
        </div>
      {%- endif -%}
      {%- if section.settings.location != blank -%}
        <div>
          <dt>{{ 'general.studio' | t }}</dt>
          <dd>{{ section.settings.location | escape }}</dd>
        </div>
      {%- endif -%}
    </dl>
  </div>

  <div class="contact-form">
    {% form 'contact' %}
      {%- if form.posted_successfully? -%}
        <p class="form-success" tabindex="-1" autofocus>{{ 'contact.success' | t }}</p>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="form-errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="field-grid">
        <label class="field">
          {{ 'contact.name' | t }}
          <input type="text" name="contact[name]" autocomplete="name" required>
        </label>
        <label class="field">
          {{ 'contact.email' | t }}
          <input type="email" name="contact[email]" autocomplete="email" required>
        </label>
      </div>

      <label class="field">
        {{ 'contact.phone' | t }} <span>{{ 'contact.optional' | t }}</span>
        <input type="tel" name="contact[phone]" autocomplete="tel">
      </label>

      {%- if requested_piece != blank or requested_size != blank -%}
        <div class="field-grid">
          <label class="field">
            {{ 'product.eyebrow' | t }}
            <input type="text" name="contact[Piece]" value="{{ requested_piece | escape }}" readonly>
          </label>
          <label class="field">
            {{ 'product.size' | t }}
            <input type="text" name="contact[Requested size]" value="{{ requested_size | escape }}" readonly>
          </label>
        </div>
      {%- endif -%}

      <label class="field">
        {{ 'contact.message' | t }}
        <textarea name="contact[body]" rows="6" required></textarea>
      </label>

      <button class="button button--primary" type="submit">{{ 'contact.send' | t }}</button>
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .contact-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 6vw, 80px);
    padding-top: var(--sp-7);
  }
  .contact-intro h1 {
    margin: var(--sp-3) 0 var(--sp-4);
  }
  .contact-details {
    display: grid;
    gap: 0;
    margin-top: var(--sp-6);
  }
  .contact-details div {
    display: grid;
    gap: 2px;
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--line);
  }
  .contact-details dt {
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .contact-form {
    padding: clamp(20px, 4vw, 36px);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .contact-form form {
    display: grid;
    gap: var(--sp-4);
  }
  .contact-form input[readonly] {
    background: color-mix(in srgb, var(--line) 28%, var(--surface));
    color: var(--muted);
  }
  @media (max-width: 800px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact",
  "settings": [
    { "type": "textarea", "id": "lede", "label": "t:labels.text" },
    { "type": "text", "id": "email", "label": "t:labels.email", "default": "hello@metaliq.com" },
    { "type": "text", "id": "location", "label": "t:labels.location", "default": "Pakistan" }
  ],
  "presets": [{ "name": "t:general.contact" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
