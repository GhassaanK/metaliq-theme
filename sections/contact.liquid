{%- liquid
  assign legal_name = settings.business_legal_name | default: 'Steed Art'
  assign email = settings.business_email | default: 'hello@metaliq.art'
  assign phone = settings.business_phone | default: '03172920243'
  assign phone_link = phone | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign location = settings.business_address | default: 'Plot No 635, Gali No 15, Sector-F, Punjab Road, Manzoor Colony, Karachi, Sindh, Pakistan'
-%}

<section class="container section contact-layout">
  <div class="contact-intro">
    <p class="eyebrow">{{ 'contact.eyebrow' | t }}</p>
    <h1>
      {%- if page.title != blank -%}
        {{ page.title }}
      {%- else -%}
        {{ 'contact.title' | t }}
      {%- endif -%}
    </h1>
    <p class="lede">{{ section.settings.lede | default: 'contact.lede' | t }}</p>

    <p class="contact-operator">{{ 'contact.operated_by' | t }}</p>

    <dl class="contact-details">
      <div>
        <dt>{{ 'contact.legal_name' | t }}</dt>
        <dd>{{ legal_name | escape }}</dd>
      </div>
      {%- if email != blank -%}
        <div>
          <dt>{{ 'general.email' | t }}</dt>
          <dd><a class="link" href="mailto:{{ email | escape }}">{{ email | escape }}</a></dd>
        </div>
      {%- endif -%}
      {%- if phone != blank -%}
        <div>
          <dt>{{ 'contact.phone' | t }}</dt>
          <dd><a class="link" href="tel:{{ phone_link }}">{{ phone | escape }}</a></dd>
        </div>
      {%- endif -%}
      {%- if location != blank -%}
        <div>
          <dt>{{ 'general.studio' | t }}</dt>
          <dd>{{ location | escape }}</dd>
        </div>
      {%- endif -%}
    </dl>

    {%- liquid
      assign contact_whatsapp_label = 'contact.whatsapp_cta' | t
      assign contact_whatsapp_message = 'contact.whatsapp_message' | t
    -%}
    {% render 'whatsapp-link', label: contact_whatsapp_label, message: contact_whatsapp_message, css_class: 'contact-whatsapp' %}
  </div>

  <div class="contact-form">
    {% form 'contact' %}
      {%- if form.posted_successfully? -%}
        <p class="form-success" tabindex="-1" autofocus>{{ 'contact.success' | t }}</p>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="form-errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="field-grid">
        <label class="field">
          {{ 'contact.name' | t }}
          <input type="text" name="contact[name]" autocomplete="name" required>
        </label>
        <label class="field">
          {{ 'contact.email' | t }}
          <input type="email" name="contact[email]" autocomplete="email" required>
        </label>
      </div>

      <label class="field">
        {{ 'contact.phone' | t }} <span>{{ 'contact.optional' | t }}</span>
        <input type="tel" name="contact[phone]" autocomplete="tel">
      </label>

      <label class="field">
        {{ 'contact.message' | t }}
        <textarea name="contact[body]" rows="6" required></textarea>
      </label>

      <button class="button button--primary" type="submit">{{ 'contact.send' | t }}</button>
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .contact-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 6vw, 80px);
    padding-top: var(--sp-7);
  }
  .contact-intro h1 {
    margin: var(--sp-3) 0 var(--sp-4);
  }
  .contact-details {
    display: grid;
    gap: 0;
    margin-top: var(--sp-6);
  }
  .contact-operator {
    max-width: 58ch;
    margin-top: var(--sp-4);
    color: var(--muted);
    font-size: var(--fs-sm);
    line-height: 1.65;
  }
  .contact-whatsapp {
    margin-top: var(--sp-5);
  }
  .contact-details div {
    display: grid;
    gap: 2px;
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--line);
  }
  .contact-details dt {
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .contact-form {
    padding: clamp(20px, 4vw, 36px);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .contact-form form {
    display: grid;
    gap: var(--sp-4);
  }
  .contact-form input[readonly] {
    background: color-mix(in srgb, var(--line) 28%, var(--surface));
    color: var(--muted);
  }
  @media (max-width: 800px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact",
  "settings": [
    { "type": "textarea", "id": "lede", "label": "t:labels.text" },
    { "type": "paragraph", "content": "Business details are managed in Theme settings." }
  ],
  "presets": [{ "name": "t:general.contact" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
