<section class="container page-section contact-layout"><div><p class="eyebrow">Let’s talk metal</p><h1>{{ page.title | default: 'Contact' }}</h1><p class="lede">Questions about a piece, finish, or delivery? Send us a note and we’ll get back to you.</p><div class="contact-details"><p><span>Email</span><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p><p><span>Studio</span>{{ section.settings.location }}</p></div></div><div class="contact-form">{% form 'contact' %}{% if form.posted_successfully? %}<p class="form-success" tabindex="-1" autofocus>Thanks. Your message is with us.</p>{% endif %}{{ form.errors | default_errors }}<div class="field-grid"><label>Name<input type="text" name="contact[name]" autocomplete="name" required></label><label>Email<input type="email" name="contact[email]" autocomplete="email" required></label></div><label>Phone <span>(optional)</span><input type="tel" name="contact[phone]" autocomplete="tel"></label><label>Message<textarea name="contact[body]" rows="6" required></textarea></label><button class="button button--primary" type="submit">Send message</button>{% endform %}</div></section>
{% schema %}{"name":"Contact","settings":[{"type":"text","id":"email","label":"Email","default":"hello@metaliq.com"},{"type":"text","id":"location","label":"Studio location","default":"Pakistan"}],"presets":[{"name":"Contact"}]}{% endschema %}
