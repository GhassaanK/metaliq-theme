<section class="container section container--narrow account-page">
  <header class="page-header account-header">
    <div>
      <p class="eyebrow">{{ 'customer.account.eyebrow' | t }}</p>
      <h1>{{ 'customer.account.title' | t }}</h1>
    </div>
    <a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
  </header>

  <div class="account-layout">
    <div>
      <h2>{{ 'customer.account.orders' | t }}</h2>

      {%- paginate customer.orders by 12 -%}
        {%- if customer.orders.size > 0 -%}
          <div class="table-scroll">
            <table class="account-table">
              <thead>
                <tr>
                  <th>{{ 'customer.account.order_number' | t }}</th>
                  <th>{{ 'customer.account.date' | t }}</th>
                  <th>{{ 'customer.account.payment_status' | t }}</th>
                  <th>{{ 'customer.account.fulfillment_status' | t }}</th>
                  <th>{{ 'customer.account.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a class="link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | date: format: 'date' }}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="pagination">{{ paginate | default_pagination }}</div>
          {%- endif -%}
        {%- else -%}
          <p class="account-empty">{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

    <aside class="account-aside">
      <h2>{{ 'customer.account.details' | t }}</h2>
      {{ customer.default_address | format_address }}
      <a class="link" href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t }}</a>
    </aside>
  </div>
</section>


{% render 'account-styles' %}

{% schema %}
{
  "name": "t:general.account",
  "settings": [],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
